<div class="arcflight-travel-runner-mvp arcflight-travel-runner-guided">
  <header class="arcflight-travel-runner-mvp__header">
    <div class="arcflight-travel-runner-mvp__header-row">
      <h1>Arcflight Travel Command</h1>
      <div class="arcflight-travel-runner-mvp__actions">
        <button type="button" data-arcflight-runner-toggle-compact>{{#if state.compactRunner}}Expand Runner{{else}}Compact Runner{{/if}}</button>
        <button type="button" data-arcflight-open-travel-scene-overlay>Open Travel Scene Overlay</button>
        {{#if state.hasSession}}<button type="button" data-arcflight-runner-send-mission-board title="{{#if state.travelV2GmFlowStatus}}{{state.travelV2GmFlowStatus.disabledActions.syncPlayers}}{{else}}Send or refresh player HUD and station cards.{{/if}}">Send / Refresh Player HUD</button>{{/if}}
      </div>
    </div>
    {{#unless state.compactRunner}}<span class="arcflight-travel-safety-chip" title="No automatic actor/item/chat/journal/combat mutation. Actor changes require explicit GM Apply.">Manual GM Apply only</span>{{/unless}}
    <p class="arcflight-sheet__hint"><strong>Status:</strong> {{statusMessage}}</p>
    {{#if state.compactRunner}}
      <div class="arcflight-travel-runner-mvp__compact-summary">
        <div><span>Event</span><strong>{{#if state.hasSession}}{{state.event.name}}{{else}}No active event{{/if}}</strong></div>
        <div><span>Round</span><strong>{{state.compactRoundLabel}}</strong></div>
      </div>
    {{/if}}
  </header>


  {{#unless state.hasSession}}
  <section id="arcflight-guided-command-bridge" class="arcflight-travel-command-bridge arcflight-needs-attention" aria-label="Command Bridge">
    <div class="arcflight-travel-command-bridge__astrolabe" aria-hidden="true"></div>
    <header class="arcflight-travel-command-bridge__header">
      <div>
        <p class="arcflight-travel-command-bridge__eyebrow">🧭 Command Bridge</p>
        <h2>Start Travel Session</h2>
        <div class="arcflight-travel-command-bridge__tags"><span>No active event</span><span>Choose published event</span><span>Select PF2E vehicle ship</span></div>
      </div>
      <button type="button" data-arcflight-start-travel-event-runner {{#unless state.startupDiagnostics.canStart}}disabled{{/unless}}>Start Travel Session</button>
    </header>
    <article class="arcflight-travel-next-action arcflight-needs-attention"><span class="arcflight-travel-next-action__icon">🧭</span><div><p>NEXT REQUIRED ACTION</p><h3>Start Travel Session</h3><span>Choose a published finalized travel event and selected ship, then begin the local runner session.</span></div><button type="button" data-arcflight-start-travel-event-runner {{#unless state.startupDiagnostics.canStart}}disabled{{/unless}}>Begin Travel</button></article>
    <div class="arcflight-travel-start-steps">
      <section><strong>Step 1: Choose Published Event</strong>{{#if state.hasPublishedEvents}}<label class="arcflight-sheet__field"><span>Published Event</span><select data-arcflight-runner-event-select>{{#each state.library.entries}}<option value="{{id}}" {{#if selected}}selected{{/if}} {{#if isMalformed}}disabled{{/if}}>{{name}} — {{categoryLabel}}{{#if isMalformed}} (malformed){{/if}}</option>{{/each}}</select></label>{{else}}<p class="arcflight-sheet__hint">No published finalized travel event exists yet.</p>{{/if}}</section>
      <section><strong>Step 2: Choose Ship / PF2E Vehicle</strong><p class="arcflight-sheet__hint">The start dialog will ask for the ship/PF2E vehicle before creating the local runner session.</p></section>
      <section><strong>Step 3: Start Local Runner Session</strong><p class="arcflight-sheet__hint">{{#if state.startupDiagnostics.canStart}}Ready to begin.{{else}}Blocked: {{#each state.startupDiagnostics.issues}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}{{/if}}</p></section>
    </div>
  </section>
  {{/unless}}

  {{#if state.hasSession}}
  <section id="arcflight-guided-command-bridge" class="arcflight-travel-command-bridge arcflight-needs-attention" aria-label="Command Bridge">
    <div class="arcflight-travel-command-bridge__astrolabe" aria-hidden="true"></div>
    <header class="arcflight-travel-command-bridge__header">
      <div>
        <p class="arcflight-travel-command-bridge__eyebrow">🧭 Command Bridge</p>
        <h2>{{state.event.name}}</h2>
        <div class="arcflight-travel-command-bridge__tags">
          <span>Event Level: {{state.guidedBridge.tags.level}}</span>
          <span>Severity: {{state.guidedBridge.tags.severity}}</span>
          <span>Category: {{state.guidedBridge.tags.category}}</span>
          <span>Ship: {{#if state.session.ship.actorName}}{{state.session.ship.actorName}}{{else}}Unassigned{{/if}}</span>
          <span>Round {{state.currentRoundNumber}}</span>
          <span>Phase: {{state.roundSegmentState.currentSegmentLabel}}</span>
          <span>Status: {{state.session.status}}</span>
        </div>
      </div>
      <button type="button" data-arcflight-runner-send-mission-board title="{{#if state.travelV2GmFlowStatus}}{{state.travelV2GmFlowStatus.disabledActions.syncPlayers}}{{else}}Send or refresh player HUD and station cards.{{/if}}">Send / Refresh Player HUD</button>
    </header>

    {{#if state.travelV2GmFlowStatus}}
    <section class="arcflight-travel-gm-flow-strip arcflight-{{state.travelV2GmFlowStatus.stateTone}} arcflight-gm-only" aria-label="Travel v2 GM flow status">
      <header>
        <strong>GM Flow Status</strong>
        <span>{{state.travelV2GmFlowStatus.nextActionLabel}}</span>
      </header>
      <div class="arcflight-travel-gm-flow-strip__chips">
        <span>{{state.travelV2GmFlowStatus.currentRoundLabel}}</span>
        <span>{{state.travelV2GmFlowStatus.stationResolutionLabel}}</span>
        <span>{{state.travelV2GmFlowStatus.focusReadinessLabel}}</span>
        <span>{{state.travelV2GmFlowStatus.finalizationLabel}}</span>
        <span>{{state.travelV2GmFlowStatus.pressureLabel}}</span>
        <span>{{state.travelV2GmFlowStatus.consequenceLabel}}</span>
        <span>{{state.travelV2GmFlowStatus.advanceLabel}}</span>
        <span>{{state.travelV2GmFlowStatus.playerSyncLabel}}</span>
      </div>
      <p class="arcflight-sheet__hint"><strong>Next:</strong> {{state.travelV2GmFlowStatus.nextActionLabel}} — {{state.travelV2GmFlowStatus.nextActionHelpText}}</p>
      {{#if state.travelV2GmFlowStatus.showFinalizeRoundAction}}
        <div class="arcflight-travel-runner-mvp__actions">
          <button type="button" data-arcflight-travel-v2-round-finalize title="{{state.travelV2GmFlowStatus.finalizeRoundActionTitle}}">{{state.travelV2GmFlowStatus.finalizeRoundActionLabel}}</button>
        </div>
      {{/if}}
      {{#if state.travelV2GmFlowStatus.blockers}}<p class="arcflight-sheet__hint"><strong>Blocked by:</strong> {{#each state.travelV2GmFlowStatus.blockers}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</p>{{/if}}
    </section>
    {{/if}}

    <article class="arcflight-travel-next-action arcflight-{{state.guidedBridge.nextRequiredAction.tone}}">
      <span class="arcflight-travel-next-action__icon">{{state.guidedBridge.nextRequiredAction.icon}}</span>
      <div>
        <p>NEXT REQUIRED ACTION</p>
        <h3>{{state.guidedBridge.nextRequiredAction.title}}</h3>
        <span>{{state.guidedBridge.nextRequiredAction.detail}}</span>
      </div>
      {{#if state.guidedBridge.nextRequiredAction.buttons}}{{#each state.guidedBridge.nextRequiredAction.buttons}}<button type="button" data-arcflight-guided-action="{{action}}" data-queue-key="{{../key}}">{{label}}</button>{{/each}}{{else}}<button type="button" data-arcflight-guided-action="round-review">Open Details</button>{{/if}}
    </article>

    <div class="arcflight-travel-guided-grid">
      <section id="arcflight-guided-round-flow" class="arcflight-travel-guided-panel" aria-label="Round Flow" tabindex="-1">
        <h3>🧭 Round Flow</h3>
        <p>{{state.roundSegmentState.currentSegmentLabel}} · {{state.currentRoundTitle}}</p>
        <div class="arcflight-travel-runner-mvp__actions"><button type="button" data-arcflight-runner-previous-phase>Previous Phase</button><button type="button" data-arcflight-runner-next-phase>Next Phase</button></div>
      </section>
      <section id="arcflight-guided-station-console" class="arcflight-travel-guided-panel" aria-label="Station Console" tabindex="-1">
        <h3>⚙️ Station Console</h3>
        <p>{{state.guidedBridge.stationSummary.resolved}}/{{state.guidedBridge.stationSummary.total}} resolved · {{state.guidedBridge.stationSummary.waiting}} waiting · {{state.guidedBridge.stationSummary.critical}} critical</p>
  
      {{#if state.focusRiskSummary.hasRows}}
        <section class="arcflight-travel-runner-mvp__panel arcflight-player-safe">
          <h2>Focus Risk / Suppression</h2>
          <p class="arcflight-sheet__hint">{{state.focusRiskSummary.mutationNote}}</p>
          {{#if state.focusRiskSummary.hasBlockedRows}}<p class="arcflight-travel-builder__warning"><strong>Blocked Focus stations:</strong> {{#each state.focusRiskSummary.blockedRows}}{{stationName}}{{#if blockedHazardName}} ({{blockedHazardName}}){{/if}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
        </section>
      {{/if}}

      {{#if state.hasStations}}
          <div class="arcflight-travel-compact-stations">
            {{#each state.stations}}
              <article class="arcflight-travel-card {{#if result}}arcflight-resolved{{else}}arcflight-player-waiting{{/if}}">
                <strong>{{stationName}} — {{stationStateLabel}}</strong><span>{{resultLabel}}</span>
                <p>{{assignedActorName}} · {{selectedActionLabel}}{{#if selectedStationOptionLabel}} · {{selectedStationOptionLabel}}{{/if}}</p>
                <div class="arcflight-travel-runner-mvp__result-buttons">
                  {{#each resultOptions}}<button type="button" data-arcflight-runner-result data-round-index="{{../../state.session.currentRoundIndex}}" data-station-key="{{../stationKey}}" data-result="{{value}}" {{#if ../../state.isCompleted}}disabled{{/if}} class="{{#if selected}}arcflight-travel-runner-mvp__result-button--selected{{/if}}">{{label}}</button>{{/each}}<button type="button" data-arcflight-runner-result data-round-index="{{../session.currentRoundIndex}}" data-station-key="{{stationKey}}" data-result="skipped" {{#if ../isCompleted}}disabled{{/if}}>Mark Not Participating</button><button type="button" data-arcflight-runner-clear-result data-round-index="{{../session.currentRoundIndex}}" data-station-key="{{stationKey}}" {{#if ../isCompleted}}disabled{{/if}}>Clear Station Result</button>
                </div>
                {{#if result}}<p class="arcflight-sheet__hint">{{stationName}} summary: {{assignedActorName}} · {{selectedActionLabel}}{{#if selectedStationOptionLabel}} / {{selectedStationOptionLabel}}{{/if}} · {{resultLabel}}{{#if pendingStabilize}} · suggested pressure {{pendingStabilizeReduction}}{{/if}}</p>{{/if}}
              </article>
            {{/each}}
          </div>
        {{/if}}
      </section>
      <section class="arcflight-travel-guided-panel" aria-label="Pressure & Resources">
        <h3>🔥 Pressure & Resources</h3>
        <div class="arcflight-pressure-gauge-board">
          {{#each state.guidedBridge.pressureGauges}}
            <article class="arcflight-pressure-gauge arcflight-pressure-gauge--{{stateClass}}" title="{{tooltip}}" style="--arcflight-gauge-angle: {{needleAngle}}deg; --arcflight-gauge-fill: {{fillPercent}}%;">
              <div class="arcflight-pressure-gauge__meta"><span class="arcflight-pressure-gauge__label">{{icon}} {{label}}</span><strong class="arcflight-pressure-gauge__value">{{valueLabel}}</strong></div>
              <div class="arcflight-pressure-gauge__face" aria-label="{{label}} pressure {{valueLabel}}">
                <span class="arcflight-pressure-gauge__tick arcflight-pressure-gauge__tick--0">0</span>
                <span class="arcflight-pressure-gauge__tick arcflight-pressure-gauge__tick--1">1</span>
                <span class="arcflight-pressure-gauge__tick arcflight-pressure-gauge__tick--2">2</span>
                <span class="arcflight-pressure-gauge__tick arcflight-pressure-gauge__tick--3">3</span>
                <span class="arcflight-pressure-gauge__tick arcflight-pressure-gauge__tick--4">4</span>
                <span class="arcflight-pressure-gauge__needle"></span>
              </div>
              <p class="arcflight-pressure-gauge__description">{{description}}</p>
              {{#if isOverflow}}<p class="arcflight-pressure-gauge__warning">Ship Scar Risk</p>{{else}}{{#if isDanger}}<p class="arcflight-pressure-gauge__warning">Maximum Pressure</p>{{else}}{{#if isWarning}}<p class="arcflight-pressure-gauge__warning">Threshold Warning</p>{{/if}}{{/if}}{{/if}}
            </article>
          {{/each}}
        </div>
      </section>
    </div>

    <section class="arcflight-travel-action-queue" aria-label="Action Queue">
      <h3>⚠️ Action Queue</h3>
      {{#if state.guidedBridge.hasActionQueue}}
        {{#each state.guidedBridge.actionQueue}}
          <article class="arcflight-travel-action-queue__item arcflight-{{tone}}">
            <strong>{{icon}} {{title}}</strong><p>{{detail}}</p>
            <div>{{#each buttons}}<button type="button" data-arcflight-guided-action="{{action}}" data-queue-key="{{../key}}">{{label}}</button>{{/each}}</div>
          </article>
        {{/each}}
      {{else}}<p class="arcflight-resolved">No GM attention items. Continue the voyage when ready.</p>{{/if}}
    </section>

    {{#if state.canManageTravelV2Consequences}}
    <section id="arcflight-travel-v2-pending-consequences" class="arcflight-travel-action-queue arcflight-gm-only" aria-label="Pending Consequences">
      <h3>🔒 Pending Consequences</h3>
      <div class="arcflight-travel-card arcflight-gm-only arcflight-travel-pending-consequences__summary-bar">
        <strong>Queue Summary</strong>
        <p class="arcflight-sheet__hint">Pending: {{state.pendingConsequenceQueue.pendingCount}} · Selected: {{state.pendingConsequenceQueue.applyStatusSummary.selectedCount}} · Executable: {{state.pendingConsequenceQueue.applyStatusSummary.executableCount}} · Clearable: {{state.pendingConsequenceQueue.clearSelectionSummary.clearableCount}} · Applied/reviewed: {{state.pendingConsequenceQueue.appliedCount}}</p>
        <div class="arcflight-travel-runner-mvp__actions">
          <a href="#arcflight-travel-v2-pending-readyToApply">Ready to Apply</a>
          <a href="#arcflight-travel-v2-pending-needsSelection">Needs Selection</a>
          <a href="#arcflight-travel-v2-pending-applied">Applied / Reviewed</a>
          <a href="#arcflight-travel-v2-followup-notes">Follow-up Notes</a>
        </div>
      </div>
      <p class="arcflight-sheet__hint">{{state.pendingConsequenceQueue.summaryText}}</p>
      <p class="arcflight-sheet__hint">Dismissed: {{state.pendingConsequenceQueue.dismissedCount}} · Deferred: {{state.pendingConsequenceQueue.deferredCount}}</p>
      <section class="arcflight-travel-card arcflight-gm-only" aria-label="Apply Status">
        <strong>Apply Status</strong>
        <p class="arcflight-sheet__hint">Total: {{state.pendingConsequenceQueue.applyStatusSummary.totalItems}} · Selected: {{state.pendingConsequenceQueue.applyStatusSummary.selectedCount}} · Executable: {{state.pendingConsequenceQueue.applyStatusSummary.executableCount}} · Already Applied: {{state.pendingConsequenceQueue.applyStatusSummary.alreadyAppliedCount}}</p>
        <p class="arcflight-sheet__hint">Unsupported: {{state.pendingConsequenceQueue.applyStatusSummary.unsupportedCount}} · Missing Selection: {{state.pendingConsequenceQueue.applyStatusSummary.missingSelectionCount}} · Missing Catalog: {{state.pendingConsequenceQueue.applyStatusSummary.missingCatalogCount}} · Session Pressure Only: {{state.pendingConsequenceQueue.applyStatusSummary.sessionPressureOnlyCount}}</p>
        <p class="arcflight-sheet__hint">Single-suggestion ready: {{state.pendingConsequenceQueue.singleSuggestionSelectionSummary.eligibleCount}} · Already selected: {{state.pendingConsequenceQueue.singleSuggestionSelectionSummary.alreadySelectedCount}} · Multiple suggestions: {{state.pendingConsequenceQueue.singleSuggestionSelectionSummary.multipleSuggestionCount}} · No suggestion: {{state.pendingConsequenceQueue.singleSuggestionSelectionSummary.noSuggestionCount}}</p>
        <button type="button" data-action="arcflight-travel-v2-select-all-single-suggestion-consequences" {{#unless state.pendingConsequenceQueue.singleSuggestionSelectionSummary.eligibleCount}}disabled{{/unless}} title="Selects only pending unselected queue items with exactly one catalog suggestion; does not apply effects or mutate world data.">Select All Single Suggestions</button>
        <button type="button" data-action="arcflight-travel-v2-apply-all-selected-consequences" {{#unless state.pendingConsequenceQueue.applyStatusSummary.executableCount}}disabled{{/unless}} title="Applies all currently executable selected consequences to the runner session only. Does not mutate actors, items, inventories, chat, journals, combat, scenes, tokens, sockets, compendia, or world data.">Apply All Executable Selected</button>
        <button type="button" data-action="arcflight-travel-v2-clear-all-selected-consequences" {{#unless state.pendingConsequenceQueue.clearSelectionSummary.clearableCount}}disabled{{/unless}} title="Clears selected consequence cards from pending unapplied queue items only; does not apply effects or mutate world data.">Clear All Selected</button>
        <p class="arcflight-sheet__hint">Clearable selected: {{state.pendingConsequenceQueue.clearSelectionSummary.clearableCount}} · Selected total: {{state.pendingConsequenceQueue.clearSelectionSummary.selectedCount}} · Applied/effect locked: {{state.pendingConsequenceQueue.clearSelectionSummary.appliedOrEffectCount}} · Blocked status: {{state.pendingConsequenceQueue.clearSelectionSummary.blockedStatusCount}}</p>
      </section>
      {{#if state.consequenceFollowupReview.hasRecords}}
        <section id="arcflight-travel-v2-followup-notes" class="arcflight-travel-card arcflight-gm-only" aria-label="Follow-up Notes">
          <strong>Follow-up Notes</strong>
          <p class="arcflight-sheet__hint">Total: {{state.consequenceFollowupReview.totalCount}} · Open: {{state.consequenceFollowupReview.openCount}} · Reviewed: {{state.consequenceFollowupReview.reviewedCount}} · Deferred: {{state.consequenceFollowupReview.deferredCount}} · Resolved: {{state.consequenceFollowupReview.resolvedCount}}</p>
          {{#each state.consequenceFollowupReview.groups}}
            {{#if records}}
              <section class="arcflight-travel-card arcflight-gm-only" aria-label="Follow-up Notes {{label}}">
                <strong>{{label}}</strong>
                <p class="arcflight-sheet__hint">{{count}} note{{#unless (eq count 1)}}s{{/unless}}</p>
                {{#each records}}
                  <article class="arcflight-travel-action-queue__item arcflight-gm-only">
                    <strong>{{title}}</strong>
                    <p class="arcflight-sheet__hint">Affected track: {{affectedTrack}} · Kind: {{kind}} · Mutation: {{mutation}}</p>
                    <p class="arcflight-sheet__hint">Status: {{statusLabel}}{{#if statusUpdatedAt}} · Status updated: {{statusUpdatedAt}}{{/if}}{{#if statusUpdatedBy}} · By: {{statusUpdatedBy}}{{/if}}</p>
                    {{#if statusNote}}<p class="arcflight-sheet__hint">Status note: {{statusNote}}</p>{{/if}}
                    <p>{{summary}}</p>
                    <p class="arcflight-sheet__hint">Source: {{source}} · Created: {{createdAt}} · By: {{createdBy}}</p>
                    <div class="arcflight-travel-action-queue__actions arcflight-gm-only">
                      <button type="button" data-arcflight-travel-v2-followup-note-status data-followup-key="{{queueKey}}" data-status="open">Mark Open</button>
                      <button type="button" data-arcflight-travel-v2-followup-note-status data-followup-key="{{queueKey}}" data-status="reviewed">Mark Reviewed</button>
                      <button type="button" data-arcflight-travel-v2-followup-note-status data-followup-key="{{queueKey}}" data-status="deferred">Defer</button>
                      <button type="button" data-arcflight-travel-v2-followup-note-status data-followup-key="{{queueKey}}" data-status="resolved">Resolve</button>
                    </div>
                  </article>
                {{/each}}
              </section>
            {{/if}}
          {{/each}}
        </section>
      {{/if}}
      {{#if state.pendingConsequenceQueue.items}}
        {{#each state.pendingConsequenceQueue.gmItemGroups}}
          {{#if count}}
            <section id="arcflight-travel-v2-pending-{{key}}" class="arcflight-travel-card arcflight-gm-only" aria-label="{{label}} Pending Consequences">
              <h4>{{label}} ({{count}})</h4>
              <p class="arcflight-sheet__hint">{{hint}}</p>
              {{#each items}}
          <article class="arcflight-travel-action-queue__item arcflight-gm-only">
            <strong>{{title}}</strong>
            <p class="arcflight-sheet__hint">Severity: {{severity}} · Source: {{sourceType}}{{#if roundNumber}} · Round {{roundNumber}}{{/if}} · Status: {{status}}</p>
            <p><strong>Public summary:</strong> {{publicSummary}}</p>
            <details class="arcflight-gm-only"><summary>GM summary</summary><p>{{gmSummary}}</p></details>
            {{#if selectedConsequence}}
              <article class="arcflight-travel-card arcflight-gm-only">
                <strong>Selected consequence: {{selectedConsequence.title}}</strong>
                <p class="arcflight-sheet__hint">Severity: {{selectedConsequence.severity}} · Session-local selection only</p>

                <p><strong>Player-safe:</strong> {{selectedConsequence.playerSafeSummary}}</p>
                <details class="arcflight-gm-only"><summary>Apply summary</summary><p>{{selectedConsequence.applyEffectSummary}}</p></details>
                {{#if selectedConsequenceApplyPreview}}
                  <section class="arcflight-travel-card arcflight-gm-only" aria-label="Selected Consequence Apply Preview">
                    <strong>Apply Preview: {{selectedConsequenceApplyPreview.title}}</strong>
                    <p class="arcflight-sheet__hint">Severity: {{selectedConsequenceApplyPreview.severity}}{{#if selectedConsequenceApplyPreview.source}} · Effect category: {{selectedConsequenceApplyPreview.source}}{{/if}}{{#if selectedConsequenceApplyPreview.affectedTrack}} · Affected track: {{selectedConsequenceApplyPreview.affectedTrack}}{{/if}}</p>
                    <p><strong>Player-safe summary:</strong> {{selectedConsequenceApplyPreview.playerSafeSummary}}</p>
                    <details class="arcflight-gm-only"><summary>GM apply summary</summary><p>{{selectedConsequenceApplyPreview.applyEffectSummary}}</p></details>
                    <p class="arcflight-sheet__hint"><strong>Mutation:</strong> {{selectedConsequenceApplyPreview.mutation}} · <strong>Executable:</strong> {{#unless selectedConsequenceApplyPreview.executable}}no{{else}}yes{{/unless}} · <strong>Preview only:</strong> {{#if selectedConsequenceApplyPreview.previewOnly}}yes{{else}}no{{/if}}</p>
                    <p class="arcflight-sheet__hint"><strong>Warning:</strong> {{selectedConsequenceApplyPreview.warningText}}</p>
                    {{#if hasAppliedEffect}}
                      <section class="arcflight-travel-card arcflight-gm-only" aria-label="Selected Consequence Applied Result">
                        <strong>Applied Result</strong>
                        <p class="arcflight-sheet__hint"><strong>Application:</strong> {{appliedEffect.applicationId}} · <strong>Applied at:</strong> {{appliedEffect.appliedAt}} · <strong>Applied by:</strong> {{appliedEffect.appliedBy}}</p>
                        {{#if (eq appliedEffect.mutation "session-pressure-only")}}
                          <p class="arcflight-sheet__hint"><strong>Mutation:</strong> {{appliedEffect.mutation}} · <strong>Affected track:</strong> {{appliedEffect.affectedTrack}} · <strong>Pressure track:</strong> {{appliedEffect.pressureTrack}}</p>
                          <p class="arcflight-sheet__hint"><strong>Delta:</strong> {{appliedEffect.pressureDelta}} · <strong>Before → After:</strong> {{appliedEffect.beforeValue}} → {{appliedEffect.afterValue}}</p>
                          <p><strong>Note:</strong> {{appliedEffect.note}}</p>
                        {{/if}}
                        {{#if (eq appliedEffect.mutation "session-followup-note-only")}}
                          <strong>Follow-up Result</strong>
                          <p class="arcflight-sheet__hint"><strong>Mutation:</strong> {{appliedEffect.mutation}} · <strong>Affected track:</strong> {{appliedEffect.affectedTrack}} · <strong>Kind:</strong> {{appliedEffect.kind}}</p>
                          <p class="arcflight-sheet__hint"><strong>Consequence:</strong> {{appliedEffect.consequenceId}} · <strong>Title:</strong> {{appliedEffect.followupRecord.title}}</p>
                          <p><strong>Summary:</strong> {{appliedEffect.followupRecord.summary}}</p>
                          <p class="arcflight-sheet__hint"><strong>Source:</strong> {{appliedEffect.followupRecord.source}} · <strong>Created:</strong> {{appliedEffect.followupRecord.createdAt}} · <strong>By:</strong> {{appliedEffect.followupRecord.createdBy}}</p>
                          <p class="arcflight-sheet__hint">Session-only note; no actor/resource mutation was applied.</p>
                        {{/if}}
                      </section>
                    {{/if}}
                    <div class="arcflight-travel-runner-mvp__actions">
                      {{#if canClearSelectedConsequence}}<button type="button" data-arcflight-travel-v2-pending-consequence-clear-selection data-queue-key="{{queueKey}}" title="Clears the selected card from this pending queue item only; does not apply effects or mutate world data.">Clear Selection</button>{{/if}}
                      {{#if canApplySelectedConsequence}}<button type="button" data-arcflight-travel-v2-pending-consequence-apply-selected data-queue-key="{{queueKey}}" title="Applies this selected consequence to the runner session only. Does not mutate actors, items, chat, journals, combat, scenes, tokens, sockets, compendia, or world data.">Apply Selected Consequence</button>{{/if}}
                    </div>
                  </section>
                {{/if}}
              </article>
            {{/if}}
            {{#if catalogSuggestions}}
              <details>
                <summary>Catalog suggestions ({{catalogSuggestions.length}}) — scan and choose a card</summary>
                {{#each catalogSuggestions}}
                  <article class="arcflight-travel-card arcflight-gm-only">
                    <strong>{{title}}</strong>
                    <p class="arcflight-sheet__hint">Severity: {{severity}}</p>
                    <p><strong>Player-safe:</strong> {{playerSafeSummary}}</p>
                    <details class="arcflight-gm-only"><summary>Apply summary</summary><p>{{applyEffectSummary}}</p></details>
                    <button type="button" data-arcflight-travel-v2-pending-consequence-select data-queue-key="{{../queueKey}}" data-consequence-id="{{id}}" title="Selects this authored consequence card for this queue item in the session only. Does not apply the effect or mutate world data.">Use This Card</button>
                  </article>
                {{/each}}
              </details>
            {{/if}}
            <div class="arcflight-travel-runner-mvp__actions">
              <button type="button" data-arcflight-travel-v2-pending-consequence-status data-queue-key="{{queueKey}}" data-status="applied" title="Marks this candidate in the session queue only. Does not mutate actors, items, chat, journals, combat, scenes, tokens, sockets, compendia, or world data.">Mark Applied</button>
              <button type="button" data-arcflight-travel-v2-pending-consequence-status data-queue-key="{{queueKey}}" data-status="dismissed" title="Marks this candidate in the session queue only. Does not mutate actors, items, chat, journals, combat, scenes, tokens, sockets, compendia, or world data.">Dismiss</button>
              <button type="button" data-arcflight-travel-v2-pending-consequence-status data-queue-key="{{queueKey}}" data-status="deferred" title="Marks this candidate in the session queue only. Does not mutate actors, items, chat, journals, combat, scenes, tokens, sockets, compendia, or world data.">Defer</button>
            </div>
          </article>
              {{/each}}
            </section>
          {{/if}}
        {{/each}}
      {{else}}<p class="arcflight-sheet__hint">No pending consequence candidates.</p>{{/if}}
    </section>
    {{/if}}

    <div class="arcflight-travel-guided-drawers">
      <details id="arcflight-guided-reaction-console" class="arcflight-card-drawer" tabindex="-1"><summary>🧭 Reaction Console <span>{{state.guidedBridge.drawers.reactions}}</span></summary><p>Resolve Navigator Hard Correction and other pending reactions in the advanced Reaction Console drawer below.</p></details>
      <details id="arcflight-guided-hazard-deck" class="arcflight-card-drawer arcflight-card-stack" tabindex="-1"><summary>⚠️ Hazard Deck <span>{{state.guidedBridge.drawers.hazards}}</span></summary>
        <p class="arcflight-sheet__hint"><strong>{{state.travelV2Hazards.deckName}}</strong> · Available cards: {{state.travelV2Hazards.availableCount}} · Drawn thresholds: {{state.travelV2Hazards.drawnThresholdText}}. Session-local only; no actor/item/chat/journal/combat mutation.</p>
        <button type="button" data-arcflight-travel-v2-hazard-draw {{#if state.isCompleted}}disabled{{/if}}>Draw Hazard</button>
        {{#if state.guidedBridge.hazards.hasAny}}
          <h4>Pending Hazard Cards</h4>{{#each state.guidedBridge.hazards.pending}}<article class="arcflight-travel-card arcflight-pending-card arcflight-gm-only"><strong>{{name}}</strong>{{#if category}}<span>{{category}}</span>{{/if}}<p>{{description}}</p>{{#if playerText}}<p><strong>Player-safe reveal:</strong> {{playerText}}</p>{{else}}<p class="arcflight-sheet__hint">No player-safe reveal text.</p>{{/if}}{{#if pressureContext}}<p class="arcflight-sheet__hint"><strong>Suggested pressure/consequence:</strong> {{pressureContext}}</p>{{/if}}<p class="arcflight-gm-only">🔒 {{gmText}}</p><button type="button" data-arcflight-travel-v2-hazard-reveal="{{id}}" {{#if revealDisabled}}disabled{{/if}}>Reveal to Players</button><button type="button" data-arcflight-travel-v2-hazard-activate="{{id}}">Activate</button><button type="button" data-arcflight-travel-v2-hazard-hold="{{id}}">Hold</button><button type="button" data-arcflight-travel-v2-hazard-clear="{{id}}">Dismiss</button></article>{{else}}<p class="arcflight-sheet__hint">No pending hazard cards.</p>{{/each}}
          <h4>Held Hazard Cards</h4>{{#each state.guidedBridge.hazards.held}}<article class="arcflight-travel-card arcflight-pending-card arcflight-gm-only"><strong>{{name}}</strong><p>{{playerText}}</p><p class="arcflight-gm-only">🔒 {{gmText}}</p><button type="button" data-arcflight-travel-v2-hazard-reveal="{{id}}" {{#if revealDisabled}}disabled{{/if}}>Reveal to Players</button><button type="button" data-arcflight-travel-v2-hazard-activate="{{id}}">Activate</button><button type="button" data-arcflight-travel-v2-hazard-clear="{{id}}">Dismiss</button></article>{{else}}<p class="arcflight-sheet__hint">No held hazard cards.</p>{{/each}}
          <h4>Revealed Hazard Cards</h4>{{#each state.guidedBridge.hazards.revealed}}<article class="arcflight-travel-card arcflight-player-safe"><strong>{{name}}</strong><p>{{playerText}}</p>{{#if publicModifierText}}<p><strong>Public mechanics:</strong> {{publicModifierText}}</p>{{/if}}<p class="arcflight-sheet__hint">{{statusLabel}}</p></article>{{else}}<p class="arcflight-sheet__hint">No revealed hazard cards.</p>{{/each}}
          <h4>Active Hazard Cards</h4>{{#each state.guidedBridge.hazards.active}}<article class="arcflight-travel-card arcflight-player-safe"><strong>{{name}}</strong><p>{{playerText}}</p>{{#if publicModifierText}}<p><strong>Public mechanics:</strong> {{publicModifierText}}</p>{{/if}}<p class="arcflight-gm-only">🔒 {{gmText}}</p>{{#if gmMechanicalNotes}}<p class="arcflight-gm-only">🔒 Mechanics: {{gmMechanicalNotes}}</p>{{/if}}{{#if canApplyToRound}}<button type="button" data-arcflight-travel-v2-hazard-apply="{{id}}">{{applyButtonLabel}}</button>{{else}}<p class="arcflight-sheet__hint">Already applied to this round.</p>{{/if}}<button type="button" data-arcflight-travel-v2-hazard-reveal="{{id}}" {{#if revealDisabled}}disabled{{/if}}>Reveal to Players</button><button type="button" data-arcflight-travel-v2-hazard-clear="{{id}}">Clear</button></article>{{else}}<p class="arcflight-sheet__hint">No active hazard cards.</p>{{/each}}
          <h4>Dismissed / Resolved Hazard Cards</h4>{{#each state.guidedBridge.hazards.cleared}}<article class="arcflight-travel-card arcflight-resolved arcflight-gm-only"><strong>{{name}}</strong>{{#if revealed}}<p>{{playerText}}</p>{{/if}}<p class="arcflight-sheet__hint">Cleared</p></article>{{else}}<p class="arcflight-sheet__hint">No cleared hazard cards.</p>{{/each}}
        {{else}}<p class="arcflight-sheet__hint">Hazard Deck has no drawn cards yet.</p>{{/if}}
      </details>
      <details id="arcflight-guided-ship-scars-deck" class="arcflight-card-drawer arcflight-card-stack arcflight-ship-scar-drawer" tabindex="-1"><summary>🚨 Ship Scars Deck <span>{{state.guidedBridge.drawers.shipScars}}</span></summary>
        <p class="arcflight-danger-attention">Applying a Ship Scar writes to the selected ship actor flags only after explicit GM Apply.</p>
        {{#if state.guidedBridge.shipScars.hasAny}}
          <h4>Pending Scar Cards</h4>{{#each state.guidedBridge.shipScars.pending}}<article class="arcflight-travel-card arcflight-danger-attention"><strong>{{name}}</strong><p>{{playerText}}</p><p><strong>Repair:</strong> {{repairRequirement}}</p><p><strong>Downtime/Cost:</strong> {{downtimeRequirement}} {{costRequirement}}</p><p>{{roleplayHook}}</p><p class="arcflight-gm-only">🔒 {{gmText}}</p><button type="button" data-arcflight-travel-v2-ship-scar-apply="{{id}}">Apply Ship Scar</button><button type="button" data-arcflight-guided-action="ship-scars">Hold Pending</button><button type="button" data-arcflight-travel-v2-ship-scar-dismiss="{{id}}">Dismiss</button><button type="button" data-arcflight-guided-action="send-players">Send Player-Safe Reveal</button></article>{{else}}<p class="arcflight-sheet__hint">No pending Ship Scar cards.</p>{{/each}}
          <h4>Applied Scar Cards</h4>{{#each state.guidedBridge.shipScars.applied}}<article class="arcflight-travel-card arcflight-player-safe"><strong>{{name}}</strong><p>{{playerText}}</p><button type="button" data-arcflight-travel-v2-ship-scar-repair="{{id}}">Mark Repaired</button><button type="button" data-arcflight-guided-action="send-players">Send Player-Safe Reveal</button></article>{{else}}<p class="arcflight-sheet__hint">No applied Ship Scars.</p>{{/each}}
          <h4>Repaired / Dismissed Scar Cards</h4>{{#each state.guidedBridge.shipScars.resolved}}<article class="arcflight-travel-card arcflight-resolved"><strong>{{name}}</strong><p>{{statusLabel}}</p><p>{{playerText}}</p></article>{{else}}<p class="arcflight-sheet__hint">No repaired or dismissed Ship Scars.</p>{{/each}}
        {{else}}<p class="arcflight-sheet__hint">Ship Scars Deck has no drawn candidates yet.</p>{{/if}}
      </details>
      <details class="arcflight-card-drawer arcflight-momentum-drawer"><summary>✨ Momentum Pool <span>{{state.travelV2Momentum.value}}</span></summary>
        <p><strong>Momentum:</strong> {{state.travelV2Momentum.value}} · Earned {{state.travelV2Momentum.earnedTotal}} · Spent {{state.travelV2Momentum.spentTotal}}</p>
        <p class="arcflight-sheet__hint">{{state.travelV2Momentum.publicHelpText}} Session-local only; no actor/item/chat/journal/combat mutation.</p>
        {{#if state.travelV2Momentum.hasSpendOptions}}<h4>Available Spends</h4>{{#each state.travelV2Momentum.spendOptions}}<button type="button" data-arcflight-travel-v2-momentum-downgrade data-round-index="{{roundIndex}}" data-station-key="{{stationKey}}" {{#if disabled}}disabled{{/if}}>{{label}}</button>{{/each}}{{else}}<p class="arcflight-sheet__hint">No eligible failure downgrade spend is available right now.</p>{{/if}}
        <h4>Recent Momentum Records</h4>{{#if state.travelV2Momentum.hasRecords}}{{#each state.travelV2Momentum.recentRecords}}<article class="arcflight-travel-card"><strong>{{sourceLabel}} · {{amount}}</strong><p>{{publicSummary}}</p>{{#if gmNote}}<p class="arcflight-gm-only">🔒 {{gmNote}}</p>{{/if}}</article>{{/each}}{{else}}<p class="arcflight-sheet__hint">No Momentum has been earned or spent yet.</p>{{/if}}
      </details>
      <details class="arcflight-card-drawer"><summary>🗣️ Support Orders</summary><p title="Future system. Stations may support another station instead of making a primary roll.">Future placeholder — Support Orders: Not Assigned</p><button type="button" disabled>Assign Support</button></details>
      <details class="arcflight-card-drawer arcflight-fortune-drawer"><summary>🃏 Void Fortune Hand</summary><p title="Future system. Special cards drawn, held, and spent during travel.">Future placeholder — Void Fortune: 0 Cards</p><button type="button" disabled>Open Fortune Hand</button></details>
      <details class="arcflight-card-drawer"><summary>🛠️ Ship Upgrade Effects</summary><p title="Future system. Installed ship upgrades may add travel actions, reactions, or passive effects.">Future placeholder — Smuggler Engine: Low-Burn Route Option · Reinforced Hull: Reduce Hull Pressure Once</p></details>
      <details id="arcflight-guided-followups" class="arcflight-card-drawer" tabindex="-1"><summary>📜 Outcome & Follow-ups</summary><p>Follow-ups: {{state.guidedBridge.drawers.followUps}}</p></details>
      <details id="arcflight-guided-completed" class="arcflight-card-drawer arcflight-travel-runner-mvp__completed-history" tabindex="-1"><summary>💾 Completed Sessions <span>{{state.travelV2CompletedSessionHistory.count}}</span></summary>
        <p class="arcflight-sheet__hint"><strong>Read-only history.</strong> Newest completed Travel v2 runner sessions first. Viewing history never applies outcomes, follow-ups, or actor changes.</p>
        {{#if state.travelV2CompletedSessionHistory.hasRows}}
          {{#each state.travelV2CompletedSessionHistory.rows}}
            <article class="arcflight-travel-runner-mvp__completed-card">
              <header><strong>{{eventName}}</strong><span>{{completedAtLabel}}</span></header>
              <p>{{shipName}}{{#if completedBy}} · Completed by {{completedBy}}{{/if}}</p>
              <p class="arcflight-sheet__hint">Outcome: {{#if outcome}}{{outcome}}{{else}}{{outcomeKey}}{{/if}} · Status: {{applicationStatusLabel}} · Follow-ups: {{followUpCount}}</p>
              {{#if summaryView.available}}
                <section class="arcflight-travel-runner-mvp__completed-summary">
                  <h4>{{summaryView.publicSummary.title}}</h4>
                  {{#each summaryView.publicSummary.paragraphs}}<p>{{this}}</p>{{/each}}
                  {{#if summaryView.publicSummary.chips.length}}<p class="arcflight-travel-runner-mvp__chips">{{#each summaryView.publicSummary.chips}}<span>{{this}}</span>{{/each}}</p>{{/if}}
                  <p class="arcflight-sheet__hint">Rounds: {{summaryView.rounds.length}} · Station results: {{summaryView.stationResults.length}} · Consequences applied/dismissed/pending: {{summaryView.consequenceCounts.applied}}/{{summaryView.consequenceCounts.dismissed}}/{{summaryView.consequenceCounts.pending}}</p>
                </section>
              {{else}}<p class="arcflight-sheet__hint">No stored completion summary is available for this legacy entry.</p>{{/if}}
            </article>
          {{/each}}
        {{else}}<p class="arcflight-sheet__hint">No completed Travel v2 runner sessions are saved in the runner library yet.</p>{{/if}}
      </details>
      {{#if state.travelV2DevToolsEnabled}}<details id="arcflight-guided-devtools" class="arcflight-card-drawer arcflight-gm-only" tabindex="-1"><summary>🧪 Dev Tools</summary><p>GM-only dev tools are gated by travelV2DevToolsEnabled below.</p></details>{{/if}}
      <details class="arcflight-card-drawer arcflight-gm-only"><summary>🔒 Event Schema</summary><p>Future authoring/schema support. GM-only. Category: {{state.guidedBridge.tags.category}} · Level: {{state.guidedBridge.tags.level}} · Severity: {{state.guidedBridge.tags.severity}} · Stations: {{state.guidedBridge.stationSummary.total}} · Pressure Suggestions / Hazards / Follow-ups prepared from event schema.</p></details>
    </div>
  </section>
  {{/if}}

  {{#unless state.compactRunner}}
  <details id="arcflight-guided-session-setup" class="arcflight-travel-runner-advanced" tabindex="-1">
    <summary><strong>Advanced Runner Details</strong> — session setup, legacy controls, detailed reviews, completed sessions, and GM-only tooling</summary>
  <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__session-toolbar">
    <button type="button" class="arcflight-travel-runner-mvp__action-toggle" data-arcflight-runner-toggle-session-actions aria-label="{{#if state.sessionActionsExpanded}}Collapse Session Actions{{else}}Expand Session Actions{{/if}}" aria-expanded="{{#if state.sessionActionsExpanded}}true{{else}}false{{/if}}">
      {{#if state.sessionActionsExpanded}}▼{{else}}▶{{/if}} Session Actions
    </button>
    {{#if state.sessionActionsExpanded}}
    <div class="arcflight-travel-runner-mvp__actions">
      <button type="button" data-arcflight-runner-save {{#unless state.canSaveSession}}disabled{{/unless}}>Save Current Session</button>
      <button type="button" data-arcflight-runner-save-as {{#unless state.canSaveSessionAs}}disabled{{/unless}}>Save Current Session As</button>
      <button type="button" data-arcflight-runner-export {{#unless state.canExportSession}}disabled{{/unless}}>Export Session JSON</button>
      <button type="button" data-arcflight-runner-import-session>Import Session JSON</button>
      <button type="button" data-arcflight-runner-clear {{#unless state.hasSession}}disabled{{/unless}}>Clear Local Session</button>
      <button type="button" data-arcflight-open-travel-scene-overlay>Open Travel Scene Overlay</button>
    </div>
    {{/if}}
  </section>

  <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__session-controls {{#if state.currentSessionCollapsed}}arcflight-travel-runner-mvp__session-controls--collapsed{{/if}}">
    <div class="arcflight-travel-runner-mvp__session-controls-header">
      <button type="button" class="arcflight-travel-runner-mvp__collapse-toggle" data-arcflight-runner-toggle-current-session aria-label="{{#if state.currentSessionCollapsed}}Expand Current Runner Session{{else}}Collapse Current Runner Session{{/if}}" aria-expanded="{{#unless state.currentSessionCollapsed}}true{{else}}false{{/unless}}">
        {{#if state.currentSessionCollapsed}}▶{{else}}▼{{/if}}
      </button>
      <h2>Current Runner Session</h2>
    </div>
    {{#unless state.currentSessionCollapsed}}
      <div class="arcflight-travel-runner-mvp__stats">
        <div><span>Session</span><strong>{{state.currentSessionName}}</strong></div>
        <div><span>Status</span><strong>{{state.currentSessionStatusLabel}}</strong></div>
        <div><span>Event</span><strong>{{#if state.hasSession}}{{state.event.name}}{{else}}No active event{{/if}}</strong></div>
        <div><span>Progress</span><strong>{{#if state.isCompleted}}Completed{{else}}Round {{state.currentRoundNumber}}{{/if}}</strong></div>
      </div>
      <p class="arcflight-sheet__hint">Session import/export only reads or writes Runner Session Library data after explicit confirmation; it never applies effects or mutates actors, AP/RAP, chat, journals, combat, drafts, or published events.</p>
    {{/unless}}
  </section>


  <section class="arcflight-travel-runner-mvp__panel">
    <h2>Published Travel Event Library</h2>
    {{#unless state.hasSession}}
      <p class="arcflight-sheet__hint"><strong>How to start a local runner session:</strong> select a published finalized travel event, click <strong>Start Local Runner Session</strong>, choose a ship/PF2E vehicle, then confirm the DialogV2 prompt to create a local runner session.</p>
    {{/unless}}
    {{#if state.hasPublishedEvents}}
      <label class="arcflight-sheet__field">
        <span>Published Event</span>
        <select data-arcflight-runner-event-select {{#if state.hasSession}}disabled{{/if}}>
          {{#each state.library.entries}}
            <option value="{{id}}" {{#if selected}}selected{{/if}} {{#if isMalformed}}disabled{{/if}}>{{name}} — {{categoryLabel}}{{#if isMalformed}} (malformed){{/if}}</option>
          {{/each}}
        </select>
      </label>
      <div class="arcflight-travel-runner-mvp__actions">
        <button type="button" data-arcflight-start-travel-event-runner {{#unless state.startupDiagnostics.canStart}}disabled{{/unless}}>Start Local Runner Session</button>
      </div>
      {{#unless state.hasLoadableEvents}}<p class="arcflight-sheet__hint">Published travel event entries exist, but none are valid finalized travel events. Malformed or not-finalized entries cannot start a local runner session.</p>{{/unless}}
    {{else}}
      <p class="arcflight-sheet__hint">No published finalized travel event exists. Publish a finalized event from the Published Travel Event Library before starting a local runner session.</p>
      <button type="button" data-arcflight-start-travel-event-runner disabled>Start Local Runner Session</button>
    {{/if}}
    <div class="arcflight-sheet__hint">
      <strong>Local runner session startup diagnostics:</strong>
      {{#if state.startupDiagnostics.canStart}}
        Ready: a published finalized travel event, PF2E vehicle / Arcflight ship actor, and Foundry DialogV2 are available.
      {{else}}
        Start Local Runner Session is blocked:
        <ul>
          {{#each state.startupDiagnostics.issues}}<li>{{this}}</li>{{/each}}
        </ul>
      {{/if}}
    </div>
  </section>




  {{#if state.hasSession}}
    <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__event">
      <h2>{{state.event.name}}</h2>
      <div class="arcflight-travel-runner-mvp__stats">
        <div><span>Category</span><strong>{{state.event.categoryLabel}}</strong></div>
        <div><span>Base DC</span><strong>{{state.event.baseDC}}</strong></div>
        <div><span>Status</span><strong>{{state.session.status}}</strong></div>
      </div>
      {{#if state.session.ship.actorName}}<p class="arcflight-sheet__hint"><strong>Selected ship / vehicle:</strong> {{state.session.ship.actorName}}</p>{{/if}}
      {{#if state.session.notes}}<p class="arcflight-sheet__hint"><strong>Session notes:</strong> {{state.session.notes}}</p>{{/if}}
    </section>


    <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__assignments">
      <h2>Station Assignments</h2>
      <p class="arcflight-sheet__hint">Assignments are local runner-session metadata only. They never mutate actors, ship data, resources, AP/RAP, chat, journals, combat, drafts, or published events.</p>
      <div class="arcflight-travel-runner-mvp__assignment-rows">
        {{#each state.stationAssignments.rows}}
          <div class="arcflight-travel-runner-mvp__assignment-row">
            <strong>{{stationName}}</strong>
            <span>{{assignedActorName}} — {{sourceLabel}}</span>
            <select data-arcflight-runner-assignment-select data-station-key="{{stationKey}}" {{#if ../state.isCompleted}}disabled{{/if}}>
              <option value="">Unassigned</option>
              {{#each options}}
                <option value="{{actorUuid}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
            {{#if isNpcAssignment}}
              <label>NPC Controller
                <select data-arcflight-runner-npc-controller-select data-station-key="{{stationKey}}" {{#if ../state.isCompleted}}disabled{{/if}}>
                  <option value="">Unassigned player controller</option>
                  {{#each npcControllerOptions}}<option value="{{userId}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              </label>
            {{/if}}
            {{#if canClear}}<button type="button" data-arcflight-runner-clear-assignment data-station-key="{{stationKey}}" {{#if ../state.isCompleted}}disabled{{/if}}>Clear Override</button>{{/if}}
            <button type="button" data-arcflight-runner-reset-assignment data-station-key="{{stationKey}}" {{#if ../state.isCompleted}}disabled{{/if}}>Reset to Ship Assignment</button>
          </div>
        {{/each}}
      </div>
    </section>

    <section class="arcflight-travel-runner-mvp__panel">
      <h2>Current Round / Run Event</h2>
      <h3>Round {{state.currentRoundNumber}}: {{state.currentRoundTitle}}</h3>
      {{#if state.currentRoundOpeningVignette}}<p class="arcflight-travel-runner-mvp__vignette">{{state.currentRoundOpeningVignette}}</p>{{/if}}

      <section class="arcflight-travel-runner-mvp__v2-preview" aria-label="{{state.travelV2PreviewPanel.title}}">
        <header>
          <h3>{{state.travelV2PreviewPanel.title}}</h3>
          <p class="arcflight-sheet__hint">{{state.travelV2PreviewPanel.subtitle}}</p>
        </header>
        {{#if state.travelV2PreviewPanel.available}}
          <div class="arcflight-travel-runner-mvp__v2-preview-rows">
            {{#each state.travelV2PreviewPanel.rows}}
              <article class="arcflight-travel-runner-mvp__v2-preview-row arcflight-travel-runner-mvp__v2-preview-row--{{tone}}">
                <div>
                  <strong>{{outcomeLabel}}</strong>
                  <p>{{summaryText}}</p>
                </div>
                <div class="arcflight-travel-runner-mvp__v2-preview-actions">
                  <div class="arcflight-travel-runner-mvp__v2-preview-chips" aria-label="Preview pressure changes">
                    {{#each pressureChips}}
                      <span class="arcflight-travel-runner-mvp__v2-preview-chip"><strong>{{displayAmount}}</strong> {{label}}</span>
                    {{/each}}
                  </div>
                  <button type="button" class="arcflight-travel-runner-mvp__v2-preview-apply" data-arcflight-travel-v2-pressure-apply="{{outcomeKey}}" {{#if pressureApplyDisabled}}disabled{{/if}} title="{{#if pressureApplyDisabled}}{{pressureApplyBlockedReason}}{{else}}Apply this pressure outcome.{{/if}}">{{pressureApplyLabel}}</button>
                  {{#if canCorrectPressure}}<button type="button" class="arcflight-travel-runner-mvp__v2-preview-correct" data-arcflight-travel-v2-pressure-correct="{{outcomeKey}}" {{#if pressureCorrectionDisabled}}disabled{{/if}}>{{pressureCorrectionLabel}}</button>{{/if}}
                  {{#if isEffectiveAppliedOutcome}}<p class="arcflight-sheet__hint arcflight-travel-runner-mvp__v2-preview-blocked">Effective applied outcome</p>{{/if}}
                  {{#if pressureApplyBlockedReason}}<p class="arcflight-sheet__hint arcflight-travel-runner-mvp__v2-preview-blocked">{{pressureApplyBlockedReason}}</p>{{/if}}
                  {{#if pressureCorrectionBlockedReason}}{{#if pressureCorrectionDisabled}}{{#unless isEffectiveAppliedOutcome}}<p class="arcflight-sheet__hint arcflight-travel-runner-mvp__v2-preview-blocked">{{pressureCorrectionBlockedReason}}</p>{{/unless}}{{/if}}{{/if}}
                </div>
              </article>
            {{/each}}
          </div>
        {{else}}
          <p class="arcflight-sheet__hint">Travel v2 pressure preview is unavailable for the current runner state.</p>
        {{/if}}
        {{#if state.travelV2PreviewPanel.roundActionOrderDisplay.hasRows}}
          <section class="arcflight-travel-runner-mvp__v2-benefits arcflight-travel-runner-mvp__v2-order" aria-label="{{state.travelV2PreviewPanel.roundActionOrderDisplay.title}}">
            <header>
              <h4>{{state.travelV2PreviewPanel.roundActionOrderDisplay.title}}</h4>
              <p class="arcflight-sheet__hint">{{state.travelV2PreviewPanel.roundActionOrderDisplay.subtitle}}</p>
            </header>
            <div class="arcflight-travel-runner-mvp__v2-benefit-rows">
              {{#each state.travelV2PreviewPanel.roundActionOrderDisplay.rows}}
                <article class="arcflight-travel-runner-mvp__v2-benefit-row {{#if current}}arcflight-travel-runner-mvp__v2-benefit-row--current{{/if}}">
                  <div>
                    <strong>{{orderLabel}} · {{stationName}}</strong>
                    <p>{{selectedActionLabel}}</p>
                    {{#if currentMarker}}<p class="arcflight-sheet__hint">{{currentMarker}}</p>{{/if}}
                  </div>
                  <div class="arcflight-travel-runner-mvp__v2-benefit-meta">
                    <span class="arcflight-travel-runner-mvp__v2-preview-chip">Order {{orderNumber}}</span>
                    <span class="arcflight-travel-runner-mvp__v2-preview-chip">{{statusLabel}}</span>
                    {{#if resultLabel}}<span class="arcflight-travel-runner-mvp__v2-preview-chip">{{resultLabel}}</span>{{/if}}
                  </div>
                </article>
              {{/each}}
            </div>
            {{#if state.travelV2PreviewPanel.roundActionOrderDisplay.canRequestReorderReview}}
              <div class="arcflight-travel-runner-mvp__v2-preview-actions">
                <button type="button" data-arcflight-travel-v2-order-reorder-request data-proposed-order="{{state.travelV2PreviewPanel.roundActionOrderDisplay.proposedShellOrderCsv}}" title="Requests a GM-only review of a proposed station order in local render state only. Does not apply, save, persist, or advance the round.">Request Reorder Review</button>
              </div>
            {{/if}}
            {{#if state.travelV2PreviewPanel.roundActionOrderDisplay.commitResult.available}}
              <section class="arcflight-travel-runner-mvp__v2-order-commit-result" aria-label="{{state.travelV2PreviewPanel.roundActionOrderDisplay.commitResult.title}}">
                <h5>{{state.travelV2PreviewPanel.roundActionOrderDisplay.commitResult.title}} · {{state.travelV2PreviewPanel.roundActionOrderDisplay.commitResult.statusLabel}}</h5>
                <p class="arcflight-sheet__hint">{{state.travelV2PreviewPanel.roundActionOrderDisplay.commitResult.summaryText}}</p>
                {{#if state.travelV2PreviewPanel.roundActionOrderDisplay.commitResult.hasPreviousRows}}
