          {{#if state.travelV2PreviewPanel.travelV2EventOutcomePackage.hasShipScars}}<p class="arcflight-sheet__hint">Ship scar candidates: {{state.travelV2PreviewPanel.travelV2EventOutcomePackage.shipScarCandidates.length}}</p>{{/if}}
          {{#if state.travelV2PreviewPanel.travelV2EventOutcomePackage.hasFortunes}}<p class="arcflight-sheet__hint">Fortune candidates: {{state.travelV2PreviewPanel.travelV2EventOutcomePackage.fortuneCandidates.length}}</p>{{/if}}
          {{#if state.travelV2PreviewPanel.travelV2EventOutcomePackage.hasRewards}}<p class="arcflight-sheet__hint">Reward candidates: {{state.travelV2PreviewPanel.travelV2EventOutcomePackage.rewardCandidates.length}}</p>{{/if}}
          {{#if state.travelV2PreviewPanel.travelV2EventOutcomePackage.hasConsequences}}<p class="arcflight-sheet__hint">Consequence candidates: {{state.travelV2PreviewPanel.travelV2EventOutcomePackage.consequenceCandidates.length}}</p>{{/if}}
          {{#if state.travelV2PreviewPanel.travelV2EventOutcomePackage.hasFeedback}}<p class="arcflight-travel-runner-mvp__v2-preview-feedback">{{state.travelV2PreviewPanel.travelV2EventOutcomePackage.feedbackText}}</p>{{/if}}
