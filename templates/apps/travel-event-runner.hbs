<div class="arcflight-travel-runner-mvp">
  <header class="arcflight-travel-runner-mvp__header">
    <div class="arcflight-travel-runner-mvp__header-row">
      <h1>Travel Event Runner MVP</h1>
      <div class="arcflight-travel-runner-mvp__actions">
        <button type="button" data-arcflight-runner-toggle-compact>{{#if state.compactRunner}}Expand Runner{{else}}Compact Runner{{/if}}</button>
        <button type="button" data-arcflight-open-travel-scene-overlay>Open Travel Scene Overlay</button>
        {{#if state.hasSession}}<button type="button" data-arcflight-runner-send-mission-board>Send/Refresh Player Mission Board</button>{{/if}}
      </div>
    </div>
    {{#unless state.compactRunner}}<p>{{hardBoundaryHint}}</p>{{/unless}}
    <p class="arcflight-sheet__hint"><strong>Status:</strong> {{statusMessage}}</p>
    {{#if state.compactRunner}}
      <div class="arcflight-travel-runner-mvp__compact-summary">
        <div><span>Event</span><strong>{{#if state.hasSession}}{{state.event.name}}{{else}}No active event{{/if}}</strong></div>
        <div><span>Round</span><strong>{{state.compactRoundLabel}}</strong></div>
      </div>
    {{/if}}
  </header>

  {{#unless state.compactRunner}}
  <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__session-toolbar">
    <button type="button" class="arcflight-travel-runner-mvp__action-toggle" data-arcflight-runner-toggle-session-actions aria-label="{{#if state.sessionActionsExpanded}}Collapse Session Actions{{else}}Expand Session Actions{{/if}}" aria-expanded="{{#if state.sessionActionsExpanded}}true{{else}}false{{/if}}">
      {{#if state.sessionActionsExpanded}}▼{{else}}▶{{/if}} Session Actions
    </button>
    {{#if state.sessionActionsExpanded}}
    <div class="arcflight-travel-runner-mvp__actions">
      <button type="button" data-arcflight-runner-save {{#unless state.canSaveSession}}disabled{{/unless}}>Save Current Session</button>
      <button type="button" data-arcflight-runner-save-as {{#unless state.canSaveSessionAs}}disabled{{/unless}}>Save Current Session As</button>
      <button type="button" data-arcflight-runner-export {{#unless state.canExportSession}}disabled{{/unless}}>Export Session JSON</button>
      <button type="button" data-arcflight-runner-import-session>Import Session JSON</button>
      <button type="button" data-arcflight-runner-clear {{#unless state.hasSession}}disabled{{/unless}}>Clear Local Session</button>
      <button type="button" data-arcflight-open-travel-scene-overlay>Open Travel Scene Overlay</button>
    </div>
    {{/if}}
  </section>

  <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__session-controls {{#if state.currentSessionCollapsed}}arcflight-travel-runner-mvp__session-controls--collapsed{{/if}}">
    <div class="arcflight-travel-runner-mvp__session-controls-header">
      <button type="button" class="arcflight-travel-runner-mvp__collapse-toggle" data-arcflight-runner-toggle-current-session aria-label="{{#if state.currentSessionCollapsed}}Expand Current Runner Session{{else}}Collapse Current Runner Session{{/if}}" aria-expanded="{{#unless state.currentSessionCollapsed}}true{{else}}false{{/unless}}">
        {{#if state.currentSessionCollapsed}}▶{{else}}▼{{/if}}
      </button>
      <h2>Current Runner Session</h2>
    </div>
    {{#unless state.currentSessionCollapsed}}
      <div class="arcflight-travel-runner-mvp__stats">
        <div><span>Session</span><strong>{{state.currentSessionName}}</strong></div>
        <div><span>Status</span><strong>{{state.currentSessionStatusLabel}}</strong></div>
        <div><span>Event</span><strong>{{#if state.hasSession}}{{state.event.name}}{{else}}No active event{{/if}}</strong></div>
        <div><span>Progress</span><strong>{{#if state.isCompleted}}Completed{{else}}Round {{state.currentRoundNumber}}{{/if}}</strong></div>
      </div>
      <p class="arcflight-sheet__hint">Session import/export only reads or writes Runner Session Library data after explicit confirmation; it never applies effects or mutates actors, AP/RAP, chat, journals, combat, drafts, or published events.</p>
    {{/unless}}
  </section>


  <section class="arcflight-travel-runner-mvp__panel">
    <h2>Published Travel Event Library</h2>
    {{#if state.hasPublishedEvents}}
      <label class="arcflight-sheet__field">
        <span>Published Event</span>
        <select data-arcflight-runner-event-select {{#if state.hasSession}}disabled{{/if}}>
          {{#each state.library.entries}}
            <option value="{{id}}" {{#if selected}}selected{{/if}} {{#if isMalformed}}disabled{{/if}}>{{name}} — {{categoryLabel}}{{#if isMalformed}} (malformed){{/if}}</option>
          {{/each}}
        </select>
      </label>
      <div class="arcflight-travel-runner-mvp__actions">
        <button type="button" data-arcflight-start-travel-event-runner {{#if state.hasSession}}disabled{{/if}}>Start Local Runner Session</button>
      </div>
      {{#unless state.hasLoadableEvents}}<p class="arcflight-sheet__hint">Published library entries exist, but none are valid finalized travel events.</p>{{/unless}}
    {{else}}
      <p class="arcflight-sheet__hint">No published travel events are available. Publish a finalized event from the Published Travel Event Library before starting the runner.</p>
      <button type="button" data-arcflight-start-travel-event-runner disabled>Start Local Runner Session</button>
    {{/if}}
  </section>




  {{#if state.hasSession}}
    <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__event">
      <h2>{{state.event.name}}</h2>
      <div class="arcflight-travel-runner-mvp__stats">
        <div><span>Category</span><strong>{{state.event.categoryLabel}}</strong></div>
        <div><span>Base DC</span><strong>{{state.event.baseDC}}</strong></div>
        <div><span>Status</span><strong>{{state.session.status}}</strong></div>
      </div>
      {{#if state.session.ship.actorName}}<p class="arcflight-sheet__hint"><strong>Selected ship / vehicle:</strong> {{state.session.ship.actorName}}</p>{{/if}}
      {{#if state.session.notes}}<p class="arcflight-sheet__hint"><strong>Session notes:</strong> {{state.session.notes}}</p>{{/if}}
    </section>


    <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__assignments">
      <h2>Station Assignments</h2>
      <p class="arcflight-sheet__hint">Assignments are local runner-session metadata only. They never mutate actors, ship data, resources, AP/RAP, chat, journals, combat, drafts, or published events.</p>
      <div class="arcflight-travel-runner-mvp__assignment-rows">
        {{#each state.stationAssignments.rows}}
          <div class="arcflight-travel-runner-mvp__assignment-row">
            <strong>{{stationName}}</strong>
            <span>{{assignedActorName}} — {{sourceLabel}}</span>
            <select data-arcflight-runner-assignment-select data-station-key="{{stationKey}}" {{#if ../state.isCompleted}}disabled{{/if}}>
              <option value="">Unassigned</option>
              {{#each options}}
                <option value="{{actorUuid}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
            {{#if isNpcAssignment}}
              <label>NPC Controller
                <select data-arcflight-runner-npc-controller-select data-station-key="{{stationKey}}" {{#if ../state.isCompleted}}disabled{{/if}}>
                  <option value="">Unassigned player controller</option>
                  {{#each npcControllerOptions}}<option value="{{userId}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              </label>
            {{/if}}
            {{#if canClear}}<button type="button" data-arcflight-runner-clear-assignment data-station-key="{{stationKey}}" {{#if ../state.isCompleted}}disabled{{/if}}>Clear Override</button>{{/if}}
            <button type="button" data-arcflight-runner-reset-assignment data-station-key="{{stationKey}}" {{#if ../state.isCompleted}}disabled{{/if}}>Reset to Ship Assignment</button>
          </div>
        {{/each}}
      </div>
    </section>

    <section class="arcflight-travel-runner-mvp__panel">
      <h2>Current Round / Run Event</h2>
      <h3>Round {{state.currentRoundNumber}}: {{state.currentRoundTitle}}</h3>
      {{#if state.currentRoundOpeningVignette}}<p class="arcflight-travel-runner-mvp__vignette">{{state.currentRoundOpeningVignette}}</p>{{/if}}

      <section class="arcflight-travel-runner-mvp__v2-preview" aria-label="{{state.travelV2PreviewPanel.title}}">
        <header>
          <h3>{{state.travelV2PreviewPanel.title}}</h3>
          <p class="arcflight-sheet__hint">{{state.travelV2PreviewPanel.subtitle}}</p>
        </header>
        {{#if state.travelV2PreviewPanel.available}}
          <div class="arcflight-travel-runner-mvp__v2-preview-rows">
            {{#each state.travelV2PreviewPanel.rows}}
              <article class="arcflight-travel-runner-mvp__v2-preview-row arcflight-travel-runner-mvp__v2-preview-row--{{tone}}">
                <div>
                  <strong>{{outcomeLabel}}</strong>
                  <p>{{summaryText}}</p>
                </div>
                <div class="arcflight-travel-runner-mvp__v2-preview-actions">
                  <div class="arcflight-travel-runner-mvp__v2-preview-chips" aria-label="Preview pressure changes">
                    {{#each pressureChips}}
                      <span class="arcflight-travel-runner-mvp__v2-preview-chip"><strong>{{displayAmount}}</strong> {{label}}</span>
                    {{/each}}
                  </div>
                  <button type="button" class="arcflight-travel-runner-mvp__v2-preview-apply" data-arcflight-travel-v2-pressure-apply="{{outcomeKey}}" {{#if pressureApplyDisabled}}disabled{{/if}}>{{pressureApplyLabel}}</button>
                  {{#if pressureApplyBlockedReason}}<p class="arcflight-sheet__hint arcflight-travel-runner-mvp__v2-preview-blocked">{{pressureApplyBlockedReason}}</p>{{/if}}
                </div>
              </article>
            {{/each}}
          </div>
        {{else}}
          <p class="arcflight-sheet__hint">Travel v2 pressure preview is unavailable for the current runner state.</p>
        {{/if}}
        {{#if state.travelV2PreviewPanel.pressureApplication.alreadyApplied}}
          <p class="arcflight-travel-runner-mvp__v2-preview-feedback arcflight-travel-runner-mvp__v2-preview-feedback--applied">Travel v2 pressure already applied for this round{{#if state.travelV2PreviewPanel.pressureApplication.appliedOutcomeLabel}}: {{state.travelV2PreviewPanel.pressureApplication.appliedOutcomeLabel}}{{/if}}.</p>
        {{/if}}
        {{#if state.travelV2PreviewPanel.pressureApplication.hasFeedback}}
          <p class="arcflight-travel-runner-mvp__v2-preview-feedback">{{state.travelV2PreviewPanel.pressureApplication.feedbackText}}</p>
        {{/if}}
        <p class="arcflight-sheet__hint"><strong>GM-only:</strong> {{state.travelV2PreviewPanel.footerText}}</p>
      </section>

      <section class="arcflight-travel-runner-mvp__phase" aria-label="Current round phase">
        <header class="arcflight-travel-runner-mvp__phase-header">
          <div>
            <span>Phase {{state.roundSegmentState.phaseStep}} of {{state.roundSegmentState.segments.length}}</span>
            <h3>{{state.roundSegmentState.phaseLabel}}</h3>
          </div>
          <div class="arcflight-travel-runner-mvp__actions">
            <button type="button" data-arcflight-runner-previous-phase {{#unless state.roundSegmentState.canRetreatPhase}}disabled{{/unless}}>Previous Segment</button>
            <button type="button" data-arcflight-runner-next-phase {{#unless state.roundSegmentState.canAdvancePhase}}disabled{{/unless}}>Next Segment</button>
          </div>
        </header>
        <p><strong>What happens now?</strong> {{state.roundSegmentState.phaseGuidance}}</p>
        <div class="arcflight-travel-runner-mvp__stats">
          <div><span>Station orders pending</span><strong>{{state.roundSegmentState.stationOrdersPending}}</strong></div>
          <div><span>Station rolls pending</span><strong>{{state.roundSegmentState.stationRollsPending}}</strong></div>
          <div><span>Reaction prompts pending</span><strong>{{state.roundSegmentState.reactionPromptsPending}}</strong></div>
          <div><span>Stabilize resolutions pending</span><strong>{{state.roundSegmentState.stabilizeResolutionsPending}}</strong></div>
          <div><span>Focus effects pending</span><strong>{{state.roundSegmentState.focusEffectsPending}}</strong></div>
        </div>
        {{#if state.roundSegmentState.hasPendingReactions}}<p class="arcflight-travel-builder__warning"><strong>Triggered reactions need attention.</strong> Continue when the table is ready; segment movement is not blocked.</p>{{/if}}
        <ol class="arcflight-travel-runner-mvp__phase-list">
          {{#each state.roundSegmentState.segments}}
            <li class="{{#if active}}arcflight-travel-runner-mvp__phase-step--active{{else}}{{#if complete}}arcflight-travel-runner-mvp__phase-step--complete{{else}}arcflight-travel-runner-mvp__phase-step--pending{{/if}}{{/if}}">
              <button type="button" data-arcflight-runner-set-phase data-round-phase="{{key}}" data-round-phase-label="{{label}}" {{#if active}}aria-current="step" disabled{{/if}}>
                <span>{{step}}. {{label}}</span>
                <small>{{#if active}}Active{{else}}{{#if complete}}Complete{{else}}Pending{{/if}}{{/if}}</small>
              </button>
            </li>
          {{/each}}
        </ol>
      </section>

      {{#if state.hasStations}}
        <div class="arcflight-travel-runner-mvp__stations">
          {{#each state.stations}}
            <article class="arcflight-travel-runner-mvp__station-card">
              <header>
                <h3>{{stationName}}</h3>
                <span>{{resultLabel}}</span>
              </header>
              <p>{{prompt}}</p>
              {{#if problem}}<p class="arcflight-sheet__hint"><strong>Station Card Problem:</strong> {{problem}}</p>{{/if}}
              {{#if stationOrderCommitted}}<p class="arcflight-sheet__hint"><strong>Player Committed:</strong> {{selectedActionLabel}}{{#if selectedFocusAbility}} — Station Focus: {{selectedFocusAbility}}{{/if}}</p>{{/if}}
              <p class="arcflight-sheet__hint"><strong>Focus Remaining:</strong> {{focusRemaining}} / {{focusCapacity}}</p>
              {{#if isStabilize}}
                <p class="arcflight-sheet__hint"><strong>Stabilize Target:</strong> {{stabilizePressureLabel}}</p>
                {{#if result}}
                  <p class="arcflight-sheet__hint"><strong>Pending Outcome & Pressure:</strong>
                    {{#if pendingStabilizeReduction}}Reduce {{stabilizePressureLabel}} by {{pendingStabilizeReduction}}.{{else}}No pressure reduction.{{/if}}
                    {{#if hasStabilizeComplication}} Add 1 {{stabilizePressureLabel}} pressure complication.{{/if}}
                  </p>
                {{/if}}
              {{/if}}
              {{#if stationOptions.length}}
                <div class="arcflight-sheet__hint">
                  <label>
                    <strong>How do you handle this station?</strong>
                    <select data-arcflight-runner-approach-select data-round-index="{{../../state.session.currentRoundIndex}}" data-station-key="{{stationKey}}" {{#if ../../state.isCompleted}}disabled{{/if}}>
                      {{#each stationOptions}}
                        <option value="{{optionKey}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                      {{/each}}
                    </select>
                  </label>
                  <p><strong>Selected Option:</strong> {{selectedStationOptionLabel}}</p>
                  <p><strong>Station Order:</strong> {{selectedActionLabel}}</p>
                  {{#if selectedApproach.helpText}}<p><strong>How This Helps:</strong> {{selectedApproach.helpText}}</p>{{/if}}
                  {{#if qualityWarnings.length}}<p class="arcflight-travel-builder__warning"><strong>Quality Warning:</strong> {{#each qualityWarnings}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</p>{{/if}}
                </div>
              {{/if}}

              {{#if vignette}}<p class="arcflight-sheet__hint"><strong>Legacy Vignette:</strong> {{vignette}}</p>{{/if}}
              <p class="arcflight-sheet__hint"><strong>Assigned:</strong> {{assignedActorName}} <strong>Source:</strong> {{assignmentSourceLabel}}</p>
              {{#if suggestedSkillsLabel}}<p><strong>Suggested Skills:</strong> {{suggestedSkillsLabel}}</p>{{/if}}
              <p class="arcflight-sheet__hint"><strong>Statistic:</strong> {{statisticLabel}} <strong>Selected Skill:</strong> {{selectedSkillLabel}}</p>
              <div class="arcflight-travel-runner-mvp__result-buttons">
                {{#each resultOptions}}
                  <button type="button" data-arcflight-runner-result data-round-index="{{../../state.session.currentRoundIndex}}" data-station-key="{{../stationKey}}" data-result="{{value}}" {{#if ../../state.isCompleted}}disabled{{/if}} class="{{#if selected}}arcflight-travel-runner-mvp__result-button--selected{{/if}}">{{label}}</button>
                {{/each}}
              </div>
              {{#if rollDetailText}}<p class="arcflight-sheet__hint"><strong>Roll Detail:</strong> {{rollDetailText}}</p>{{/if}}
              {{#if hasResultFeedback}}<p class="arcflight-sheet__hint"><strong>Station Vignette:</strong> {{resultFeedback}}</p>{{/if}}
            </article>
          {{/each}}
        </div>
        {{#if state.reactionPromptReview.hasRecords}}
          <section class="arcflight-travel-runner-mvp__panel">
            <details>
            <summary><strong>Reaction History</strong> — {{state.reactionPromptReview.pendingCount}} pending</summary>
            <p class="arcflight-sheet__hint">Players receive eligible reactions automatically. These controls remain as GM fallback/history; backlash still requires explicit confirmation.</p>
            {{#each state.reactionPromptReview.records}}
              <article>
                <h3>{{promptTitle}}</h3>
                <p>{{promptText}}</p>
                <p><strong>{{choiceText}}</strong></p>
                <p><strong>Effect:</strong> {{effectText}}</p>
                <p><strong>Status:</strong> {{statusLabel}}{{#if rerollRequested}} — Reroll requested. Record the new Navigator result below.{{/if}}</p>
                {{#if hasRerollResult}}<p><strong>Reroll:</strong> {{rerollResultLabel}} · <strong>Backlash:</strong> {{backlashStatusLabel}}</p>{{/if}}
                <label>Resolution note
                  <input type="text" maxlength="500" value="{{resolutionNote}}" data-arcflight-reaction-note data-reaction-prompt-id="{{reactionPromptId}}" {{#if ../../state.isCompleted}}disabled{{/if}}>
                </label>
                {{#if isPending}}<div class="arcflight-travel-runner-mvp__result-buttons">
                  <button type="button" data-arcflight-reaction-accept data-reaction-prompt-id="{{reactionPromptId}}">Spend Focus: Hard Correction</button>
                  <button type="button" data-arcflight-reaction-dismiss data-reaction-prompt-id="{{reactionPromptId}}">Ignore</button>
                </div>{{/if}}
                {{#if isAccepted}}<div class="arcflight-travel-runner-mvp__result-buttons">
                  <strong>Record Reroll Result:</strong>
                  <button type="button" data-arcflight-reaction-reroll-result data-reaction-prompt-id="{{reactionPromptId}}" data-result="criticalFailure">Critical Failure</button>
                  <button type="button" data-arcflight-reaction-reroll-result data-reaction-prompt-id="{{reactionPromptId}}" data-result="failure">Failure</button>
                  <button type="button" data-arcflight-reaction-reroll-result data-reaction-prompt-id="{{reactionPromptId}}" data-result="success">Success</button>
                  <button type="button" data-arcflight-reaction-reroll-result data-reaction-prompt-id="{{reactionPromptId}}" data-result="criticalSuccess">Critical Success</button>
                </div>{{/if}}
                {{#if backlashPending}}<div class="arcflight-travel-runner-mvp__result-buttons">
                  <p><strong>Hard Correction backlash pending: +{{consequenceAmount}} {{consequencePressureLabel}}.</strong></p>
                  <button type="button" data-arcflight-reaction-backlash-apply data-reaction-prompt-id="{{reactionPromptId}}">Apply Backlash (+1 Strain)</button>
                  <button type="button" data-arcflight-reaction-backlash-dismiss data-reaction-prompt-id="{{reactionPromptId}}">Dismiss Backlash</button>
                </div>{{/if}}
              </article>
            {{/each}}
            </details>
          </section>
        {{/if}}
        {{#if state.stabilizeResolutionReview.hasRecords}}
          <section class="arcflight-travel-runner-mvp__panel">
            <h2>Stabilize Pressure Resolution</h2>
            <p class="arcflight-sheet__hint">Apply or dismiss each result explicitly. Stabilize results do not add round progress.</p>
            {{#each state.stabilizeResolutionReview.records}}
              <article>
                <h3>{{stationName}}{{#if assignedActorName}} — {{assignedActorName}}{{/if}}</h3>
                <p><strong>Result:</strong> {{resultLabel}} · <strong>Pressure target:</strong> {{pressureLabel}}</p>
                <p><strong>Pending effect:</strong> {{pendingEffectText}}</p>
                <p><strong>Status:</strong> {{statusLabel}}</p>
                <label>Resolution note
                  <input type="text" maxlength="500" value="{{resolutionNote}}" data-arcflight-stabilize-resolution-note data-stabilize-resolution-id="{{stabilizeResolutionId}}" {{#if ../../state.isCompleted}}disabled{{/if}}>
                </label>
                {{#if isPending}}
                  <div class="arcflight-travel-runner-mvp__result-buttons">
                    <button type="button" data-arcflight-stabilize-resolution-apply data-stabilize-resolution-id="{{stabilizeResolutionId}}" {{#if ../../state.isCompleted}}disabled{{/if}}>Apply Pressure</button>
                    <button type="button" data-arcflight-stabilize-resolution-dismiss data-stabilize-resolution-id="{{stabilizeResolutionId}}" {{#if ../../state.isCompleted}}disabled{{/if}}>Dismiss</button>
                  </div>
                {{/if}}
              </article>
            {{/each}}
          </section>
        {{/if}}
        {{#if state.focusEffectReview.hasRecords}}
          <section class="arcflight-travel-runner-mvp__panel">
            <h2>Station Focus Effects</h2>
            <p class="arcflight-sheet__hint">Review-only history. Applying or dismissing a record does not refund Focus or automate its described mechanics.</p>
            {{#each state.focusEffectReview.records}}
              <article>
                <h3>{{stationName}}{{#if assignedActorName}} — {{assignedActorName}}{{/if}}</h3>
                <p><strong>{{abilityLabel}}</strong> · {{selectedActionLabel}} · Round {{roundIndex}}</p>
                <p><strong>Timing:</strong> {{timing}}</p>
                <p>{{effectText}}</p>
                <p><strong>Status:</strong> {{statusLabel}}</p>
                <label>Resolution note
                  <input type="text" maxlength="500" value="{{resolutionNote}}" data-arcflight-focus-effect-note data-focus-effect-id="{{focusEffectId}}" {{#if ../../state.isCompleted}}disabled{{/if}}>
                </label>
                {{#if isPending}}
                  <div class="arcflight-travel-runner-mvp__result-buttons">
                    <button type="button" data-arcflight-focus-effect-apply data-focus-effect-id="{{focusEffectId}}" {{#if ../../state.isCompleted}}disabled{{/if}}>Mark Applied</button>
                    <button type="button" data-arcflight-focus-effect-dismiss data-focus-effect-id="{{focusEffectId}}" {{#if ../../state.isCompleted}}disabled{{/if}}>Dismiss</button>
                  </div>
                {{/if}}
              </article>
            {{/each}}
          </section>
        {{/if}}
        {{#if state.roundSummaryCard.hasResolvedStations}}
          <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__round-summary">
            <h2>GM Round Summary</h2>
            <p class="arcflight-sheet__hint">Read-only MVP preview built from selected station results.</p>
            <p><strong>{{state.roundSummaryCard.roundOutcomeLabel}}</strong> (weighted score {{state.roundSummaryCard.roundScore}})</p>
            <section class="arcflight-travel-runner-mvp__round-summary-section">
              <h3>Cinematic Summary</h3>
              <p>{{state.roundSummaryCard.cinematicSummaryText}}</p>
            </section>
            <section class="arcflight-travel-runner-mvp__round-summary-section">
              <h3>Unresolved Stations</h3>
              {{#if state.roundSummaryCard.unresolvedStationText}}<p class="arcflight-sheet__hint">{{state.roundSummaryCard.unresolvedStationText}}</p>{{else}}<p class="arcflight-sheet__hint">All active stations have a recorded result.</p>{{/if}}
            </section>
            <section class="arcflight-travel-runner-mvp__round-summary-section">
              <h3>GM-Only Complications</h3>
              {{#if state.roundSummaryCard.gmOnlyComplicationText}}<p class="arcflight-travel-builder__warning">{{state.roundSummaryCard.gmOnlyComplicationText}}</p>{{else}}<p class="arcflight-sheet__hint">No GM-only complications are currently recorded.</p>{{/if}}
            </section>
            <details>
              <summary>Roll Details</summary>
              {{#each state.roundSummaryCard.summaryLines}}
                <p>{{this}}</p>
              {{/each}}
            </details>
          </section>
        {{/if}}
      {{else}}
        <p class="arcflight-sheet__hint">This round has no active station prompts.</p>
      {{/if}}

      <footer class="arcflight-travel-runner-mvp__actions">
        <button type="button" data-arcflight-runner-previous {{#unless state.canRetreat}}disabled{{/unless}}>Previous Round</button>
        <button type="button" data-arcflight-runner-next {{#unless state.canAdvance}}disabled{{/unless}}>Next Round</button>
        <button type="button" data-arcflight-runner-complete {{#unless state.canComplete}}disabled{{/unless}}>Complete Event</button>
      </footer>
    </section>

    {{#if state.summary}}
      <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__summary">
        <h2>Final Summary</h2>
        <div class="arcflight-travel-runner-mvp__stats">
          <div><span>Total Score</span><strong>{{state.summary.totalScore}}</strong></div>
          <div><span>Suggested Outcome</span><strong>{{state.summary.suggestedFinalOutcomeLabel}}</strong></div>
        </div>
        {{#if state.summary.finalOutcomeText}}<p>{{state.summary.finalOutcomeText}}</p>{{/if}}

        <h3>Station Results by Round</h3>
        {{#each state.summary.rounds}}
          <article class="arcflight-travel-runner-mvp__summary-round">
            <h4>Round {{roundNumber}}: {{title}}</h4>
            <dl>
              {{#each stationResults}}
                <dt>{{@key}}</dt><dd>{{this}}</dd>
              {{/each}}
            </dl>
          </article>
        {{/each}}

        <h3>Staged Proposed Effects (Read-only)</h3>
        {{#if state.summary.stagedProposedEffects.length}}
          <div class="arcflight-travel-runner-mvp__effects">
            {{#each state.summary.stagedProposedEffectRows}}
              <pre>{{json}}</pre>
            {{/each}}
          </div>
        {{else}}
          <p class="arcflight-sheet__hint">No proposed effects are attached to the suggested final outcome.</p>
        {{/if}}

        <textarea readonly class="arcflight-travel-runner-mvp__json">{{state.summaryJson}}</textarea>
      </section>
    {{/if}}



    {{#if state.effectApplication.available}}
      <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__effect-application">
        <h2>Manual Apply Proposed Effects</h2>
        {{#if state.effectApplication.hasTarget}}
          <p class="arcflight-sheet__hint"><strong>Target Ship:</strong> {{state.effectApplication.targetActorName}}</p>
        {{else}}
          <p class="arcflight-sheet__hint"><strong>Warning:</strong> {{state.effectApplication.noTargetReason}}</p>
        {{/if}}
        <div class="arcflight-travel-runner-mvp__actions">
          <button type="button" data-arcflight-runner-refresh-application>Refresh Application Preview</button>
          <button type="button" data-arcflight-runner-apply-effects {{#unless state.effectApplication.canApply}}disabled{{/unless}}>Apply Selected Effects</button>
        </div>
        {{#if state.effectApplication.rows.length}}
          <div class="arcflight-travel-runner-mvp__effects">
            {{#each state.effectApplication.rows}}
              <article class="arcflight-travel-runner-mvp__effect-row">
                <h3>{{#if selectable}}<input type="checkbox" data-arcflight-runner-apply-effect value="{{index}}" checked>{{else}}<input type="checkbox" disabled>{{/if}} {{displayIndex}}. {{label}}</h3>
                <dl>
                  <dt>Type</dt><dd>{{type}}</dd>
                  <dt>Status</dt><dd>{{status}}</dd>
                  <dt>Resource</dt><dd>{{resource}}</dd>
                  <dt>Mode</dt><dd>{{mode}}</dd>
                  <dt>Value</dt><dd>{{value}}</dd>
                  <dt>Current Value</dt><dd>{{currentValue}}</dd>
                  <dt>Preview Value</dt><dd>{{previewValue}}</dd>
                </dl>
                {{#if warnings.length}}<p class="arcflight-sheet__hint"><strong>Warnings:</strong> {{warnings}}</p>{{/if}}
              </article>
            {{/each}}
          </div>
        {{else}}
          <p class="arcflight-sheet__hint">No proposed effects are attached to the final outcome.</p>
        {{/if}}

        <h3>Applied Effects History</h3>
        {{#if state.effectApplication.records.length}}
          <div class="arcflight-travel-runner-mvp__effects">
            {{#each state.effectApplication.records}}
              <article class="arcflight-travel-runner-mvp__effect-row">
                <strong>{{effectLabel}}</strong>
                <dl>
                  <dt>Resource</dt><dd>{{resource}}</dd>
                  <dt>Mode</dt><dd>{{mode}}</dd>
                  <dt>Value</dt><dd>{{value}}</dd>
                  <dt>Actor</dt><dd>{{actorName}}</dd>
                  <dt>Before</dt><dd>{{beforeValue}}</dd>
                  <dt>After</dt><dd>{{afterValue}}</dd>
                  <dt>Applied At</dt><dd>{{appliedAt}}</dd>
                  <dt>Status</dt><dd>{{status}}</dd>
                  {{#if currentValue}}<dt>Current Value</dt><dd>{{currentValue}}</dd>{{/if}}
                </dl>
                {{#if undoable}}
                  <button type="button" data-arcflight-runner-undo-effect data-application-id="{{applicationId}}">Undo Applied Effect</button>
                {{else}}
                  {{#if undone}}<p class="arcflight-sheet__hint"><strong>Undone:</strong> {{undoneAt}}</p>{{/if}}
                  {{#if undoWarning}}<p class="arcflight-sheet__hint"><strong>Undo Warning:</strong> {{undoWarning}}</p>{{/if}}
                {{/if}}
              </article>
            {{/each}}
          </div>
        {{else}}
          <p class="arcflight-sheet__hint">No effects from this runner session have been applied yet.</p>
        {{/if}}
      </section>
    {{/if}}


    <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__staged-review">
      <h2>Staged Consequence Review</h2>
      {{#if state.stagedEffectReview.available}}
        <p class="arcflight-sheet__hint"><strong>{{state.stagedEffectReview.review.notAppliedWarning}}</strong></p>
        <div class="arcflight-travel-runner-mvp__stats">
          <div><span>Event</span><strong>{{state.stagedEffectReview.review.eventName}}</strong></div>
          <div><span>Final Outcome</span><strong>{{state.stagedEffectReview.review.finalOutcomeLabel}}</strong></div>
          <div><span>Effects</span><strong>{{state.stagedEffectReview.review.effectCount}}</strong></div>
          <div><span>Supported</span><strong>{{state.stagedEffectReview.review.supportedEffectCount}}</strong></div>
          <div><span>Unsupported</span><strong>{{state.stagedEffectReview.review.unsupportedEffectCount}}</strong></div>
        </div>
        <div class="arcflight-travel-runner-mvp__actions">
          <button type="button" data-arcflight-runner-refresh-review>Refresh Review</button>
          <button type="button" data-arcflight-runner-copy-review-markdown>Copy Review Markdown</button>
          <button type="button" data-arcflight-runner-copy-review-html>Copy Review HTML</button>
        </div>
        {{#if state.stagedEffectReview.review.rows.length}}
          <div class="arcflight-travel-runner-mvp__effects">
            {{#each state.stagedEffectReview.review.rows}}
              <article class="arcflight-travel-runner-mvp__effect-row">
                <h3>{{displayIndex}}. {{label}}</h3>
                <dl>
                  <dt>Type</dt><dd>{{type}}</dd>
                  <dt>Status</dt><dd>{{status}}</dd>
                  <dt>Resource</dt><dd>{{resource}}</dd>
                  <dt>Mode</dt><dd>{{mode}}</dd>
                  <dt>Value</dt><dd>{{value}}</dd>
                  <dt>Current Value</dt><dd>{{currentValue}}</dd>
                  <dt>Preview Value</dt><dd>{{previewValue}}</dd>
                </dl>
                {{#if warnings.length}}<p class="arcflight-sheet__hint"><strong>Warnings:</strong> {{warnings}}</p>{{/if}}
                <pre>{{rawJson}}</pre>
              </article>
            {{/each}}
          </div>
        {{else}}
          <p class="arcflight-sheet__hint">No proposed effects are attached to the final outcome.</p>
        {{/if}}
      {{else}}
        <p class="arcflight-sheet__hint">{{state.stagedEffectReview.reason}}</p>
        <div class="arcflight-travel-runner-mvp__actions">
          <button type="button" data-arcflight-runner-refresh-review>Refresh Review</button>
          <button type="button" data-arcflight-runner-copy-review-markdown disabled>Copy Review Markdown</button>
          <button type="button" data-arcflight-runner-copy-review-html disabled>Copy Review HTML</button>
        </div>
      {{/if}}
    </section>

    <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__summary-output">
      <h2>Completed Summary Output</h2>
      {{#if state.summaryOutput.available}}
        <p class="arcflight-sheet__hint"><strong>Read-only:</strong> {{state.summaryOutput.report.proposedEffectsNotice}}</p>
        <div class="arcflight-travel-runner-mvp__actions">
          <button type="button" data-arcflight-runner-copy-markdown>Copy Markdown Summary</button>
          <button type="button" data-arcflight-runner-copy-html>Copy HTML Summary</button>
          <button type="button" data-arcflight-runner-post-chat>Post Summary to Chat</button>
          <button type="button" data-arcflight-runner-create-journal>Create Journal Entry</button>
          <button type="button" data-arcflight-runner-refresh-summary>Refresh Summary</button>
        </div>
        <label class="arcflight-sheet__field">
          <span>Markdown Summary Output</span>
          <textarea readonly class="arcflight-travel-runner-mvp__json">{{state.summaryOutput.markdown}}</textarea>
        </label>
      {{else}}
        <p class="arcflight-sheet__hint">{{state.summaryOutput.reason}}</p>
        <div class="arcflight-travel-runner-mvp__actions">
          <button type="button" data-arcflight-runner-copy-markdown disabled>Copy Markdown Summary</button>
          <button type="button" data-arcflight-runner-copy-html disabled>Copy HTML Summary</button>
          <button type="button" data-arcflight-runner-post-chat disabled>Post Summary to Chat</button>
          <button type="button" data-arcflight-runner-create-journal disabled>Create Journal Entry</button>
          <button type="button" data-arcflight-runner-refresh-summary>Refresh Summary</button>
        </div>
      {{/if}}
    </section>
  {{/if}}

  <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__session-library">
    <details>
      <summary><strong>Runner Session Library</strong></summary>
    <p class="arcflight-sheet__hint">World-local manual save/resume snapshots. Saved runner sessions are separate from drafts and published events, and never mutate actors, resources, chat, combat, or proposed effects.</p>
    <div class="arcflight-travel-runner-mvp__actions">
      <button type="button" data-arcflight-runner-refresh-sessions>Refresh Sessions</button>
    </div>

    {{#if state.hasSavedSessions}}
      <label class="arcflight-sheet__field">
        <span>Saved Session</span>
        <select data-arcflight-runner-session-select>
          <option value="">Select a saved session…</option>
          {{#each state.sessionLibrary.entries}}
            <option value="{{key}}" {{#if selected}}selected{{/if}} {{#unless canLoad}}disabled{{/unless}}>{{name}} — {{statusLabel}}{{#if missingPublishedEvent}} (missing published event){{/if}}{{#if isMalformed}} (malformed){{/if}}</option>
          {{/each}}
        </select>
      </label>

      <div class="arcflight-travel-runner-mvp__sessions">
        {{#each state.sessionLibrary.entries}}
          <article class="arcflight-travel-runner-mvp__session-row">
            <header>
              <strong>{{name}}</strong>
              <span>{{statusLabel}}</span>
            </header>
            <p>{{eventName}}{{#if eventCategoryLabel}} — {{eventCategoryLabel}}{{/if}}</p>
            <p class="arcflight-sheet__hint">Round {{currentRoundNumber}} • Updated {{updatedAtLabel}}</p>
            {{#if missingPublishedEvent}}<p class="arcflight-sheet__hint"><strong>Warning:</strong> The source published event is not currently available. Loading uses the saved snapshot only.</p>{{/if}}
            {{#if validationErrors.length}}<p class="arcflight-sheet__hint"><strong>Malformed:</strong> {{validationErrors}}</p>{{/if}}
            <div class="arcflight-travel-runner-mvp__actions">
              <button type="button" data-arcflight-runner-load-session="{{key}}" {{#unless canLoad}}disabled{{/unless}}>Load Session</button>
              <button type="button" data-arcflight-runner-duplicate-session="{{key}}" {{#unless canDuplicate}}disabled{{/unless}}>Duplicate Session</button>
              <button type="button" data-arcflight-runner-delete-session="{{key}}" data-session-name="{{name}}" {{#unless canDelete}}disabled{{/unless}}>Delete Session</button>
            </div>
          </article>
        {{/each}}
      </div>
    {{else}}
      <p class="arcflight-sheet__hint">No runner sessions have been saved yet. Start or load a published event, record manual results, then choose Save Current Session.</p>
      <div class="arcflight-travel-runner-mvp__actions">
        <button type="button" data-arcflight-runner-load-session disabled>Load Session</button>
        <button type="button" data-arcflight-runner-duplicate-session disabled>Duplicate Session</button>
        <button type="button" data-arcflight-runner-delete-session disabled>Delete Session</button>
      </div>
    {{/if}}
    </details>
  </section>
  {{/unless}}
</div>
