          {{#if state.travelV2PreviewPanel.travelV2EventCompletionReadiness.hasFeedback}}<p class="arcflight-travel-runner-mvp__v2-preview-feedback">{{state.travelV2PreviewPanel.travelV2EventCompletionReadiness.feedbackText}}</p>{{/if}}
        </div>
        <div class="arcflight-travel-runner-mvp__v2-outcome-package" aria-label="Travel v2 event outcome package">
