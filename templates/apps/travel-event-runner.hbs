          <div><span>Focus effects pending</span><strong>{{state.roundSegmentState.focusEffectsPending}}</strong></div>
        </div>
        {{#if state.roundSegmentState.hasPendingReactions}}<p class="arcflight-travel-builder__warning"><strong>Triggered reactions need attention.</strong> Continue when the table is ready; segment movement is not blocked.</p>{{/if}}
        <ol class="arcflight-travel-runner-mvp__phase-list">
          {{#each state.roundSegmentState.segments}}
            <li class="{{#if active}}arcflight-travel-runner-mvp__phase-step--active{{else}}{{#if complete}}arcflight-travel-runner-mvp__phase-step--complete{{else}}arcflight-travel-runner-mvp__phase-step--pending{{/if}}{{/if}}">
              <button type="button" data-arcflight-runner-set-phase data-round-phase="{{key}}" data-round-phase-label="{{label}}" {{#if active}}aria-current="step" disabled{{/if}}>
                <span>{{step}}. {{label}}</span>
                <small>{{#if active}}Active{{else}}{{#if complete}}Complete{{else}}Pending{{/if}}{{/if}}</small>
              </button>
            </li>
          {{/each}}
        </ol>
      </section>


      {{#if state.focusRiskSummary.hasRows}}
        <section class="arcflight-travel-runner-mvp__panel arcflight-player-safe">
          <h2>Focus Risk / Suppression</h2>
          <p class="arcflight-sheet__hint">{{state.focusRiskSummary.mutationNote}}</p>
          {{#if state.focusRiskSummary.hasBlockedRows}}<p class="arcflight-travel-builder__warning"><strong>Blocked Focus stations:</strong> {{#each state.focusRiskSummary.blockedRows}}{{stationName}}{{#if blockedHazardName}} ({{blockedHazardName}}){{/if}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
        </section>
      {{/if}}

      {{#if state.hasStations}}
        <div class="arcflight-travel-runner-mvp__stations">
          {{#each state.stations}}
            <article class="arcflight-travel-runner-mvp__station-card">
              <header>
                <h3>{{stationName}}</h3>
                <span>{{resultLabel}}</span>
              </header>
              <p>{{prompt}}</p>
              {{#if problem}}<p class="arcflight-sheet__hint"><strong>Station Card Problem:</strong> {{problem}}</p>{{/if}}
              {{#if stationOrderCommitted}}<p class="arcflight-sheet__hint"><strong>Player Committed:</strong> {{selectedActionLabel}}{{#if selectedFocusAbility}} — Station Focus: {{selectedFocusAbility}}{{/if}}</p>{{/if}}
              <p class="arcflight-sheet__hint"><strong>Focus Remaining:</strong> {{focusRemaining}} / {{focusCapacity}}</p>
              {{#if focusSuppressedByHazard}}<p class="arcflight-travel-builder__warning"><strong>Focus unavailable:</strong> {{#if focusSuppression.hazardName}}{{focusSuppression.hazardName}} — {{/if}}{{focusSuppression.publicReasonText}}</p>{{/if}}
              {{#if focusOptions.length}}<details class="arcflight-sheet__hint"><summary>Focus risk preview</summary>{{#each focusOptions}}<p><strong>{{label}}:</strong> {{whatItHelps}} {{publicRiskText}} {{publicBacklashPreviewText}}</p>{{/each}}</details>{{/if}}
              {{#if isStabilize}}
                <p class="arcflight-sheet__hint"><strong>Stabilize Target:</strong> {{stabilizePressureLabel}}</p>
                {{#if result}}
                  <p class="arcflight-sheet__hint"><strong>Pending Outcome & Pressure:</strong>
                    {{#if pendingStabilizeReduction}}Reduce {{stabilizePressureLabel}} by {{pendingStabilizeReduction}}.{{else}}No pressure reduction.{{/if}}
                    {{#if hasStabilizeComplication}} Add 1 {{stabilizePressureLabel}} pressure complication.{{/if}}
                  </p>
                {{/if}}
              {{/if}}
              {{#if stationOptions.length}}
                <div class="arcflight-sheet__hint">
                  <label>
                    <strong>How do you handle this station?</strong>
                    <select data-arcflight-runner-approach-select data-round-index="{{../../state.session.currentRoundIndex}}" data-station-key="{{stationKey}}" {{#if ../../state.isCompleted}}disabled{{/if}}>
                      {{#each stationOptions}}
                        <option value="{{optionKey}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                      {{/each}}
                    </select>
                  </label>
                  <p><strong>Selected Option:</strong> {{selectedStationOptionLabel}}</p>
                  <p><strong>Station Order:</strong> {{selectedActionLabel}}{{#if isSupport}}{{#if supportTargetStationName}} → {{supportTargetStationName}}{{/if}}{{/if}}</p>
                  {{#if isSupport}}
                    <label>
                      <strong>Support Target:</strong>
                      <select data-arcflight-runner-support-target-select data-round-index="{{../../state.session.currentRoundIndex}}" data-station-key="{{stationKey}}" {{#if ../../state.isCompleted}}disabled{{/if}}>
                        <option value="">Choose target…</option>
                        {{#each supportTargetOptions}}<option value="{{stationKey}}" {{#if selected}}selected{{/if}}>{{stationName}}</option>{{/each}}
                      </select>
                    </label>
                  {{/if}}
                  {{#if selectedApproach.helpText}}<p><strong>How This Helps:</strong> {{selectedApproach.helpText}}</p>{{/if}}
                  {{#if qualityWarnings.length}}<p class="arcflight-travel-builder__warning"><strong>Quality Warning:</strong> {{#each qualityWarnings}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</p>{{/if}}
                </div>
              {{/if}}

              {{#if vignette}}<p class="arcflight-sheet__hint"><strong>Legacy Vignette:</strong> {{vignette}}</p>{{/if}}
              <p class="arcflight-sheet__hint"><strong>Assigned:</strong> {{assignedActorName}} <strong>Source:</strong> {{assignmentSourceLabel}}</p>
              {{#if suggestedSkillsLabel}}<p><strong>Suggested Skills:</strong> {{suggestedSkillsLabel}}</p>{{/if}}
              <p class="arcflight-sheet__hint"><strong>Statistic:</strong> {{statisticLabel}} <strong>Selected Skill:</strong> {{selectedSkillLabel}}</p>
              <div class="arcflight-travel-runner-mvp__result-buttons">
                {{#each resultOptions}}
                  <button type="button" data-arcflight-runner-result data-round-index="{{../../state.session.currentRoundIndex}}" data-station-key="{{../stationKey}}" data-result="{{value}}" {{#if ../../state.isCompleted}}disabled{{/if}} class="{{#if selected}}arcflight-travel-runner-mvp__result-button--selected{{/if}}">{{label}}</button>
                {{/each}}
              </div>
              {{#if rollDetailText}}<p class="arcflight-sheet__hint"><strong>Roll Detail:</strong> {{rollDetailText}}</p>{{/if}}
              {{#if hasResultFeedback}}<p class="arcflight-sheet__hint"><strong>Station Vignette:</strong> {{resultFeedback}}</p>{{/if}}
            </article>
          {{/each}}
        </div>
        {{#if state.reactionPromptReview.hasRecords}}
          <section class="arcflight-travel-runner-mvp__panel">
            <details>
            <summary><strong>Reaction History</strong> — {{state.reactionPromptReview.pendingCount}} pending</summary>
            <p class="arcflight-sheet__hint">Players receive eligible reactions automatically. These controls remain as GM fallback/history; backlash still requires explicit confirmation.</p>
            {{#each state.reactionPromptReview.records}}
              <article>
                <h3>{{promptTitle}}</h3>
                <p>{{promptText}}</p>
                <p><strong>{{choiceText}}</strong></p>
                <p><strong>Effect:</strong> {{effectText}}</p>
                <p><strong>Status:</strong> {{statusLabel}}{{#if rerollRequested}} — Reroll requested. Record the new Navigator result below.{{/if}}</p>
                {{#if hasRerollResult}}<p><strong>Reroll:</strong> {{rerollResultLabel}} · <strong>Backlash:</strong> {{backlashStatusLabel}}</p>{{/if}}
                <label>Resolution note
                  <input type="text" maxlength="500" value="{{resolutionNote}}" data-arcflight-reaction-note data-reaction-prompt-id="{{reactionPromptId}}" {{#if ../../state.isCompleted}}disabled{{/if}}>
                </label>
                {{#if isPending}}<div class="arcflight-travel-runner-mvp__result-buttons">
                  <button type="button" data-arcflight-reaction-accept data-reaction-prompt-id="{{reactionPromptId}}">Spend Focus: Hard Correction</button>
                  <button type="button" data-arcflight-reaction-dismiss data-reaction-prompt-id="{{reactionPromptId}}">Ignore</button>
                </div>{{/if}}
                {{#if isAccepted}}<div class="arcflight-travel-runner-mvp__result-buttons">
                  <strong>Record Reroll Result:</strong>
                  <button type="button" data-arcflight-reaction-reroll-result data-reaction-prompt-id="{{reactionPromptId}}" data-result="criticalFailure">Critical Failure</button>
                  <button type="button" data-arcflight-reaction-reroll-result data-reaction-prompt-id="{{reactionPromptId}}" data-result="failure">Failure</button>
                  <button type="button" data-arcflight-reaction-reroll-result data-reaction-prompt-id="{{reactionPromptId}}" data-result="success">Success</button>
                  <button type="button" data-arcflight-reaction-reroll-result data-reaction-prompt-id="{{reactionPromptId}}" data-result="criticalSuccess">Critical Success</button>
                </div>{{/if}}
                {{#if backlashPending}}<div class="arcflight-travel-runner-mvp__result-buttons">
                  <p><strong>Hard Correction backlash pending: +{{consequenceAmount}} {{consequencePressureLabel}}.</strong></p>
                  <button type="button" data-arcflight-reaction-backlash-apply data-reaction-prompt-id="{{reactionPromptId}}">Apply Backlash (+1 Strain)</button>
                  <button type="button" data-arcflight-reaction-backlash-dismiss data-reaction-prompt-id="{{reactionPromptId}}">Dismiss Backlash</button>
                </div>{{/if}}
              </article>
            {{/each}}
            </details>
          </section>
        {{/if}}

        {{#if state.supportAssistReview.hasRecords}}
          <section class="arcflight-travel-runner-mvp__panel">
            <h2>Support Assists</h2>
            <p class="arcflight-sheet__hint">Session-local assist, not automatic roll mutation. Use marks the assist used; Dismiss closes it. Neither action mutates actors, items, chat, journals, combat, sockets, scenes, tokens, pressure, or station results.</p>
            {{#each state.supportAssistReview.records}}
              <article>
                <h3>{{supportingStationName}} → {{targetStationName}}</h3>
                <p><strong>Assist:</strong> +{{assistValue}} · <strong>Status:</strong> {{statusLabel}}</p>
                {{#if publicSummary}}<p><strong>Public summary:</strong> {{publicSummary}}</p>{{/if}}
                {{#if publicAssistText}}<p><strong>Public assist:</strong> {{publicAssistText}}</p>{{/if}}
                {{#if gmNote}}<p class="arcflight-sheet__hint"><strong>GM note:</strong> {{gmNote}}</p>{{/if}}
                {{#if resolutionNote}}<p class="arcflight-sheet__hint"><strong>Resolution:</strong> {{resolutionNote}}</p>{{/if}}
                {{#if isPending}}
                  <div class="arcflight-travel-runner-mvp__result-buttons">
                    <button type="button" data-arcflight-support-assist-use data-support-assist-id="{{id}}" {{#if ../../state.isCompleted}}disabled{{/if}}>Use</button>
                    <button type="button" data-arcflight-support-assist-dismiss data-support-assist-id="{{id}}" {{#if ../../state.isCompleted}}disabled{{/if}}>Dismiss</button>
                  </div>
                {{/if}}
              </article>
            {{/each}}
          </section>
        {{/if}}


        {{#if state.supportBacklashReview.hasRecords}}
          <section class="arcflight-travel-runner-mvp__panel">
            <h2>Support Backlash</h2>
            <p class="arcflight-sheet__hint">GM-controlled failed-Support consequence candidates. Apply/Dismiss marks record status only; it does not automatically mutate actors, items, chat, journals, combat, sockets, scenes, tokens, pressure, damage, conditions, rolls, or station results.</p>
            {{#each state.supportBacklashReview.records}}
              <article>
                <h3>{{supportingStationName}} → {{targetStationName}}</h3>
                <p><strong>Severity:</strong> {{severity}} · <strong>Status:</strong> {{statusLabel}}</p>
                {{#if publicRiskText}}<p><strong>Public risk:</strong> {{publicRiskText}}</p>{{/if}}
                {{#if gmNote}}<p class="arcflight-sheet__hint"><strong>GM note:</strong> {{gmNote}}</p>{{/if}}
                {{#if resolutionNote}}<p class="arcflight-sheet__hint"><strong>Resolution:</strong> {{resolutionNote}}</p>{{/if}}
                {{#if isPending}}
                  <div class="arcflight-travel-runner-mvp__result-buttons">
                    <button type="button" data-arcflight-support-backlash-apply data-support-backlash-id="{{id}}" {{#if ../../state.isCompleted}}disabled{{/if}}>Apply</button>
                    <button type="button" data-arcflight-support-backlash-dismiss data-support-backlash-id="{{id}}" {{#if ../../state.isCompleted}}disabled{{/if}}>Dismiss</button>
                  </div>
                {{/if}}
              </article>
            {{/each}}
          </section>
        {{/if}}

        {{#if state.focusBacklashReview.hasRecords}}
          <section class="arcflight-travel-runner-mvp__panel">
            <h2>Focus Backlash</h2>
            <p class="arcflight-sheet__hint">GM-controlled Focus consequence candidates. Apply/Dismiss requires explicit GM review; no automatic actor, item, chat, journal, combat, socket, scene, or token mutation occurs.</p>
            {{#each state.focusBacklashReview.records}}
              <article>
                <h3>{{stationName}}{{#if actorName}} — {{actorName}}{{/if}}</h3>
                <p><strong>Focus:</strong> {{focusLabel}} · <strong>Status:</strong> {{statusLabel}}</p>
                {{#if publicSummary}}<p><strong>Public summary:</strong> {{publicSummary}}</p>{{/if}}
                {{#if publicRiskText}}<p><strong>Public risk:</strong> {{publicRiskText}}</p>{{/if}}
                {{#if publicBacklashPreviewText}}<p><strong>Public preview:</strong> {{publicBacklashPreviewText}}</p>{{/if}}
                {{#if hasPressure}}<p><strong>Pressure candidate:</strong> +{{pressureDelta}} {{pressureLabel}}</p>{{/if}}
                {{#if hasConsequenceCandidate}}<p><strong>Consequence candidate:</strong> {{consequenceCandidate}}</p>{{/if}}
                {{#if gmNote}}<p class="arcflight-sheet__hint"><strong>GM note:</strong> {{gmNote}}</p>{{/if}}
                {{#if isPending}}
                  <div class="arcflight-travel-runner-mvp__result-buttons">
                    <button type="button" data-arcflight-focus-backlash-apply data-focus-backlash-id="{{id}}" {{#if ../../state.isCompleted}}disabled{{/if}}>Apply</button>
                    <button type="button" data-arcflight-focus-backlash-dismiss data-focus-backlash-id="{{id}}" {{#if ../../state.isCompleted}}disabled{{/if}}>Dismiss</button>
                  </div>
                {{/if}}
              </article>
            {{/each}}
          </section>
        {{/if}}
        {{#if state.stabilizeResolutionReview.hasRecords}}
          <section class="arcflight-travel-runner-mvp__panel">
            <h2>Stabilize Pressure Resolution</h2>
            <p class="arcflight-sheet__hint">Apply or dismiss each result explicitly. Stabilize results do not add round progress.</p>
            {{#each state.stabilizeResolutionReview.records}}
              <article>
                <h3>{{stationName}}{{#if assignedActorName}} — {{assignedActorName}}{{/if}}</h3>
                <p><strong>Result:</strong> {{resultLabel}} · <strong>Pressure target:</strong> {{pressureLabel}}</p>
                <p><strong>Proposed delta:</strong> {{pressureDelta}}</p>
                <p><strong>Pending effect:</strong> {{pendingEffectText}}</p>
                {{#if publicSummary}}<p><strong>Public summary:</strong> {{publicSummary}}</p>{{/if}}
                {{#if gmNote}}<p class="arcflight-sheet__hint"><strong>GM note:</strong> {{gmNote}}</p>{{/if}}
                <p><strong>Status:</strong> {{statusLabel}}</p>
                <label>Resolution note
                  <input type="text" maxlength="500" value="{{resolutionNote}}" data-arcflight-stabilize-resolution-note data-stabilize-resolution-id="{{stabilizeResolutionId}}" {{#if ../../state.isCompleted}}disabled{{/if}}>
                </label>
                {{#if isPending}}
                  <div class="arcflight-travel-runner-mvp__result-buttons">
                    <button type="button" data-arcflight-stabilize-resolution-apply data-stabilize-resolution-id="{{stabilizeResolutionId}}" {{#if ../../state.isCompleted}}disabled{{/if}}>Apply Pressure</button>
                    <button type="button" data-arcflight-stabilize-resolution-dismiss data-stabilize-resolution-id="{{stabilizeResolutionId}}" {{#if ../../state.isCompleted}}disabled{{/if}}>Dismiss</button>
                  </div>
                {{/if}}
              </article>
            {{/each}}
          </section>
        {{/if}}
        {{#if state.focusEffectReview.hasRecords}}
          <section class="arcflight-travel-runner-mvp__panel">
            <h2>Station Focus Effects</h2>
            <p class="arcflight-sheet__hint">Review-only history. Applying or dismissing a record does not refund Focus or automate its described mechanics.</p>
            {{#each state.focusEffectReview.records}}
              <article>
                <h3>{{stationName}}{{#if assignedActorName}} — {{assignedActorName}}{{/if}}</h3>
                <p><strong>{{abilityLabel}}</strong> · {{selectedActionLabel}} · Round {{roundIndex}}</p>
                <p><strong>Timing:</strong> {{timing}}</p>
                <p>{{effectText}}</p>
                <p><strong>Status:</strong> {{statusLabel}}</p>
                <label>Resolution note
                  <input type="text" maxlength="500" value="{{resolutionNote}}" data-arcflight-focus-effect-note data-focus-effect-id="{{focusEffectId}}" {{#if ../../state.isCompleted}}disabled{{/if}}>
                </label>
                {{#if isPending}}
                  <div class="arcflight-travel-runner-mvp__result-buttons">
                    <button type="button" data-arcflight-focus-effect-apply data-focus-effect-id="{{focusEffectId}}" {{#if ../../state.isCompleted}}disabled{{/if}}>Mark Applied</button>
                    <button type="button" data-arcflight-focus-effect-dismiss data-focus-effect-id="{{focusEffectId}}" {{#if ../../state.isCompleted}}disabled{{/if}}>Dismiss</button>
                  </div>
                {{/if}}
              </article>
            {{/each}}
          </section>
        {{/if}}
        {{#if state.roundSummaryCard.hasResolvedStations}}
          <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__round-summary">
            <h2>GM Round Summary</h2>
            <p class="arcflight-sheet__hint">Read-only MVP preview built from selected station results.</p>
            <p><strong>{{state.roundSummaryCard.roundOutcomeLabel}}</strong> (weighted score {{state.roundSummaryCard.roundScore}})</p>
            <div class="arcflight-travel-runner-mvp__stats">
              <div><span>Main objective contributors</span><strong>{{state.roundSummaryCard.objectiveContributorCount}}</strong></div>
              <div><span>Stabilize / Repair</span><strong>{{state.roundSummaryCard.stabilizerCount}}</strong></div>
              <div><span>Hazard response</span><strong>{{state.roundSummaryCard.hazardResponderCount}}</strong></div>
              <div><span>Supporters</span><strong>{{state.roundSummaryCard.supporterCount}}</strong></div>
              <div><span>Unresolved / pending</span><strong>{{state.roundSummaryCard.unresolvedStationCount}}</strong></div>
            </div>
            <section class="arcflight-travel-runner-mvp__round-summary-section">
              <h3>Cinematic Summary</h3>
              <p>{{state.roundSummaryCard.cinematicSummaryText}}</p>
            </section>
            <section class="arcflight-travel-runner-mvp__round-summary-section">
              <h3>Unresolved Stations</h3>
              {{#if state.roundSummaryCard.unresolvedStationText}}<p class="arcflight-sheet__hint">{{state.roundSummaryCard.unresolvedStationText}}</p>{{else}}<p class="arcflight-sheet__hint">All active stations have a recorded result.</p>{{/if}}
            </section>
            <section class="arcflight-travel-runner-mvp__round-summary-section">
              <h3>GM-Only Complications</h3>
              {{#if state.roundSummaryCard.gmOnlyComplicationText}}<p class="arcflight-travel-builder__warning">{{state.roundSummaryCard.gmOnlyComplicationText}}</p>{{else}}<p class="arcflight-sheet__hint">No GM-only complications are currently recorded.</p>{{/if}}
            </section>
            <details>
              <summary>Roll Details</summary>
              {{#each state.roundSummaryCard.summaryLines}}
                <p>{{this}}</p>
              {{/each}}
            </details>
          </section>
        {{/if}}
      {{else}}
        <p class="arcflight-sheet__hint">This round has no active station prompts.</p>
      {{/if}}

      {{#if state.travelV2Narration}}
        <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__narration">
          <header class="arcflight-travel-runner-mvp__panel-header">
            <h2>Round Narration</h2>
            <button type="button" data-arcflight-travel-v2-narration-refresh>Refresh Round Narration</button>
          </header>
          <p class="arcflight-sheet__hint">Session-local GM aid only. Nothing is posted to chat, journals, actors, items, or combat automatically.</p>
          <h3>Combined Round Summary ({{state.travelV2Narration.completionState}})</h3>
          <p>{{state.travelV2Narration.whatHappened}}</p>
          <h4>Suggested Read-Aloud</h4>
          <p>{{state.travelV2Narration.suggestedReadAloud}}</p>
          <h4>Station Vignettes</h4>
          {{#if state.travelV2Narration.stationVignettes.length}}
            <ul>
              {{#each state.travelV2Narration.stationVignettes}}
                <li><strong>{{stationLabel}}</strong>{{#if actorName}} ({{actorName}}){{/if}} — {{actionLabel}}{{#if selectedOptionLabel}}: {{selectedOptionLabel}}{{/if}} — <em>{{resultLabel}}</em>. {{narrativeText}} <span class="arcflight-sheet__hint">{{mechanicalSummary}}</span></li>
              {{/each}}
            </ul>
          {{else}}
            <p class="arcflight-sheet__hint">No active station vignettes are available for this round.</p>
          {{/if}}
          <h4>Hazard Notes</h4>
          <p><strong>Active:</strong> {{#if state.travelV2Narration.hazardNotes.active.length}}{{#each state.travelV2Narration.hazardNotes.active}}{{name}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}None{{/if}}</p>
          <p><strong>Responded To:</strong> {{#if state.travelV2Narration.hazardNotes.responded.length}}{{#each state.travelV2Narration.hazardNotes.responded}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}None{{/if}}</p>
          <p><strong>Cleared:</strong> {{#if state.travelV2Narration.hazardNotes.cleared.length}}{{#each state.travelV2Narration.hazardNotes.cleared}}{{name}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}None{{/if}}</p>
          <p><strong>Unresolved:</strong> {{#if state.travelV2Narration.hazardNotes.unresolved.length}}{{#each state.travelV2Narration.hazardNotes.unresolved}}{{name}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}None{{/if}}</p>
          {{#if state.travelV2Narration.pressureNotes.length}}<p><strong>Pressure:</strong> {{#each state.travelV2Narration.pressureNotes}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
        </section>
      {{/if}}

      <footer class="arcflight-travel-runner-mvp__actions">
        <button type="button" data-arcflight-runner-previous {{#unless state.canRetreat}}disabled{{/unless}}>Previous Round</button>
        <button type="button" data-arcflight-runner-next {{#unless state.canAdvance}}disabled{{/unless}}>Next Round</button>
        <button type="button" data-arcflight-runner-complete {{#unless state.canComplete}}disabled{{/unless}}>Complete Event</button>
      </footer>
    </section>

    {{#if state.completionChecklist.visible}}
      <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__completion-checklist arcflight-gm-only" data-arcflight-travel-v2-completion-checklist aria-label="GM Completion Checklist">
        <h2>{{state.completionChecklist.title}}</h2>
        <p class="arcflight-sheet__hint"><strong>Status:</strong> {{state.completionChecklist.statusLabel}} · <strong>Event:</strong> {{state.completionChecklist.eventName}} · <strong>Final Outcome:</strong> {{state.completionChecklist.finalOutcomeLabel}}</p>
        <div class="arcflight-travel-runner-mvp__stats">
          <div><span>Completed</span><strong>{{#if state.completionChecklist.isCompleted}}Completed{{else}}Not completed{{/if}}</strong></div>
          <div><span>Completed At</span><strong>{{#if state.completionChecklist.completedAt}}{{state.completionChecklist.completedAt}}{{else}}Not recorded{{/if}}</strong></div>
          <div><span>Target Ship</span><strong>{{#if state.completionChecklist.targetShipName}}{{state.completionChecklist.targetShipName}}{{else}}No target ship resolved{{/if}}</strong></div>
        </div>
        <div class="arcflight-travel-runner-mvp__effects">
          {{#each state.completionChecklist.rows}}
            <article class="arcflight-travel-runner-mvp__effect-row arcflight-travel-runner-mvp__completion-checklist-row arcflight-{{status}}">
              <h3>{{label}} — {{statusLabel}}</h3>
              <p class="arcflight-sheet__hint">{{reason}}</p>
              {{#if targetHeading}}<p class="arcflight-sheet__hint"><strong>Related section:</strong> {{targetHeading}}</p>{{/if}}
            </article>
          {{/each}}
        </div>
        <p class="arcflight-travel-builder__warning"><strong>Safety:</strong> {{state.completionChecklist.safetyNote}}</p>
      </section>
    {{/if}}

    {{#if state.summary}}
      <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__summary">
        <h2>Final Summary</h2>
        <div class="arcflight-travel-runner-mvp__stats">
          <div><span>Total Score</span><strong>{{state.summary.totalScore}}</strong></div>
          <div><span>Suggested Outcome</span><strong>{{state.summary.suggestedFinalOutcomeLabel}}</strong></div>
        </div>
        {{#if state.summary.finalOutcomeText}}<p>{{state.summary.finalOutcomeText}}</p>{{/if}}

        <h3>Station Results by Round</h3>
        {{#each state.summary.rounds}}
          <article class="arcflight-travel-runner-mvp__summary-round">
            <h4>Round {{roundNumber}}: {{title}}</h4>
            <dl>
              {{#each stationResults}}
                <dt>{{@key}}</dt><dd>{{this}}</dd>
              {{/each}}
            </dl>
          </article>
        {{/each}}

        <h3>Staged Proposed Effects (Read-only)</h3>
        {{#if state.summary.stagedProposedEffects.length}}
          <div class="arcflight-travel-runner-mvp__effects">
            {{#each state.summary.stagedProposedEffectRows}}
              <pre>{{json}}</pre>
            {{/each}}
          </div>
        {{else}}
          <p class="arcflight-sheet__hint">No proposed effects are attached to the suggested final outcome.</p>
        {{/if}}

        <textarea readonly class="arcflight-travel-runner-mvp__json">{{state.summaryJson}}</textarea>
      </section>
    {{/if}}



    {{#if state.effectApplication.available}}
      <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__effect-application">
        <h2>Manual Apply Proposed Effects</h2>
        {{#if state.effectApplication.hasTarget}}
          <p class="arcflight-sheet__hint"><strong>Target Ship:</strong> {{state.effectApplication.targetActorName}}</p>
        {{else}}
          <p class="arcflight-sheet__hint"><strong>Warning:</strong> {{state.effectApplication.noTargetReason}}</p>
        {{/if}}
        <div class="arcflight-travel-runner-mvp__actions">
          <button type="button" data-arcflight-runner-refresh-application>Refresh Application Preview</button>
          <button type="button" data-arcflight-runner-apply-effects {{#unless state.effectApplication.canApply}}disabled{{/unless}}>Apply Selected Effects</button>
        </div>
        {{#if state.effectApplication.rows.length}}
          <div class="arcflight-travel-runner-mvp__effects">
            {{#each state.effectApplication.rows}}
              <article class="arcflight-travel-runner-mvp__effect-row">
                <h3>{{#if selectable}}<input type="checkbox" data-arcflight-runner-apply-effect value="{{index}}" checked>{{else}}<input type="checkbox" disabled>{{/if}} {{displayIndex}}. {{label}}</h3>
                <dl>
                  <dt>Type</dt><dd>{{type}}</dd>
                  <dt>Status</dt><dd>{{status}}</dd>
                  <dt>Resource</dt><dd>{{resource}}</dd>
                  <dt>Mode</dt><dd>{{mode}}</dd>
                  <dt>Value</dt><dd>{{value}}</dd>
                  <dt>Current Value</dt><dd>{{currentValue}}</dd>
                  <dt>Preview Value</dt><dd>{{previewValue}}</dd>
                </dl>
                {{#if warnings.length}}<p class="arcflight-sheet__hint"><strong>Warnings:</strong> {{warnings}}</p>{{/if}}
              </article>
            {{/each}}
          </div>
        {{else}}
          <p class="arcflight-sheet__hint">No proposed effects are attached to the final outcome.</p>
        {{/if}}

        <h3>Applied Effects History</h3>
        {{#if state.effectApplication.records.length}}
          <div class="arcflight-travel-runner-mvp__effects">
            {{#each state.effectApplication.records}}
              <article class="arcflight-travel-runner-mvp__effect-row">
                <strong>{{effectLabel}}</strong>
                <dl>
                  <dt>Resource</dt><dd>{{resource}}</dd>
                  <dt>Mode</dt><dd>{{mode}}</dd>
                  <dt>Value</dt><dd>{{value}}</dd>
                  <dt>Actor</dt><dd>{{actorName}}</dd>
                  <dt>Before</dt><dd>{{beforeValue}}</dd>
                  <dt>After</dt><dd>{{afterValue}}</dd>
                  <dt>Applied At</dt><dd>{{appliedAt}}</dd>
                  <dt>Status</dt><dd>{{status}}</dd>
                  {{#if currentValue}}<dt>Current Value</dt><dd>{{currentValue}}</dd>{{/if}}
                </dl>
                {{#if undoable}}
                  <button type="button" data-arcflight-runner-undo-effect data-application-id="{{applicationId}}">Undo Applied Effect</button>
                {{else}}
                  {{#if undone}}<p class="arcflight-sheet__hint"><strong>Undone:</strong> {{undoneAt}}</p>{{/if}}
                  {{#if undoWarning}}<p class="arcflight-sheet__hint"><strong>Undo Warning:</strong> {{undoWarning}}</p>{{/if}}
                {{/if}}
              </article>
            {{/each}}
          </div>
        {{else}}
          <p class="arcflight-sheet__hint">No effects from this runner session have been applied yet.</p>
        {{/if}}
      </section>
    {{/if}}


    <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__staged-review">
      <h2>Staged Consequence Review</h2>
      {{#if state.stagedEffectReview.available}}
        <p class="arcflight-sheet__hint"><strong>{{state.stagedEffectReview.review.notAppliedWarning}}</strong></p>
        <div class="arcflight-travel-runner-mvp__stats">
          <div><span>Event</span><strong>{{state.stagedEffectReview.review.eventName}}</strong></div>
          <div><span>Final Outcome</span><strong>{{state.stagedEffectReview.review.finalOutcomeLabel}}</strong></div>
          <div><span>Effects</span><strong>{{state.stagedEffectReview.review.effectCount}}</strong></div>
          <div><span>Supported</span><strong>{{state.stagedEffectReview.review.supportedEffectCount}}</strong></div>
          <div><span>Unsupported</span><strong>{{state.stagedEffectReview.review.unsupportedEffectCount}}</strong></div>
        </div>
        <div class="arcflight-travel-runner-mvp__actions">
          <button type="button" data-arcflight-runner-refresh-review>Refresh Review</button>
          <button type="button" data-arcflight-runner-copy-review-markdown>Copy Review Markdown</button>
          <button type="button" data-arcflight-runner-copy-review-html>Copy Review HTML</button>
        </div>
        {{#if state.stagedEffectReview.review.rows.length}}
          <div class="arcflight-travel-runner-mvp__effects">
            {{#each state.stagedEffectReview.review.rows}}
              <article class="arcflight-travel-runner-mvp__effect-row">
                <h3>{{displayIndex}}. {{label}}</h3>
                <dl>
                  <dt>Type</dt><dd>{{type}}</dd>
                  <dt>Status</dt><dd>{{status}}</dd>
                  <dt>Resource</dt><dd>{{resource}}</dd>
                  <dt>Mode</dt><dd>{{mode}}</dd>
                  <dt>Value</dt><dd>{{value}}</dd>
                  <dt>Current Value</dt><dd>{{currentValue}}</dd>
                  <dt>Preview Value</dt><dd>{{previewValue}}</dd>
                </dl>
                {{#if warnings.length}}<p class="arcflight-sheet__hint"><strong>Warnings:</strong> {{warnings}}</p>{{/if}}
                <pre>{{rawJson}}</pre>
              </article>
            {{/each}}
          </div>
        {{else}}
          <p class="arcflight-sheet__hint">No proposed effects are attached to the final outcome.</p>
        {{/if}}
      {{else}}
        <p class="arcflight-sheet__hint">{{state.stagedEffectReview.reason}}</p>
        <div class="arcflight-travel-runner-mvp__actions">
          <button type="button" data-arcflight-runner-refresh-review>Refresh Review</button>
          <button type="button" data-arcflight-runner-copy-review-markdown disabled>Copy Review Markdown</button>
          <button type="button" data-arcflight-runner-copy-review-html disabled>Copy Review HTML</button>
        </div>
      {{/if}}
    </section>

    <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__final-outcome-package-review" aria-label="Final Outcome Package Review">
      <h2>Final Outcome Package Review</h2>
      <p class="arcflight-sheet__hint"><strong>{{state.finalOutcomePackageReview.reviewOnlyLabel}}:</strong> This panel is read-only. Actor, item, combat, effect, chat, journal, and socket mutation is deferred to later PRs unless a GM explicitly uses an existing safe session-local action elsewhere.</p>
      <div class="arcflight-travel-runner-mvp__v2-review-status-chips">
        <span>{{state.finalOutcomePackageReview.statusLabel}}</span>
        <span>{{state.finalOutcomePackageReview.gmOnlyLabel}}</span>
        <span>{{state.finalOutcomePackageReview.publicSafeLabel}}</span>
        <span>{{state.finalOutcomePackageReview.applyStatusLabel}}</span>
      </div>
      {{#if state.finalOutcomePackageReview.hasBlockedReasons}}
        <h3>Blocked Package State</h3>
        <ul>
          {{#each state.finalOutcomePackageReview.blockedReasons}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      {{else}}
        <section>
          <h3>Outcome</h3>
          <p><strong>{{state.finalOutcomePackageReview.eventOutcomeLabel}}</strong></p>
          <p>{{state.finalOutcomePackageReview.summaryText}}</p>
          <dl>
            <dt>Completed At</dt><dd>{{state.finalOutcomePackageReview.completedAt}}</dd>
            <dt>Event Round Count</dt><dd>{{state.finalOutcomePackageReview.eventRoundCount}}</dd>
            <dt>Finalized Round Count</dt><dd>{{state.finalOutcomePackageReview.finalizedRoundCount}}</dd>
            <dt>Already Applied</dt><dd>{{#if state.finalOutcomePackageReview.alreadyApplied}}{{state.finalOutcomePackageReview.alreadyAppliedLabel}}{{else}}{{state.finalOutcomePackageReview.pendingLabel}}{{/if}}</dd>
          </dl>
        </section>
        <section>
          <h3>Round Summary</h3>
          {{#if state.finalOutcomePackageReview.sections.rounds.hasEntries}}
            <ul>{{#each state.finalOutcomePackageReview.sections.rounds.entries}}<li>Round {{roundNumber}} — {{outcomeKey}} {{#if finalizedAt}}({{finalizedAt}}){{/if}}</li>{{/each}}</ul>
          {{else}}<p class="arcflight-sheet__hint">{{state.finalOutcomePackageReview.sections.rounds.emptyText}}</p>{{/if}}
        </section>
        <section>
          <h3>Pressure Summary</h3>
          {{#if state.finalOutcomePackageReview.sections.pressure.hasEntries}}
            <ul>{{#each state.finalOutcomePackageReview.sections.pressure.totalsByPressureType}}<li>{{label}}: {{value}}</li>{{/each}}</ul>
          {{else}}<p class="arcflight-sheet__hint">{{state.finalOutcomePackageReview.sections.pressure.emptyText}}</p>{{/if}}
        </section>
        <section>
          <h3>Hazards</h3>
          {{#if state.finalOutcomePackageReview.sections.hazards.hasEntries}}<ul>{{#each state.finalOutcomePackageReview.sections.hazards.entries}}<li>{{#if name}}{{name}}{{else}}{{label}}{{/if}}{{#if text}} — {{text}}{{/if}}{{#if summary}} — {{summary}}{{/if}}</li>{{/each}}</ul>{{else}}<p class="arcflight-sheet__hint">{{state.finalOutcomePackageReview.sections.hazards.emptyText}}</p>{{/if}}
        </section>
        <section>
          <h3>Ship Scars</h3>
          {{#if state.finalOutcomePackageReview.sections.shipScars.hasEntries}}<ul>{{#each state.finalOutcomePackageReview.sections.shipScars.entries}}<li>{{#if name}}{{name}}{{else}}{{label}}{{/if}}{{#if text}} — {{text}}{{/if}}{{#if summary}} — {{summary}}{{/if}}</li>{{/each}}</ul>{{else}}<p class="arcflight-sheet__hint">{{state.finalOutcomePackageReview.sections.shipScars.emptyText}}</p>{{/if}}
        </section>
        <section>
          <h3>Fortunes</h3>
          {{#if state.finalOutcomePackageReview.sections.fortunes.hasEntries}}<ul>{{#each state.finalOutcomePackageReview.sections.fortunes.entries}}<li>{{#if name}}{{name}}{{else}}{{label}}{{/if}}{{#if text}} — {{text}}{{/if}}{{#if summary}} — {{summary}}{{/if}}</li>{{/each}}</ul>{{else}}<p class="arcflight-sheet__hint">{{state.finalOutcomePackageReview.sections.fortunes.emptyText}}</p>{{/if}}
        </section>
        <section>
          <h3>Rewards</h3>
          {{#if state.finalOutcomePackageReview.sections.rewards.hasEntries}}<ul>{{#each state.finalOutcomePackageReview.sections.rewards.entries}}<li>{{#if name}}{{name}}{{else}}{{label}}{{/if}}{{#if text}} — {{text}}{{/if}}{{#if summary}} — {{summary}}{{/if}}</li>{{/each}}</ul>{{else}}<p class="arcflight-sheet__hint">{{state.finalOutcomePackageReview.sections.rewards.emptyText}}</p>{{/if}}
        </section>
        <section>
          <h3>Consequences</h3>
          {{#if state.finalOutcomePackageReview.sections.consequences.hasEntries}}<ul>{{#each state.finalOutcomePackageReview.sections.consequences.entries}}<li>{{#if name}}{{name}}{{else}}{{label}}{{/if}}{{#if text}} — {{text}}{{/if}}{{#if summary}} — {{summary}}{{/if}}</li>{{/each}}</ul>{{else}}<p class="arcflight-sheet__hint">{{state.finalOutcomePackageReview.sections.consequences.emptyText}}</p>{{/if}}
        </section>
        <section>
          <h3>Review Status</h3>
          <p>{{state.finalOutcomePackageReview.reviewOnlyLabel}} · {{state.finalOutcomePackageReview.deferredLabel}} · {{state.finalOutcomePackageReview.gmOnlyLabel}} · {{state.finalOutcomePackageReview.publicSafeLabel}}</p>
        </section>
        {{#if state.finalOutcomeApply.isGM}}
          <section class="arcflight-travel-runner-mvp__final-outcome-apply">
            <h3>Apply Final Outcome to Ship</h3>
            <p class="arcflight-sheet__hint">Explicit GM-only action. Applies only supported travel resource updates; scars, fortunes, hazards, rewards, and consequences remain review-only/deferred.</p>
            <dl>
              <dt>Target Ship</dt><dd>{{#if state.finalOutcomeApply.targetActorName}}{{state.finalOutcomeApply.targetActorName}}{{else}}No target ship resolved{{/if}}</dd>
              <dt>Package Apply Status</dt><dd>{{#if state.finalOutcomeApply.packageAlreadyApplied}}Package-level outcome applied{{else}}Package-level outcome pending{{/if}}</dd>
              <dt>Ship Apply Status</dt><dd>{{#if state.finalOutcomeApply.shipAlreadyApplied}}Ship updates already applied{{else}}Ship updates pending{{/if}}</dd>
              <dt>Status</dt><dd>{{state.finalOutcomeApply.disabledReason}}</dd>
            </dl>
            <div class="arcflight-travel-runner-mvp__actions">
              <button type="button" data-arcflight-travel-v2-final-outcome-refresh-apply>Refresh Apply Preview</button>
              {{#if state.finalOutcomeApply.canApply}}
                <button type="button" data-arcflight-travel-v2-final-outcome-apply title="Apply supported final outcome ship resource updates">Apply Final Outcome to Ship</button>
              {{else}}
                <button type="button" data-arcflight-travel-v2-final-outcome-apply disabled title="{{state.finalOutcomeApply.disabledReason}}">Apply Final Outcome to Ship</button>
              {{/if}}
            </div>
            {{#if state.finalOutcomeApply.supportedRows.length}}
              <h4>Supported Ship Resource Updates</h4>
              <table>
                <thead><tr><th>Resource</th><th>Current</th><th>Delta / Set</th><th>Preview</th><th>Status</th></tr></thead>
                <tbody>{{#each state.finalOutcomeApply.supportedRows}}<tr><td>{{resource}}</td><td>{{currentValue}}</td><td>{{#if mode}}{{mode}} {{value}}{{else}}{{delta}}{{/if}}</td><td>{{previewValue}}</td><td>{{status}}</td></tr>{{/each}}</tbody>
              </table>
            {{else}}
              <p class="arcflight-sheet__hint">No supported ship resource updates are ready to apply.</p>
            {{/if}}
            {{#if state.finalOutcomeApply.unsupportedRows.length}}
              <h4>Unsupported Rows</h4>
              <ul>{{#each state.finalOutcomeApply.unsupportedRows}}<li>{{label}} — {{reason}}</li>{{/each}}</ul>
            {{/if}}
            {{#if state.finalOutcomeApply.deferredRows.length}}
              <h4>Deferred / Review-only Package Parts</h4>
              <ul>{{#each state.finalOutcomeApply.deferredRows}}<li>{{label}} — {{statusLabel}}</li>{{/each}}</ul>
            {{/if}}
          </section>
        {{/if}}
      {{/if}}
    </section>

    <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__summary-output">
      <h2>Completed Summary Output</h2>
      {{#if state.summaryOutput.available}}
        <p class="arcflight-sheet__hint"><strong>Read-only:</strong> {{state.summaryOutput.report.proposedEffectsNotice}}</p>
        <div class="arcflight-travel-runner-mvp__actions">
          <button type="button" data-arcflight-runner-copy-markdown>Copy Markdown Summary</button>
          <button type="button" data-arcflight-runner-copy-html>Copy HTML Summary</button>
          {{#if state.summaryOutput.canPostChat}}
            <button type="button" data-arcflight-runner-post-chat title="{{state.summaryOutput.postChatTitle}}">Post Summary to Chat</button>
          {{else}}
            <button type="button" data-arcflight-runner-post-chat disabled title="{{state.summaryOutput.postChatTitle}}">Post Summary to Chat</button>
          {{/if}}
          {{#if state.summaryOutput.canCreateJournal}}
            <button type="button" data-arcflight-runner-create-journal title="{{state.summaryOutput.createJournalTitle}}">Create Journal Entry</button>
          {{else}}
            <button type="button" data-arcflight-runner-create-journal disabled title="{{state.summaryOutput.createJournalTitle}}">Create Journal Entry</button>
          {{/if}}
          <button type="button" data-arcflight-runner-refresh-summary>Refresh Summary</button>
        </div>
        {{#if state.summaryOutput.lastResultMessage}}
          <p class="arcflight-sheet__hint"><strong>Last post/export result:</strong> {{state.summaryOutput.lastResultMessage}}</p>
        {{/if}}
        <label class="arcflight-sheet__field">
          <span>Markdown Summary Output</span>
          <textarea readonly class="arcflight-travel-runner-mvp__json">{{state.summaryOutput.markdown}}</textarea>
        </label>
      {{else}}
        <p class="arcflight-sheet__hint">{{state.summaryOutput.reason}}</p>
        <div class="arcflight-travel-runner-mvp__actions">
          <button type="button" data-arcflight-runner-copy-markdown disabled>Copy Markdown Summary</button>
          <button type="button" data-arcflight-runner-copy-html disabled>Copy HTML Summary</button>
          <button type="button" data-arcflight-runner-post-chat disabled title="{{state.summaryOutput.postChatTitle}}">Post Summary to Chat</button>
          <button type="button" data-arcflight-runner-create-journal disabled title="{{state.summaryOutput.createJournalTitle}}">Create Journal Entry</button>
          <button type="button" data-arcflight-runner-refresh-summary>Refresh Summary</button>
        </div>
      {{/if}}
    </section>
  {{/if}}

  <section class="arcflight-travel-runner-mvp__panel arcflight-travel-runner-mvp__session-library">
    <details>
      <summary><strong>Runner Session Library</strong></summary>
    <p class="arcflight-sheet__hint">World-local manual save/resume snapshots. Saved runner sessions are separate from drafts and published events, and never mutate actors, resources, chat, combat, or proposed effects.</p>
    <div class="arcflight-travel-runner-mvp__actions">
      <button type="button" data-arcflight-runner-refresh-sessions>Refresh Sessions</button>
    </div>

    {{#if state.hasSavedSessions}}
      <label class="arcflight-sheet__field">
        <span>Saved Session</span>
        <select data-arcflight-runner-session-select>
          <option value="">Select a saved session…</option>
          {{#each state.sessionLibrary.entries}}
            <option value="{{key}}" {{#if selected}}selected{{/if}} {{#unless canLoad}}disabled{{/unless}}>{{name}} — {{statusLabel}}{{#if missingPublishedEvent}} (missing published event){{/if}}{{#if isMalformed}} (malformed){{/if}}</option>
          {{/each}}
        </select>
      </label>

      {{#if state.travelV2CompletedSessionHistory.hasRows}}
        <section class="arcflight-travel-runner-mvp__completed-history" aria-label="Completed Travel v2 Sessions">
          <h3>Completed Travel v2 Sessions</h3>
          <p class="arcflight-sheet__hint">Newest completed sessions first. Reopen loads the saved snapshot only; actor mutation still requires explicit GM Apply buttons.</p>
          {{#each state.travelV2CompletedSessionHistory.rows}}
            <article class="arcflight-travel-runner-mvp__session-row arcflight-travel-runner-mvp__completed-card">
              <header>
                <strong>{{eventName}}</strong>
                <span>{{outcome}}</span>
              </header>
              <dl class="arcflight-travel-runner-mvp__completed-grid">
                <dt>Ship</dt><dd>{{shipName}}</dd>
                <dt>Completed</dt><dd>{{completedAtLabel}}</dd>
                <dt>Completed By</dt><dd>{{#if completedBy}}{{completedBy}}{{else}}—{{/if}}</dd>
                <dt>Outcome</dt><dd>{{#if outcome}}{{outcome}}{{else}}{{outcomeKey}}{{/if}}</dd>
                <dt>Application Status</dt><dd>{{applicationStatusLabel}}</dd>
                <dt>Applied</dt><dd>{{appliedAtLabel}}</dd>
                <dt>Follow-ups</dt><dd>{{followUpCount}}</dd>
              </dl>
              {{#if summaryView.available}}
                <details class="arcflight-travel-runner-mvp__completed-summary" open>
                  <summary><strong>Read-only Stored Summary</strong></summary>
                  <section>
                    <h4>Public Summary — {{summaryView.publicSummary.title}}</h4>
                    {{#each summaryView.publicSummary.paragraphs}}<p>{{this}}</p>{{/each}}
                    {{#if summaryView.publicSummary.chips.length}}<p class="arcflight-travel-runner-mvp__chips">{{#each summaryView.publicSummary.chips}}<span>{{this}}</span>{{/each}}</p>{{/if}}
                  </section>
                  <section class="arcflight-gm-only">
                    <h4>GM Summary</h4>
                    {{#each summaryView.gmSummary.paragraphs}}<p>{{this}}</p>{{/each}}
                    {{#if summaryView.gmSummary.nextSteps.length}}<h5>Next Steps</h5><ul>{{#each summaryView.gmSummary.nextSteps}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
                    {{#if summaryView.gmSummary.warnings.length}}<h5>Warnings</h5><ul>{{#each summaryView.gmSummary.warnings}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
                  </section>
                  <section><h4>Round Summaries</h4>{{#each summaryView.rounds}}<article class="arcflight-travel-card"><strong>Round {{roundNumber}} — {{title}}</strong><p class="arcflight-sheet__hint">{{status}} · Generated consequences: {{consequencesGeneratedCount}} · Handled: {{consequencesHandledCount}}</p>{{#if stationResults.length}}<ul>{{#each stationResults}}<li>{{stationName}}: {{resultLabel}}{{#if actorName}} ({{actorName}}){{/if}}{{#if approachLabel}} via {{approachLabel}}{{/if}}</li>{{/each}}</ul>{{/if}}</article>{{/each}}</section>
                  <section><h4>Station Result Summaries</h4>{{#if summaryView.hasStationResults}}<ul>{{#each summaryView.stationResults}}<li>Round {{roundNumber}} {{stationName}} — {{resultLabel}}{{#if publicSummary}}: {{publicSummary}}{{/if}}</li>{{/each}}</ul>{{else}}<p class="arcflight-sheet__hint">No station results stored.</p>{{/if}}</section>
                  <section><h4>Resource Deltas</h4>{{#if summaryView.hasResourceDeltas}}<ul>{{#each summaryView.resourceDeltas}}<li>{{label}}: {{displayAmount}}</li>{{/each}}</ul>{{else}}<p class="arcflight-sheet__hint">No resource deltas were recorded.</p>{{/if}}</section>
                  <section><h4>Consequences & Follow-ups</h4><p>Applied: {{summaryView.consequenceCounts.applied}} · Dismissed: {{summaryView.consequenceCounts.dismissed}} · Pending: {{summaryView.consequenceCounts.pending}}</p><p>Follow-ups: {{summaryView.followupCount}}</p>{{#if summaryView.hasFollowups}}<ul>{{#each summaryView.followups}}<li>{{title}} — {{status}}{{#if publicSummary}}: {{publicSummary}}{{/if}}</li>{{/each}}</ul>{{/if}}</section>
                </details>
              {{else}}<p class="arcflight-sheet__hint">No stored completion summary is available for this legacy entry.</p>{{/if}}
              {{#if isMalformed}}<p class="arcflight-sheet__hint"><strong>Warning:</strong> This completed session entry is malformed and cannot be reopened, but it can be deleted from runner history.</p>{{/if}}
              <div class="arcflight-travel-runner-mvp__actions">
                <button type="button" data-arcflight-runner-load-session="{{key}}" {{#unless canReopen}}disabled{{/unless}}>Reopen Completed Session</button>
                <button type="button" data-arcflight-travel-v2-delete-completed-session="{{key}}" data-session-name="{{name}}" {{#unless canDelete}}disabled{{/unless}}>Delete Completed Session</button>
              </div>
            </article>
          {{/each}}
        </section>
      {{/if}}

      <div class="arcflight-travel-runner-mvp__sessions">
        {{#each state.sessionLibrary.entries}}
          <article class="arcflight-travel-runner-mvp__session-row">
            <header>
              <strong>{{name}}</strong>
              <span>{{statusLabel}}</span>
            </header>
            <p>{{eventName}}{{#if eventCategoryLabel}} — {{eventCategoryLabel}}{{/if}}</p>
            <p class="arcflight-sheet__hint">Round {{currentRoundNumber}} • Updated {{updatedAtLabel}}</p>
            {{#if missingPublishedEvent}}<p class="arcflight-sheet__hint"><strong>Warning:</strong> The source published event is not currently available. Loading uses the saved snapshot only.</p>{{/if}}
            {{#if validationErrors.length}}<p class="arcflight-sheet__hint"><strong>Malformed:</strong> {{validationErrors}}</p>{{/if}}
            <div class="arcflight-travel-runner-mvp__actions">
              <button type="button" data-arcflight-runner-load-session="{{key}}" {{#unless canLoad}}disabled{{/unless}}>Load Session</button>
              <button type="button" data-arcflight-runner-duplicate-session="{{key}}" {{#unless canDuplicate}}disabled{{/unless}}>Duplicate Session</button>
              <button type="button" data-arcflight-runner-delete-session="{{key}}" data-session-name="{{name}}" {{#unless canDelete}}disabled{{/unless}}>Delete Session</button>
            </div>
          </article>
        {{/each}}
      </div>
    {{else}}
      <p class="arcflight-sheet__hint">No runner sessions have been saved yet. Start or load a published event, record manual results, then choose Save Current Session.</p>
      <div class="arcflight-travel-runner-mvp__actions">
        <button type="button" data-arcflight-runner-load-session disabled>Load Session</button>
        <button type="button" data-arcflight-runner-duplicate-session disabled>Duplicate Session</button>
        <button type="button" data-arcflight-runner-delete-session disabled>Delete Session</button>
      </div>
    {{/if}}
    </details>
  </section>
  </details>
  {{/unless}}
</div>
