                        <button type="button" data-arcflight-travel-v2-follow-up-id="{{id}}" data-arcflight-travel-v2-follow-up-status="dismissed" {{#if actionsDisabled}}disabled{{/if}}>Dismiss</button>
                      </div>
                    </article>
