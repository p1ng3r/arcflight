        {{/if}}
        {{#if state.travelV2PreviewPanel.travelV2RoundFinalizationState.hasReadinessText}}
          <p class="arcflight-travel-runner-mvp__v2-preview-feedback arcflight-travel-runner-mvp__v2-preview-feedback--applied">{{state.travelV2PreviewPanel.travelV2RoundFinalizationState.readinessText}}</p>
        {{/if}}
        <div class="arcflight-travel-runner-mvp__v2-event-readiness" aria-label="Travel v2 event completion readiness">
          <div class="arcflight-travel-runner-mvp__v2-event-readiness-header">
