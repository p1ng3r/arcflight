          <div><span>Station rolls pending</span><strong>{{state.roundSegmentState.stationRollsPending}}</strong></div>
          <div><span>Reaction prompts pending</span><strong>{{state.roundSegmentState.reactionPromptsPending}}</strong></div>
          <div><span>Stabilize resolutions pending</span><strong>{{state.roundSegmentState.stabilizeResolutionsPending}}</strong></div>
