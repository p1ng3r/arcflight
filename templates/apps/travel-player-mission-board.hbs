<section class="arcflight-travel-party-hud {{#if state.isCompactHud}}arcflight-travel-party-hud--compact{{else}}arcflight-travel-party-hud--expanded{{/if}} arcflight-player-safe">
  <header class="arcflight-travel-party-hud__header">
    <div>
      <p class="arcflight-travel-party-hud__eyebrow">Arcflight Party Travel HUD</p>
      <h1>{{state.eventName}}</h1>
      <p class="arcflight-sheet__hint">{{state.roundLabel}}{{#if state.roundTitle}} — {{state.roundTitle}}{{/if}} · {{state.currentPhaseLabel}}</p>
    </div>
    <div class="arcflight-travel-party-hud__status">
      <span>{{state.shipName}}</span>
      <strong>{{state.voyageStatus}}</strong>
      <button type="button" data-arcflight-party-hud-toggle>{{#if state.isCompactHud}}Expand{{else}}Minimize{{/if}}</button>
    </div>
  </header>

  {{#unless state.isCompactHud}}
  <section class="arcflight-travel-party-hud__quick" aria-label="Current Player Quick Action">
    <h2>Current Player Quick Action</h2>
    {{#if state.hasStations}}
      {{#each state.stations}}
        {{#if isCurrentUserRollable}}<button type="button" data-arcflight-party-hud-open-station data-station-key="{{stationKey}}">Open My Station Card — {{stationName}}</button>{{/if}}
      {{/each}}
    {{/if}}
    <a href="#arcflight-party-hud-ship-status" class="button">Review Ship Status</a>
    {{#if state.hasPublicHazards}}<a href="#arcflight-party-hud-hazards" class="button">Review Revealed Hazard</a>{{/if}}
  </section>

  {{#if state.hasPartyAlerts}}
    <section class="arcflight-travel-party-hud__alerts" aria-label="Party Alerts">
      {{#each state.partyAlerts}}<p class="arcflight-travel-party-hud__alert arcflight-travel-party-hud__alert--{{tone}}">{{icon}} {{text}}</p>{{/each}}
    </section>
  {{/if}}

  <section class="arcflight-travel-party-hud__overview" aria-label="Current Travel Event">
    <h2>Current Travel Event</h2>
    <dl>
      <div><dt>Event</dt><dd>{{state.eventName}}</dd></div>
      <div><dt>Round</dt><dd>{{state.roundLabel}}</dd></div>
      <div><dt>Phase</dt><dd>{{state.currentPhaseLabel}}</dd></div>
      <div><dt>Ship</dt><dd>{{state.shipName}}</dd></div>
      <div><dt>Status</dt><dd>{{state.voyageStatus}}</dd></div>
    </dl>
    {{#if state.vignette}}<p>{{state.vignette}}</p>{{/if}}
  </section>

  <section class="arcflight-travel-party-hud__stations" aria-label="Party Station Overview">
    <h2>Party Station Overview</h2>
    {{#if state.hasStations}}
      <div class="arcflight-travel-party-hud__station-grid">
        {{#each state.stations}}
          <article class="arcflight-travel-party-hud__station {{#if hasResult}}arcflight-resolved{{else}}arcflight-player-waiting{{/if}}">
            <h3>{{stationName}}</h3>
            <p><strong>{{assignedActorName}}</strong></p>
            <p>{{stateLabel}}</p>
            {{#if hasResult}}<p class="arcflight-sheet__hint">Result: {{resultLabel}}</p>{{/if}}
            {{#if isCurrentUserRollable}}<button type="button" data-arcflight-party-hud-open-station data-station-key="{{stationKey}}">Open My Station Card</button>{{/if}}
          </article>
        {{/each}}
      </div>
    {{else}}<p class="arcflight-sheet__hint">No active stations are available for this round.</p>{{/if}}
  </section>

  <section id="arcflight-party-hud-ship-status" class="arcflight-travel-party-hud__ship-status" aria-label="Shared Ship Pressure Gauges">
    <h2>Shared Ship Pressure Gauges</h2>
    <div class="arcflight-travel-party-hud__gauges">
      {{#each state.pressureGauges}}
        <article class="arcflight-travel-party-hud__gauge arcflight-pressure-gauge arcflight-pressure-gauge--{{stateClass}}" title="{{tooltip}}" style="--arcflight-gauge-angle: {{needleAngle}}deg; --arcflight-gauge-fill: {{fillPercent}}%;">
          <div class="arcflight-pressure-gauge__meta"><span class="arcflight-pressure-gauge__label">{{icon}} {{label}}</span><strong class="arcflight-pressure-gauge__value">{{valueLabel}}</strong></div>
          <div class="arcflight-pressure-gauge__face" aria-label="{{label}} pressure {{statusBand}}"><span class="arcflight-pressure-gauge__tick arcflight-pressure-gauge__tick--0">0</span><span class="arcflight-pressure-gauge__tick arcflight-pressure-gauge__tick--1">1</span><span class="arcflight-pressure-gauge__tick arcflight-pressure-gauge__tick--2">2</span><span class="arcflight-pressure-gauge__tick arcflight-pressure-gauge__tick--3">3</span><span class="arcflight-pressure-gauge__tick arcflight-pressure-gauge__tick--4">4</span><span class="arcflight-pressure-gauge__needle"></span></div>
          <p class="arcflight-pressure-gauge__description">{{statusBand}}</p>
        </article>
      {{/each}}
    </div>
  </section>

  <section id="arcflight-party-hud-hazards" class="arcflight-travel-party-hud__cards" aria-label="Revealed Hazard Cards">
    <h2>Revealed Hazard Cards</h2>
    {{#if state.hasPublicHazards}}{{#each state.publicHazards}}<article class="arcflight-travel-party-hud__revealed-card arcflight-player-safe"><strong>{{name}}</strong>{{#if category}}<span>{{category}}</span>{{/if}}<p>{{playerText}}</p><p class="arcflight-sheet__hint">{{status}}</p></article>{{/each}}{{else}}<p class="arcflight-sheet__hint">No hazards have been revealed.</p>{{/if}}
  </section>

  <section class="arcflight-travel-party-hud__cards" aria-label="Revealed Ship Scars">
    <h2>Revealed Ship Scars</h2>
    {{#if state.hasPublicShipScars}}{{#each state.publicShipScars}}<article class="arcflight-travel-party-hud__revealed-card arcflight-player-safe"><strong>{{name}}</strong>{{#if severity}}<span>{{severity}}</span>{{/if}}<p>{{playerText}}</p>{{#if repairRequirement}}<p class="arcflight-sheet__hint">Repair: {{repairRequirement}}</p>{{/if}}<p class="arcflight-sheet__hint">{{status}}</p></article>{{/each}}{{else}}<p class="arcflight-sheet__hint">No Ship Scars have been revealed.</p>{{/if}}
  </section>
  {{/unless}}
</section>
