<section class="arcflight-travel-player-mission-board__shell">
  <header class="arcflight-travel-player-mission-board__header">
    <div>
      <p class="arcflight-travel-player-mission-board__eyebrow">{{state.roundLabel}}{{#if state.roundTitle}} — {{state.roundTitle}}{{/if}}</p>
      <h1>{{state.eventName}}</h1>
      <p class="arcflight-sheet__hint">Shared player mission board. Updates appear when the GM sends or refreshes the board.</p>
    </div>
  </header>

  <section class="arcflight-travel-player-mission-board__vignette" aria-label="Current round vignette">
    <h2>Current Mission</h2>
    {{#if state.vignette}}<p>{{state.vignette}}</p>{{else}}<p class="arcflight-sheet__hint">No round vignette is available.</p>{{/if}}
  </section>

  {{#if state.hasStations}}
    <section class="arcflight-travel-player-mission-board__grid" aria-label="Active travel stations">
      {{#each state.stations}}
        <article class="arcflight-travel-player-mission-board__station {{#if isCurrentUserRollable}}arcflight-travel-player-mission-board__station--rollable{{/if}} {{#if isRolling}}arcflight-travel-player-mission-board__station--rolling{{/if}}" data-arcflight-mission-board-station data-station-key="{{stationKey}}">
          <header class="arcflight-travel-player-mission-board__station-header">
            <h2>{{stationName}}</h2>
            <div class="arcflight-travel-player-mission-board__status-stack">
              <span class="arcflight-travel-player-mission-board__badge" title="{{rollDetailText}}">{{resultLabel}}</span>
              <span class="arcflight-travel-player-mission-board__state" data-arcflight-mission-board-state>{{stateLabel}}</span>
            </div>
          </header>
          <dl class="arcflight-travel-player-mission-board__facts">
            <div><dt>Assigned</dt><dd>{{assignedActorName}}</dd></div>
            <div><dt>DC</dt><dd>{{dcLabel}}</dd></div>
            <div><dt>Selected</dt><dd>{{#if hasSelectedApproach}}{{selectedApproachLabel}}{{else}}Not selected{{/if}}</dd></div>
            {{#if npcControllerName}}<div><dt>NPC Controller</dt><dd>{{npcControllerName}}</dd></div>{{/if}}
          </dl>
          {{#if hasPromptText}}<p class="arcflight-travel-player-mission-board__prompt">{{promptText}}</p>{{/if}}

          {{#if isStabilize}}
            <p class="arcflight-sheet__hint"><strong>Station Order:</strong> Stabilize</p>
            <p class="arcflight-sheet__hint"><strong>Stabilize Target:</strong> {{stabilizePressureLabel}}</p>
            <p class="arcflight-sheet__hint">This roll reduces pressure and does not add round progress.</p>
          {{else}}
            <p class="arcflight-sheet__hint"><strong>Station Order:</strong> Push Forward</p>
            <p class="arcflight-sheet__hint">This roll contributes to round progress.</p>
          {{/if}}

          {{#if hasSelectedApproach}}
            {{#if selectedApproachRollLabel}}<p class="arcflight-sheet__hint"><strong>Selected:</strong> {{selectedApproachLabel}}</p><p class="arcflight-sheet__hint"><strong>Roll:</strong> {{selectedApproachRollLabel}}</p>{{else}}{{#if selectedApproachStatisticLabel}}<p class="arcflight-sheet__hint"><strong>Roll:</strong> {{selectedApproachStatisticLabel}}{{#if dcLabel}} vs {{dcLabel}}{{/if}}</p>{{/if}}{{/if}}
            {{#if hasSelectedApproachHelpText}}<p class="arcflight-sheet__hint"><strong>How This Helps:</strong> {{selectedApproachHelpText}}</p>{{/if}}
          {{else}}
            {{#if hasApproachOptions}}
              <label class="arcflight-travel-player-mission-board__control">
                <span>How do you handle your station?</span>
                <select data-arcflight-mission-board-approach data-station-key="{{stationKey}}" {{#unless canChooseApproach}}disabled{{/unless}}>
                  {{#each approachOptions}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if displayLabel}}{{displayLabel}}{{else}}{{#if label}}{{label}}{{else}}{{skill}}{{/if}}{{/if}}</option>
                  {{/each}}
                </select>
              </label>
              <details class="arcflight-travel-player-mission-board__approach-help">
                <summary>How This Helps</summary>
                {{#each approachOptions}}
                  <p><strong>{{#if label}}{{label}}{{else}}{{skill}}{{/if}}</strong>{{#if statisticLabel}} — {{statisticLabel}}{{/if}}{{#if dcLabel}} — {{dcLabel}}{{/if}}{{#if helpText}}<br>{{helpText}}{{/if}}</p>
                {{/each}}
              </details>
              {{#if hasFocusOptions}}
                <section class="arcflight-travel-player-mission-board__focus">
                  <h3>Station Focus</h3>
                  <label class="arcflight-travel-player-mission-board__control">
                    <span>Spend Focus</span>
                    <select data-arcflight-mission-board-focus data-station-key="{{stationKey}}" {{#unless canSpendFocus}}disabled{{/unless}}>
                      <option value="">Do not spend Focus</option>
                      {{#each focusOptions}}<option value="{{value}}">{{label}}</option>{{/each}}
                    </select>
                  </label>
                </section>
              {{/if}}
              <button type="button" data-arcflight-mission-board-commit-order data-station-key="{{stationKey}}" {{#unless canChooseApproach}}disabled title="{{permissionReason}}"{{/unless}}>Commit Station Order</button>
            {{else}}
              <p class="arcflight-sheet__hint">No approaches are available for this station.</p>
            {{/if}}
          {{/if}}

          <button type="button" data-arcflight-mission-board-roll data-station-key="{{stationKey}}" {{#unless canRollStation}}disabled title="{{permissionReason}}"{{/unless}}>Roll Station</button>
          {{#if disabledReason}}<p class="arcflight-sheet__hint">{{disabledReason}}</p>{{/if}}
          {{#if rollDetailText}}<details class="arcflight-travel-player-mission-board__roll-detail"><summary>Roll detail</summary><p>{{rollDetailText}}</p></details>{{/if}}
          {{#if hasResultFeedback}}<p class="arcflight-travel-player-mission-board__feedback">{{resultFeedbackText}}</p>{{/if}}
        </article>
      {{/each}}
    </section>
  {{else}}
    <p class="arcflight-sheet__hint">No active stations are available for this round.</p>
  {{/if}}
</section>
