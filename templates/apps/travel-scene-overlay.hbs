<div class="arcflight-travel-scene-overlay__shell">
  <header class="arcflight-travel-scene-overlay__header">
    <p class="arcflight-sheet__hint">{{hardBoundaryHint}}</p>
    <div class="arcflight-travel-scene-overlay__actions">
      <button type="button" data-arcflight-refresh-travel-scene-overlay>Refresh Overlay</button>
      {{#if state.hasSession}}<button type="button" data-arcflight-overlay-send-mission-board>Send/Refresh Player Mission Board</button>{{/if}}
      <button type="button" data-arcflight-overlay-socket-test>Socket Test</button>
      {{#if state.hasSession}}<button type="button" data-arcflight-overlay-send-all-player-cards>Send All Player Cards</button>{{/if}}
    </div>
    {{#if state.hasSession}}
      <h1>{{state.eventName}}</h1>
      <p><strong>{{state.roundLabel}}</strong>{{#if state.roundTitle}} — {{state.roundTitle}}{{/if}}</p>
    {{else}}
      <h1>Travel Scene Overlay</h1>
      <p class="arcflight-sheet__hint">{{state.emptyMessage}}</p>
    {{/if}}
  </header>

  {{#if state.hasSession}}
    <section class="arcflight-travel-scene-overlay__summary" aria-label="Travel round status summary">
      <div class="arcflight-travel-scene-overlay__summary-heading">
        <h2>{{state.eventName}}</h2>
        <span>{{state.roundLabel}}{{#if state.roundTitle}} — {{state.roundTitle}}{{/if}}</span>
      </div>
      <p>{{state.roundStateSummary}}</p>
      <dl class="arcflight-travel-scene-overlay__summary-counts">
        <div><dt>Total Stations</dt><dd>{{state.stationCount}}</dd></div>
        <div><dt>Assigned</dt><dd>{{state.assignedStationCount}}</dd></div>
        <div><dt>Approaches</dt><dd>{{state.selectedApproachCount}}</dd></div>
        <div><dt>Results</dt><dd>{{state.recordedResultCount}}</dd></div>
      </dl>
    </section>

    {{#if state.hasGmGuidance}}
      <section class="arcflight-travel-scene-overlay__gm-guidance" aria-label="GM round guidance">
        <div class="arcflight-travel-scene-overlay__gm-guidance-copy">
          <div class="arcflight-travel-scene-overlay__focus-kicker">GM Round Guidance</div>
          <h2>{{state.gmGuidanceTitle}}</h2>
          {{#if state.gmGuidanceText}}
            <p>{{state.gmGuidanceText}}</p>
          {{/if}}
        </div>
        <dl class="arcflight-travel-scene-overlay__gm-guidance-counts">
          <div><dt>Unresolved</dt><dd>{{state.unresolvedStationCount}}</dd></div>
          <div><dt>Unassigned</dt><dd>{{state.unassignedStationCount}}</dd></div>
          <div><dt>No Approach</dt><dd>{{state.unselectedApproachCount}}</dd></div>
          <div><dt>No Result</dt><dd>{{state.unresolvedResultCount}}</dd></div>
        </dl>
        {{#if state.hasGmGuidanceSteps}}
          <ul class="arcflight-travel-scene-overlay__gm-guidance-steps">
            {{#each state.gmGuidanceSteps}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        {{/if}}
      </section>
    {{/if}}

    {{#if state.hasFocusedStation}}
      {{#with state.focusedStation}}
        <section class="arcflight-travel-scene-overlay__focus" aria-label="Active station focus">
          <div class="arcflight-travel-scene-overlay__focus-kicker">Active Station Focus</div>
          <header class="arcflight-travel-scene-overlay__focus-header">
            <h2>{{stationName}}</h2>
            <span class="arcflight-travel-scene-overlay__station-card-state">{{resultLabel}}</span>
          </header>
          <dl class="arcflight-travel-scene-overlay__station-card-facts arcflight-travel-scene-overlay__focus-facts">
            <div><dt>Assigned Actor</dt><dd>{{assignedActorName}}</dd></div>
            <div><dt>Approach</dt><dd>{{approachLabel}}</dd></div>
            <div><dt>Result</dt><dd>{{resultLabel}}</dd></div>
          </dl>
          {{#if hasPromptText}}
            <p class="arcflight-travel-scene-overlay__station-card-text"><strong>Station Prompt:</strong> {{promptText}}</p>
          {{/if}}
          {{#if hasApproachHelpText}}
            <p class="arcflight-travel-scene-overlay__station-card-text arcflight-sheet__hint"><strong>How This Helps:</strong> {{approachHelpText}}</p>
          {{/if}}
          {{#if hasResultFeedback}}
            <p class="arcflight-travel-scene-overlay__station-card-text arcflight-sheet__hint"><strong>Station Feedback:</strong> {{resultFeedback}}</p>
          {{/if}}
        </section>
      {{/with}}
    {{/if}}

    <section class="arcflight-travel-scene-overlay__panel">
      <h2>Scene Vignette</h2>
      {{#if state.vignette}}
        <p>{{state.vignette}}</p>
      {{else}}
        <p class="arcflight-sheet__hint">No opening/current round vignette is available for this runner round.</p>
      {{/if}}
    </section>

    <section class="arcflight-travel-scene-overlay__panel">
      <h2>Active Stations</h2>
      {{#if state.hasStations}}
        <div class="arcflight-travel-scene-overlay__station-list">
          {{#each state.stations}}
            <article class="{{classes}}">
              <header class="arcflight-travel-scene-overlay__station-card-header">
                <h3>{{stationName}}</h3>
                <span class="arcflight-travel-scene-overlay__station-card-state">{{resultLabel}}</span>
              </header>

              <div class="arcflight-travel-scene-overlay__player-preview">
                <button type="button" data-arcflight-overlay-preview-player-card data-station-key="{{stationKey}}">Preview Player Card</button>
                <button type="button" data-arcflight-overlay-send-player-card data-station-key="{{stationKey}}">Send Player Card</button>
                <button type="button" data-arcflight-overlay-broadcast-player-card data-station-key="{{stationKey}}">Broadcast Player Card</button>
              </div>

              <dl class="arcflight-travel-scene-overlay__station-card-facts">
                <div><dt>Assigned Actor</dt><dd>{{assignedActorName}}</dd></div>
                <div><dt>Approach</dt><dd>{{approachLabel}}</dd></div>
                <div><dt>DC</dt><dd>{{dcLabel}}</dd></div>
                <div><dt>Modifier</dt><dd>{{selectedApproachModifierLabel}}</dd></div>
                <div><dt>Result</dt><dd>{{resultLabel}}</dd></div>
                {{#if isNpcAssignment}}<div><dt>NPC Controller</dt><dd>{{npcControllerName}}</dd></div>{{/if}}
              </dl>

              {{#if isNpcAssignment}}
              <label class="arcflight-travel-scene-overlay__station-control">
                <span>NPC Controller</span>
                <select data-arcflight-overlay-npc-controller-select data-station-key="{{stationKey}}">
                  <option value="">Unassigned player controller</option>
                  {{#each npcControllerOptions}}<option value="{{userId}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              </label>
              {{/if}}
              <div class="arcflight-travel-scene-overlay__station-controls" aria-label="{{stationName}} station controls">
                <label>
                  <span>Assigned Actor</span>
                  <select data-arcflight-overlay-assignment-select data-station-key="{{stationKey}}" {{#unless hasAssignmentOptions}}disabled{{/unless}} {{#if ../state.isCompleted}}disabled{{/if}}>
                    <option value="">Unassigned</option>
                    {{#each assignmentOptions}}
                      <option value="{{actorUuid}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                    {{/each}}
                  </select>
                </label>
                <div class="arcflight-travel-scene-overlay__station-control-actions">
                  {{#if canClearAssignment}}<button type="button" data-arcflight-overlay-clear-assignment data-station-key="{{stationKey}}" {{#if ../state.isCompleted}}disabled{{/if}}>Clear</button>{{/if}}
                  {{#if canResetAssignment}}<button type="button" data-arcflight-overlay-reset-assignment data-station-key="{{stationKey}}" {{#if ../state.isCompleted}}disabled{{/if}}>Reset to Ship</button>{{/if}}
                </div>
                <label>
                  <span>Approach / Skill</span>
                  <select data-arcflight-overlay-approach-select data-round-index="{{../state.currentRoundIndex}}" data-station-key="{{stationKey}}" {{#unless hasApproachOptions}}disabled{{/unless}} {{#if ../state.isCompleted}}disabled{{/if}}>
                    {{#each approachOptions}}
                      <option value="{{skill}}" {{#if selected}}selected{{/if}}>{{#if label}}{{label}}{{else}}{{skill}}{{/if}}{{#if skill}} ({{skill}}){{/if}}</option>
                    {{/each}}
                  </select>
                </label>
                <div class="arcflight-travel-scene-overlay__roll-controls" role="group" aria-label="GM roll {{stationName}} check">
                  <div class="arcflight-travel-scene-overlay__roll-readout">
                    <strong>{{dcLabel}}</strong>
                    <span>{{selectedApproachModifierLabel}}</span>
                  </div>
                  {{#if canRollStationCheck}}
                    <button type="button" data-arcflight-overlay-roll-station data-round-index="{{../state.currentRoundIndex}}" data-station-key="{{stationKey}}" data-dc="{{dc}}" data-modifier="{{selectedApproachModifier}}" {{#if ../state.isCompleted}}disabled{{/if}}>Roll Check</button>
                  {{else}}
                    <button type="button" disabled title="{{rollUnavailableReason}}">Roll Unavailable</button>
                    <span class="arcflight-travel-scene-overlay__roll-unavailable">{{rollUnavailableReason}}</span>
                  {{/if}}
                </div>
                <div class="arcflight-travel-scene-overlay__result-readout" aria-label="{{stationName}} current result">
                  <span>Current Result</span>
                  <strong>{{resultLabel}}</strong>
                </div>
              </div>

              {{#if hasPromptText}}
                <p class="arcflight-travel-scene-overlay__station-card-text"><strong>Station Prompt:</strong> {{promptText}}</p>
              {{/if}}
              {{#if hasApproachHelpText}}
                <p class="arcflight-travel-scene-overlay__station-card-text arcflight-sheet__hint"><strong>How This Helps:</strong> {{approachHelpText}}</p>
              {{/if}}
              {{#if hasResultFeedback}}
                <p class="arcflight-travel-scene-overlay__station-card-text arcflight-sheet__hint"><strong>Station Feedback:</strong> {{resultFeedback}}</p>
              {{/if}}
            </article>
          {{/each}}
        </div>
      {{else}}
        <p class="arcflight-sheet__hint">No active stations are listed for this round.</p>
      {{/if}}
    </section>

    <section class="arcflight-travel-scene-overlay__panel">
      <h2>GM Round Summary</h2>
      {{#if state.gmRoundSummaryText}}
        <p>{{state.gmRoundSummaryText}}</p>
      {{else}}
        <p class="arcflight-sheet__hint">No GM round summary is available yet.</p>
      {{/if}}
    </section>
  {{/if}}
</div>
