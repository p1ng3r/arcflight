<div class="arcflight-travel-scene-overlay__shell">
  <header class="arcflight-travel-scene-overlay__header">
    <p class="arcflight-sheet__hint">{{hardBoundaryHint}}</p>
    <div class="arcflight-travel-scene-overlay__actions">
      <button type="button" data-arcflight-refresh-travel-scene-overlay>Refresh Overlay</button>
    </div>
    {{#if state.hasSession}}
      <h1>{{state.eventName}}</h1>
      <p><strong>{{state.roundLabel}}</strong>{{#if state.roundTitle}} — {{state.roundTitle}}{{/if}}</p>
    {{else}}
      <h1>Travel Scene Overlay</h1>
      <p class="arcflight-sheet__hint">{{state.emptyMessage}}</p>
    {{/if}}
  </header>

  {{#if state.hasSession}}
    <section class="arcflight-travel-scene-overlay__panel">
      <h2>Scene Vignette</h2>
      {{#if state.vignette}}
        <p>{{state.vignette}}</p>
      {{else}}
        <p class="arcflight-sheet__hint">No opening/current round vignette is available for this runner round.</p>
      {{/if}}
    </section>

    <section class="arcflight-travel-scene-overlay__panel">
      <h2>Active Stations</h2>
      {{#if state.hasStations}}
        <div class="arcflight-travel-scene-overlay__station-list">
          {{#each state.stations}}
            <article class="{{classes}}">
              <header class="arcflight-travel-scene-overlay__station-card-header">
                <h3>{{stationName}}</h3>
                <span class="arcflight-travel-scene-overlay__station-card-state">{{resultLabel}}</span>
              </header>

              <dl class="arcflight-travel-scene-overlay__station-card-facts">
                <div><dt>Assigned Actor</dt><dd>{{assignedActorName}}</dd></div>
                <div><dt>Approach</dt><dd>{{approachLabel}}</dd></div>
                <div><dt>Result</dt><dd>{{resultLabel}}</dd></div>
              </dl>

              {{#if hasPromptText}}
                <p class="arcflight-travel-scene-overlay__station-card-text"><strong>Station Prompt:</strong> {{promptText}}</p>
              {{/if}}
              {{#if hasApproachHelpText}}
                <p class="arcflight-travel-scene-overlay__station-card-text arcflight-sheet__hint"><strong>Approach Help:</strong> {{approachHelpText}}</p>
              {{/if}}
              {{#if hasResultFeedback}}
                <p class="arcflight-travel-scene-overlay__station-card-text arcflight-sheet__hint"><strong>Station Feedback:</strong> {{resultFeedback}}</p>
              {{/if}}
            </article>
          {{/each}}
        </div>
      {{else}}
        <p class="arcflight-sheet__hint">No active stations are listed for this round.</p>
      {{/if}}
    </section>

    <section class="arcflight-travel-scene-overlay__panel">
      <h2>GM Round Summary</h2>
      {{#if state.gmRoundSummaryText}}
        <p>{{state.gmRoundSummaryText}}</p>
      {{else}}
        <p class="arcflight-sheet__hint">No GM round summary is available yet.</p>
      {{/if}}
    </section>
  {{/if}}
</div>
