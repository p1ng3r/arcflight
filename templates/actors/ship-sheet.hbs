<section class="arcflight-sheet arcflight-ship-sheet" data-arcflight-ship-builder>
  <header class="arcflight-sheet__header">
    <img class="arcflight-sheet__image" src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" data-action="editImage">
    <label class="arcflight-sheet__field arcflight-sheet__field--grow">
      <span>Vehicle Name</span>
      <input type="text" name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="arcflight-sheet__field arcflight-sheet__field--checkbox">
      <span>Arcflight Enabled</span>
      <input type="checkbox" {{checked arcflight.enabled}} disabled>
    </label>
    {{#if arcflight.enabled}}
      <input type="hidden" name="flags.arcflight.actorType" value="{{arcflightActorType}}">
    {{else}}
      <button type="button" data-arcflight-enable-ship {{#unless editable}}disabled{{/unless}}>Mark as Arcflight Ship</button>
    {{/if}}
  </header>

  <div class="arcflight-sheet__body">
  {{#if arcflight.enabled}}
  <section class="arcflight-sheet__section">
    <h2>Ship Builder</h2>
    <p class="arcflight-sheet__hint">Drop Arcflight component items onto this sheet to route them to the matching install helper. Ship state is stored on this PF2E vehicle actor under <code>flags.arcflight.system</code>. Installed source references, copied Base data, recalculated Derived values, and editable Current runtime values are intentionally separate.</p>
    <label class="arcflight-sheet__field">
      <span>Actor Type</span>
      <input type="text" name="flags.arcflight.actorType" value="{{arcflight.actorType}}" disabled>
    </label>
  </section>

  <section class="arcflight-sheet__section arcflight-install-ui {{installUi.preview.cssClass}}">
    <h2>Install Component</h2>
    <p class="arcflight-sheet__hint">Controlled install MVP: select an Arcflight world Item, preview validation, then install through the existing helper. This does not drag/drop, mutate source items, or add remove controls.</p>
    <div class="arcflight-install-ui__controls">
      <label class="arcflight-sheet__field arcflight-sheet__field--grow">
        <span>Component Type</span>
        <select data-arcflight-install-component-type {{#unless editable}}disabled{{/unless}}>
          {{#each installUi.componentTypeOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="arcflight-sheet__field arcflight-sheet__field--grow">
        <span>World Item</span>
        <select data-arcflight-install-item {{#unless editable}}disabled{{/unless}}>
          <option value="" {{#unless installUi.selectedItemId}}selected{{/unless}}>Select a world item</option>
          {{#each installUi.itemOptions}}
            <option value="{{id}}" data-uuid="{{uuid}}" data-component-key="{{componentKey}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <button type="button" data-arcflight-install-component {{#unless installUi.canInstall}}disabled{{/unless}} {{#unless editable}}disabled{{/unless}}>Install</button>
    </div>

    {{#unless installUi.hasItemOptions}}
      <p class="arcflight-sheet__hint arcflight-install-ui__empty-hint">{{installUi.noItemsHint}}</p>
    {{/unless}}

    {{#if installUi.hasPreview}}
      <article class="arcflight-install-ui__preview">
        <header>
          <strong>Validation Preview</strong>
          <span class="arcflight-install-ui__badge {{installUi.preview.badgeClass}}">{{installUi.preview.severityLabel}}</span>
        </header>

        <p class="arcflight-install-ui__status {{installUi.preview.statusClass}}">{{installUi.preview.statusLabel}}</p>

        <dl class="arcflight-install-ui__identity">
          <dt>Selected Item</dt>
          <dd>{{installUi.preview.name}}</dd>
          <dt>Component Type</dt>
          <dd>{{installUi.preview.componentTypeLabel}}</dd>
          <dt>UUID</dt>
          <dd>{{installUi.preview.uuid}}</dd>
          {{#if installUi.preview.componentKey}}
            <dt>Component Key</dt>
            <dd>{{installUi.preview.componentKey}}</dd>
          {{/if}}
          <dt>Projected Refit</dt>
          <dd>{{installUi.preview.projectedRefitStatusLabel}} · Pressure {{installUi.preview.projectedRefitPressureTotal}}</dd>
        </dl>

        {{#if installUi.preview.hasMessages}}
          <h3>Messages</h3>
          <ul>
            {{#each installUi.preview.messages}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        {{/if}}

        {{#if installUi.preview.hasWarnings}}
          <h3>Warnings</h3>
          <ul>
            {{#each installUi.preview.warnings}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        {{/if}}

        {{#if installUi.preview.hasSlotRows}}
          <h3>Slot Preview</h3>
          <div class="arcflight-install-ui__slots">
            {{#each installUi.preview.slotRows}}
              <span><strong>{{label}}</strong>: {{currentUsed}}/{{currentCapacity}} → {{projectedUsed}}/{{projectedCapacity}} ({{projectedAvailable}} available)</span>
            {{/each}}
          </div>
        {{/if}}
      </article>
    {{else}}
      <p class="arcflight-sheet__hint">Select a world item to preview severity, messages, warnings, refit pressure, and slot status before installing.</p>
    {{/if}}

    {{#if installUi.hasDisabledReason}}
      <p class="arcflight-sheet__hint arcflight-install-ui__disabled-reason">{{installUi.disabledReason}}</p>
    {{/if}}
  </section>


  <section class="arcflight-sheet__section">
    <h2>Example Builds</h2>
    <p class="arcflight-sheet__hint">Apply a complete example build through the existing clean build helper. This clears the current ship build first, then installs the selected example hull, arkengine, rooms, upgrades, crew, and patterns.</p>
    <div class="arcflight-example-builds">
      <label class="arcflight-sheet__field arcflight-sheet__field--grow">
        <span>Example Build</span>
        <select data-arcflight-example-build {{#unless editable}}disabled{{/unless}}>
          <option value="" {{#unless selectedExampleBuild}}selected{{/unless}}>Select an example build</option>
          {{#each exampleBuildOptions}}
            <option value="{{value}}" data-name="{{name}}" data-role="{{role}}" data-description="{{description}}" {{#if selected}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
      </label>
      <button type="button" data-arcflight-apply-clean-build {{#unless editable}}disabled{{/unless}}>Apply Clean Build</button>
      <button type="button" data-arcflight-clear-build {{#unless editable}}disabled{{/unless}}>Clear Build</button>
    </div>
    <article class="arcflight-example-builds__details" data-arcflight-example-build-details {{#unless selectedExampleBuild}}hidden{{/unless}}>
      <h3 data-arcflight-example-build-name>{{selectedExampleBuild.name}}</h3>
      <p><strong>Role:</strong> <span data-arcflight-example-build-role>{{selectedExampleBuild.role}}</span></p>
      <p data-arcflight-example-build-description>{{selectedExampleBuild.description}}</p>
    </article>
  </section>

  <section class="arcflight-sheet__section">
    <h2>Hull</h2>
    {{#if arcflight.system.installed.hasHull}}
    <div class="arcflight-grid arcflight-grid--ship-values">
      <label class="arcflight-sheet__field">
        <span>Hull Pattern</span>
        <select data-arcflight-hull-pattern {{#unless editable}}disabled{{/unless}}>
          {{#unless arcflight.system.installed.hullPatternKey}}
            <option value="" selected disabled>Select a hull pattern</option>
          {{/unless}}
          {{#each arcflight.system.installed.hullPatternOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="arcflight-sheet__field"><span>Name</span><input type="text" value="{{arcflight.system.installed.hullDisplayName}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Platform</span><input type="text" value="{{arcflight.system.installed.hullPlatform}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Item ID</span><input type="text" value="{{arcflight.system.installed.hullItemId}}" disabled></label>
      <label class="arcflight-sheet__field"><span>UUID</span><input type="text" value="{{arcflight.system.installed.hullUuid}}" disabled></label>
    </div>
    {{else}}
      <p class="arcflight-sheet__hint">No hull installed.</p>
    {{/if}}
    <p class="arcflight-sheet__hint">Install hulls with <code>game.arcflight.installHull(shipActor, hullItem)</code>. Installation stores references and copied base hull data on the vehicle actor without mutating the hull item.</p>
  </section>



  <section class="arcflight-sheet__section">
    <h2>Arkengine</h2>
    {{#if arcflight.system.installed.hasArkengine}}
    <div class="arcflight-grid arcflight-grid--ship-values">
      <label class="arcflight-sheet__field">
        <span>Arkengine Pattern</span>
        <select data-arcflight-arkengine-pattern {{#unless editable}}disabled{{/unless}}>
          {{#unless arcflight.system.installed.arkenginePatternKey}}
            <option value="" selected disabled>Select an arkengine pattern</option>
          {{/unless}}
          {{#each arcflight.system.installed.arkenginePatternOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="arcflight-sheet__field"><span>Name</span><input type="text" value="{{arcflight.system.installed.arkengineDisplayName}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Engine Key</span><input type="text" value="{{arcflight.system.installed.arkengineKey}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Item ID</span><input type="text" value="{{arcflight.system.installed.arkengineItemId}}" disabled></label>
      <label class="arcflight-sheet__field"><span>UUID</span><input type="text" value="{{arcflight.system.installed.arkengineUuid}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Voyage Hex Days</span><input type="text" value="{{arcflight.system.derived.voyageSpeedTravelHexDays}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Variant Family</span><input type="text" value="{{arcflight.system.derived.arkengineVariantFamily}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Spell Rank</span><input type="text" value="{{arcflight.system.base.arkengine.spellRankRequired}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Lifeveil Mod</span><input type="number" value="{{arcflight.system.base.arkengine.lifeveilModifier}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Strain Mod</span><input type="number" value="{{arcflight.system.base.arkengine.strainModifier}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Hard Burn Strain</span><input type="number" value="{{arcflight.system.derived.hardBurnStrainCost}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Overcharge Risk</span><input type="text" value="{{arcflight.system.derived.overchargeRisk}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Arkengine Mod Slots Capacity</span><input type="number" value="{{arcflight.system.derived.arkengineModSlots}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Arkengine Mod Slots Used</span><input type="number" value="{{arcflight.system.derived.arkengineModSlotsUsed}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Arkengine Mod Slots Available</span><input type="number" value="{{arcflight.system.derived.arkengineModSlotsAvailable}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Resistance Tendencies</span><input type="text" value="{{arcflight.system.derived.resistanceTendencies}}" disabled></label>
    </div>
    {{else}}
      <p class="arcflight-sheet__hint">No arkengine installed.</p>
    {{/if}}
    <p class="arcflight-sheet__hint">Install arkengines with <code>game.arcflight.installArkengine(shipActor, arkengineItem)</code>. Variant family and mod slot values are tracked separately from source arkengine item data.</p>
  </section>

  <section class="arcflight-sheet__section">
    <h2>Fueling / Spell-Rank Energy</h2>
    <div class="arcflight-grid arcflight-grid--resources">
      <label class="arcflight-sheet__field"><span>Fuel Slots</span><input type="number" value="{{arcflight.system.fuelingDisplay.fuelSlots}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Max Stored Spell Ranks</span><input type="number" value="{{arcflight.system.fuelingDisplay.maxStoredSpellRanks}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Current Stored Spell Ranks</span><input type="number" value="{{arcflight.system.fuelingDisplay.currentStoredSpellRanks}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Normal Burn Hex Cost</span><input type="number" value="{{arcflight.system.fuelingDisplay.normalHexCost}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Hard Burn Hex Cost</span><input type="number" value="{{arcflight.system.fuelingDisplay.hardBurnHexCost}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Lean Burn Hex Cost</span><input type="number" value="{{arcflight.system.fuelingDisplay.leanBurnHexCost}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Stealth Burn Hex Cost</span><input type="number" value="{{arcflight.system.fuelingDisplay.stealthBurnHexCost}}" disabled></label>
    </div>
    <p class="arcflight-sheet__hint">Read-only arkengine fueling values from the ship's derived stats and current stored spell-rank energy. Values show as 0 until an arkengine provides fueling data.</p>
  </section>

  <section class="arcflight-sheet__section arcflight-validation {{arcflight.system.installValidationReadout.summary.cssClass}}">
    <h2>Tier / Refit / Validation</h2>
    <article class="arcflight-validation__summary">
      <h3>{{arcflight.system.installValidationReadout.summary.label}}</h3>
      <p>{{arcflight.system.installValidationReadout.summary.message}}</p>
    </article>

    <h3>Tier State</h3>
    <div class="arcflight-grid arcflight-grid--resources">
      <label class="arcflight-sheet__field"><span>Base Tier</span><input type="number" value="{{arcflight.system.installValidationReadout.tier.baseTier}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Current Tier</span><input type="number" value="{{arcflight.system.installValidationReadout.tier.currentTier}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Refit Status</span><input type="text" value="{{arcflight.system.installValidationReadout.tier.refitStatusLabel}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Major Refits Completed</span><input type="number" value="{{arcflight.system.installValidationReadout.tier.majorRefitsCompleted}}" disabled></label>
    </div>

    <h3>Refit Pressure</h3>
    <div class="arcflight-grid arcflight-grid--resources">
      <label class="arcflight-sheet__field"><span>Total Pressure</span><input type="number" value="{{arcflight.system.installValidationReadout.pressure.total}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Weapon Pressure</span><input type="number" value="{{arcflight.system.installValidationReadout.pressure.weaponPressure}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Engine Pressure</span><input type="number" value="{{arcflight.system.installValidationReadout.pressure.enginePressure}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Infrastructure Pressure</span><input type="number" value="{{arcflight.system.installValidationReadout.pressure.infrastructurePressure}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Lifeveil Pressure</span><input type="number" value="{{arcflight.system.installValidationReadout.pressure.lifeveilPressure}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Crew Command Pressure</span><input type="number" value="{{arcflight.system.installValidationReadout.pressure.crewCommandPressure}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Occult Pressure</span><input type="number" value="{{arcflight.system.installValidationReadout.pressure.occultPressure}}" disabled></label>
    </div>

    <h3>Major Refit Flags</h3>
    <div class="arcflight-grid arcflight-grid--resources">
      <label class="arcflight-sheet__field"><span>Qualifies For Major Refit</span><input type="text" value="{{arcflight.system.installValidationReadout.flags.qualifiesForMajorRefitLabel}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Requires Drydock</span><input type="text" value="{{arcflight.system.installValidationReadout.flags.requiresDrydockLabel}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Requires Specialist Labor</span><input type="text" value="{{arcflight.system.installValidationReadout.flags.requiresSpecialistLaborLabel}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Requires Rare Materials</span><input type="text" value="{{arcflight.system.installValidationReadout.flags.requiresRareMaterialsLabel}}" disabled></label>
    </div>
    <p class="arcflight-sheet__hint">Read-only status from <code>flags.arcflight.system.tier</code>, <code>refitPressure</code>, and <code>refitFlags</code>. This section does not block installs or change install behavior.</p>
  </section>

  <section class="arcflight-sheet__section arcflight-install-state">
    <h2>Install State</h2>
    <p class="arcflight-sheet__hint">Read-only persistent install lifecycle records from <code>flags.arcflight.system.installState</code>. This section does not add, remove, drag, drop, enforce slots, or mutate install records.</p>

    {{#if arcflight.system.installStateReadout.hasRecords}}
      <h3>Summary</h3>
      <div class="arcflight-grid arcflight-grid--resources">
        <label class="arcflight-sheet__field"><span>Active Installs</span><input type="number" value="{{arcflight.system.installStateReadout.summary.activeInstalls}}" disabled></label>
        <label class="arcflight-sheet__field"><span>Inactive Installs</span><input type="number" value="{{arcflight.system.installStateReadout.summary.inactiveInstalls}}" disabled></label>
        <label class="arcflight-sheet__field"><span>Total Installs</span><input type="number" value="{{arcflight.system.installStateReadout.summary.totalInstalls}}" disabled></label>
        <label class="arcflight-sheet__field"><span>Install Categories Present</span><input type="text" value="{{arcflight.system.installStateReadout.summary.installCategoriesLabel}}" disabled></label>
      </div>

      <h3>Component Counts by Type</h3>
      {{#if arcflight.system.installStateReadout.summary.hasComponentTypeCounts}}
        <div class="arcflight-install-state__chips">
          {{#each arcflight.system.installStateReadout.summary.componentTypeCounts}}
            <span class="arcflight-install-state__chip"><strong>{{this.label}}</strong>: {{this.count}}</span>
          {{/each}}
        </div>
      {{else}}
        <p class="arcflight-sheet__hint">No active component type counts.</p>
      {{/if}}

      <h3>Pressure from Install Records</h3>
      <div class="arcflight-grid arcflight-grid--resources">
        {{#each arcflight.system.installStateReadout.pressure.rows}}
          <label class="arcflight-sheet__field"><span>{{this.label}}</span><input type="number" value="{{this.value}}" disabled></label>
        {{/each}}
      </div>

      <h3>Active Install Records</h3>
      {{#if arcflight.system.installStateReadout.hasActiveRecords}}
        <div class="arcflight-install-state__records">
          {{#each arcflight.system.installStateReadout.activeRecords}}
            <article class="arcflight-install-state__record">
              <header>
                <strong>{{this.componentTypeLabel}}</strong>
                <span>{{this.installCategoryLabel}}</span>
              </header>
              <dl>
                <dt>Item</dt>
                <dd>{{this.itemReference}}</dd>
                <dt>Flags</dt>
                <dd>{{this.flagsLabel}}</dd>
                {{#if this.hasPlacements}}
                  <dt>Placement</dt>
                  <dd>
                    {{#each this.placements}}
                      <span>{{this.label}}: {{this.value}}</span>{{#unless @last}}; {{/unless}}
                    {{/each}}
                  </dd>
                {{/if}}
                {{#if this.hasTierAtInstall}}
                  <dt>Tier at Install</dt>
                  <dd>{{this.tierAtInstall}}</dd>
                {{/if}}
                {{#if this.hasNotes}}
                  <dt>Notes</dt>
                  <dd>{{this.notes}}</dd>
                {{/if}}
              </dl>
            </article>
          {{/each}}
        </div>
      {{else}}
        <p class="arcflight-sheet__hint">No active install records.</p>
      {{/if}}
    {{else}}
      <p class="arcflight-sheet__hint">No persistent install records yet.</p>
    {{/if}}
  </section>

  <section class="arcflight-sheet__section">
    <h2>Arkengine Mods</h2>
    <div class="arcflight-grid arcflight-grid--resources">
      <label class="arcflight-sheet__field"><span>Arkengine Mod Slots Capacity</span><input type="number" value="{{arcflight.system.installed.arkengineModSlots.capacity}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Arkengine Mod Slots Used</span><input type="number" value="{{arcflight.system.installed.arkengineModSlots.used}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Arkengine Mod Slots Available</span><input type="number" value="{{arcflight.system.installed.arkengineModSlots.available}}" disabled></label>
    </div>
    <p class="arcflight-sheet__hint">Arkengine Mods are engine-only tuning components installed into the current Arkengine with <code>game.arcflight.installArkengineMod(shipActor, modItem)</code>. They are not generic Ship Upgrades and do not mutate Hull, Arkengine, Room, or Ship Upgrade items.</p>
    {{#if arcflight.system.installed.arkengineMods.length}}
      <ul>
        {{#each arcflight.system.installed.arkengineMods}}
          <li>
            <strong>{{this.displayName}}</strong> — {{this.modType}}; {{this.rarity}}; {{this.modSlotsRequired}} slot(s); <em>{{this.systemState}}</em>
            {{#if this.effects.derivedStatModifiers.length}}
              <ul>
                {{#each this.effects.derivedStatModifiers}}
                  <li>{{this.summary}}</li>
                {{/each}}
              </ul>
            {{else}}
              <span class="arcflight-sheet__hint">Placeholder interactions only.</span>
            {{/if}}
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="arcflight-sheet__hint">No arkengine mods installed.</p>
    {{/if}}
  </section>

  <section class="arcflight-sheet__section">
    <h2>Rooms</h2>
    <div class="arcflight-grid arcflight-grid--resources">
      <label class="arcflight-sheet__field"><span>Room Slots Capacity</span><input type="number" value="{{arcflight.system.installed.roomSlots.capacity}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Room Slots Used</span><input type="number" value="{{arcflight.system.installed.roomSlots.used}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Room Slots Available</span><input type="number" value="{{arcflight.system.installed.roomSlots.available}}" disabled></label>
    </div>
    <p class="arcflight-sheet__hint">Rooms are physical spaces. Core Rooms are mandatory hull infrastructure and do not consume room slots. Installed expansion Rooms provide utility only while installed and do not grant direct combat or travel stat bonuses.</p>
    <div class="arcflight-room-lists">
      <article>
        <h3>Core Rooms</h3>
        {{#if arcflight.system.installed.coreRooms.length}}
          <ul>
            {{#each arcflight.system.installed.coreRooms}}
              <li><strong>{{this.displayName}}</strong> — {{this.role}} <em>({{this.systemState}})</em></li>
            {{/each}}
          </ul>
        {{else}}
          <p class="arcflight-sheet__hint">No core rooms installed.</p>
        {{/if}}
      </article>
      <article>
        <h3>Installed Expansion Rooms</h3>
        {{#if arcflight.system.installed.rooms.length}}
          <ul>
            {{#each arcflight.system.installed.rooms}}
              <li><strong>{{this.displayName}}</strong> — {{this.roomType}}; {{this.expansionSlotsRequired}} slot(s); <em>{{this.systemState}}</em></li>
            {{/each}}
          </ul>
        {{else}}
          <p class="arcflight-sheet__hint">No rooms installed. Install expansion rooms with <code>game.arcflight.installRoom(shipActor, roomItem)</code>.</p>
        {{/if}}
      </article>
    </div>
  </section>


  <section class="arcflight-sheet__section">
    <h2>Stations</h2>
    <p class="arcflight-sheet__hint">Stations are crew duty roles and operating positions stored on this ship actor. They are separate from Rooms, do not require Room installation, and do not add station actions or AP/RAP controls in this phase.</p>
    <div class="arcflight-station-list">
      {{#each stations}}
        <article class="arcflight-station-list__station">
          <header>
            <h3>{{this.displayName}}</h3>
            <span class="arcflight-station-list__assignment">{{this.assigneeName}}</span>
          </header>
          <p>{{this.role}}</p>
          <p class="arcflight-sheet__hint">{{this.description}}</p>
          {{#if this.assignment}}
            <p class="arcflight-sheet__hint">Assigned as {{this.assignment.assigneeType}}. Reference: {{this.assignment.actorUuid}}{{this.assignment.crewAssetUuid}}</p>
          {{else}}
            <p class="arcflight-sheet__hint">Unassigned</p>
          {{/if}}
        </article>
      {{/each}}
    </div>
  </section>

  <section class="arcflight-sheet__section">
    <h2>Ship Upgrades</h2>
    <div class="arcflight-grid arcflight-grid--resources">
      <label class="arcflight-sheet__field"><span>Ship Upgrade Slots Capacity</span><input type="number" value="{{arcflight.system.installed.shipUpgradeSlots.capacity}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Ship Upgrade Slots Used</span><input type="number" value="{{arcflight.system.installed.shipUpgradeSlots.used}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Ship Upgrade Slots Available</span><input type="number" value="{{arcflight.system.installed.shipUpgradeSlots.available}}" disabled></label>
    </div>
    <p class="arcflight-sheet__hint">Ship Upgrades are permanent vessel improvements, not Rooms or Arkengine Mods. They may modify Derived ship stats and store placeholder interactions for later systems without resolving combat, travel, station, or event gameplay.</p>
    {{#if arcflight.system.installed.shipUpgrades.length}}
      <ul>
        {{#each arcflight.system.installed.shipUpgrades}}
          <li>
            <strong>{{this.displayName}}</strong> — {{this.upgradeType}}; {{this.rarity}}; <em>{{this.systemState}}</em>
            {{#if this.effects.derivedStatModifiers.length}}
              <ul>
                {{#each this.effects.derivedStatModifiers}}
                  <li>{{this.summary}}</li>
                {{/each}}
              </ul>
            {{/if}}
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="arcflight-sheet__hint">No ship upgrades installed. Install ship upgrades with <code>game.arcflight.installShipUpgrade(shipActor, upgradeItem)</code>.</p>
    {{/if}}
  </section>

  <section class="arcflight-sheet__section">
    <h2>Derived Summary</h2>
    <div class="arcflight-grid arcflight-grid--resources">
      <label class="arcflight-sheet__field"><span>Base Hull</span><input type="number" value="{{arcflight.system.base.hull.hullIntegrity}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Derived Hull</span><input type="number" value="{{arcflight.system.derived.hullIntegrity}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Base Lifeveil</span><input type="number" value="{{arcflight.system.base.hull.lifeveilCapacity}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Derived Lifeveil</span><input type="number" value="{{arcflight.system.derived.lifeveilCapacity}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Base Strain</span><input type="number" value="{{arcflight.system.base.hull.strainCapacity}}" disabled></label>
      <label class="arcflight-sheet__field"><span>Derived Strain</span><input type="number" value="{{arcflight.system.derived.strainCapacity}}" disabled></label>
    </div>
  </section>

  <section class="arcflight-sheet__section">
    <h2>Identity</h2>
    <label class="arcflight-sheet__field"><span>Vessel Class</span><input type="text" name="{{arcflightSystemPath}}.identity.vesselClass" value="{{arcflight.system.identity.vesselClass}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="arcflight-sheet__field"><span>Registry</span><input type="text" name="{{arcflightSystemPath}}.identity.registry" value="{{arcflight.system.identity.registry}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="arcflight-sheet__field"><span>Callsign</span><input type="text" name="{{arcflightSystemPath}}.identity.callsign" value="{{arcflight.system.identity.callsign}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="arcflight-sheet__field"><span>Owner</span><input type="text" name="{{arcflightSystemPath}}.identity.owner" value="{{arcflight.system.identity.owner}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="arcflight-sheet__field"><span>Origin</span><input type="text" name="{{arcflightSystemPath}}.identity.origin" value="{{arcflight.system.identity.origin}}" {{#unless editable}}disabled{{/unless}}></label>
  </section>

  <section class="arcflight-sheet__section">
    <h2>Installed Systems</h2>
    <label class="arcflight-sheet__field"><span>Hull</span><input type="text" name="{{arcflightSystemPath}}.installedSystems.hull" value="{{arcflight.system.installedSystems.hull}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="arcflight-sheet__field"><span>Arkengine</span><input type="text" name="{{arcflightSystemPath}}.installedSystems.arkengine" value="{{arcflight.system.installedSystems.arkengine}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="arcflight-sheet__field"><span>Weapons</span><input type="text" name="{{arcflightSystemPath}}.installedSystems.weapons" value="{{arcflight.system.installedSystems.weapons}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="arcflight-sheet__field"><span>Arkengine Mods</span><input type="text" name="{{arcflightSystemPath}}.installedSystems.arkengineMods" value="{{arcflight.system.installedSystems.arkengineMods}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="arcflight-sheet__field"><span>Rooms</span><input type="text" name="{{arcflightSystemPath}}.installedSystems.rooms" value="{{arcflight.system.installedSystems.rooms}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="arcflight-sheet__field"><span>Cargo</span><input type="text" name="{{arcflightSystemPath}}.installedSystems.cargo" value="{{arcflight.system.installedSystems.cargo}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="arcflight-sheet__field"><span>Crew Assets</span><input type="text" name="{{arcflightSystemPath}}.installedSystems.crewAssets" value="{{arcflight.system.installedSystems.crewAssets}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="arcflight-sheet__field"><span>Ship Upgrades</span><input type="text" name="{{arcflightSystemPath}}.installedSystems.shipUpgrades" value="{{arcflight.system.installedSystems.shipUpgrades}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="arcflight-sheet__field"><span>Installed Notes</span><textarea name="{{arcflightSystemPath}}.installedSystems.notes" rows="2" {{#unless editable}}disabled{{/unless}}>{{arcflight.system.installedSystems.notes}}</textarea></label>
  </section>

  <section class="arcflight-sheet__section">
    <h2>Current Resources Summary</h2>
    <div class="arcflight-grid arcflight-grid--resources">
      <label class="arcflight-sheet__field"><span>Current Hull</span><input type="number" name="{{arcflightSystemPath}}.current.hull" value="{{arcflight.system.current.hull}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Current Lifeveil</span><input type="number" name="{{arcflightSystemPath}}.current.lifeveil" value="{{arcflight.system.current.lifeveil}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Current Strain</span><input type="number" name="{{arcflightSystemPath}}.current.strain" value="{{arcflight.system.current.strain}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Current Morale</span><input type="number" name="{{arcflightSystemPath}}.current.morale" value="{{arcflight.system.current.morale}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Hull Value</span><input type="number" name="{{arcflightSystemPath}}.resources.hull.value" value="{{arcflight.system.resources.hull.value}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Hull Max</span><input type="number" name="{{arcflightSystemPath}}.resources.hull.max" value="{{arcflight.system.resources.hull.max}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Lifeveil Value</span><input type="number" name="{{arcflightSystemPath}}.resources.lifeveil.value" value="{{arcflight.system.resources.lifeveil.value}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Lifeveil Max</span><input type="number" name="{{arcflightSystemPath}}.resources.lifeveil.max" value="{{arcflight.system.resources.lifeveil.max}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Strain Value</span><input type="number" name="{{arcflightSystemPath}}.resources.strain.value" value="{{arcflight.system.resources.strain.value}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Strain Max</span><input type="number" name="{{arcflightSystemPath}}.resources.strain.max" value="{{arcflight.system.resources.strain.max}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Supplies</span><input type="number" name="{{arcflightSystemPath}}.resources.supplies" value="{{arcflight.system.resources.supplies}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Morale</span><input type="number" name="{{arcflightSystemPath}}.resources.morale" value="{{arcflight.system.resources.morale}}" {{#unless editable}}disabled{{/unless}}></label>
    </div>
    <label class="arcflight-sheet__field"><span>Resource Notes</span><textarea name="{{arcflightSystemPath}}.resources.notes" rows="2" {{#unless editable}}disabled{{/unless}}>{{arcflight.system.resources.notes}}</textarea></label>
  </section>

  <section class="arcflight-sheet__section">
    <h2>Derived Stats</h2>
    <div class="arcflight-grid arcflight-grid--ship-values">
      <label class="arcflight-sheet__field"><span>Speed</span><input type="number" name="{{arcflightSystemPath}}.derivedStats.speed" value="{{arcflight.system.derivedStats.speed}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Handling</span><input type="number" name="{{arcflightSystemPath}}.derivedStats.handling" value="{{arcflight.system.derivedStats.handling}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Crew Capacity</span><input type="number" name="{{arcflightSystemPath}}.derivedStats.crewCapacity" value="{{arcflight.system.derivedStats.crewCapacity}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Cargo Capacity</span><input type="number" name="{{arcflightSystemPath}}.derivedStats.cargoCapacity" value="{{arcflight.system.derivedStats.cargoCapacity}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Weapon Mounts</span><input type="number" name="{{arcflightSystemPath}}.derivedStats.weaponMounts" value="{{arcflight.system.derivedStats.weaponMounts}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Room Slots</span><input type="number" name="{{arcflightSystemPath}}.derivedStats.roomSlots" value="{{arcflight.system.derivedStats.roomSlots}}" {{#unless editable}}disabled{{/unless}}></label>
    </div>
    <label class="arcflight-sheet__field"><span>Derived Notes</span><textarea name="{{arcflightSystemPath}}.derivedStats.notes" rows="2" {{#unless editable}}disabled{{/unless}}>{{arcflight.system.derivedStats.notes}}</textarea></label>
  </section>

  <section class="arcflight-sheet__section">
    <h2>Crew</h2>
    <p class="arcflight-sheet__hint">Generic crew is a simple number. Named Crew Assets are meaningful specialists copied into this ship roster by <code>game.arcflight.addCrewAsset(shipActor, crewItem)</code>; source Crew Asset items remain immutable.</p>
    <div class="arcflight-grid arcflight-grid--ship-values">
      <label class="arcflight-sheet__field"><span>Minimum</span><input type="number" name="{{arcflightSystemPath}}.crew.minimum" value="{{arcflight.system.crew.minimum}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Recommended</span><input type="number" name="{{arcflightSystemPath}}.crew.recommended" value="{{arcflight.system.crew.recommended}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Maximum</span><input type="number" name="{{arcflightSystemPath}}.crew.maximum" value="{{arcflight.system.crew.maximum}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Current Generic Crew</span><input type="number" name="{{arcflightSystemPath}}.crew.currentGenericCrew" value="{{arcflight.system.crew.currentGenericCrew}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="arcflight-sheet__field"><span>Legacy Current</span><input type="number" name="{{arcflightSystemPath}}.crew.current" value="{{arcflight.system.crew.current}}" {{#unless editable}}disabled{{/unless}}></label>
    </div>
    {{#if arcflight.system.crew.namedCrew.length}}
      <ul>
        {{#each arcflight.system.crew.namedCrew}}
          <li><strong>{{this.displayName}}</strong> — {{this.identity.role}}; {{this.crew.quality}}; preferred Station: {{this.stationAssignment.preferredStation}}</li>
        {{/each}}
      </ul>
    {{else}}
      <p class="arcflight-sheet__hint">No crew assets assigned.</p>
    {{/if}}
    <label class="arcflight-sheet__field"><span>Roster</span><textarea name="{{arcflightSystemPath}}.crew.roster" rows="2" {{#unless editable}}disabled{{/unless}}>{{arcflight.system.crew.roster}}</textarea></label>
    <label class="arcflight-sheet__field"><span>Crew Notes</span><textarea name="{{arcflightSystemPath}}.crew.notes" rows="2" {{#unless editable}}disabled{{/unless}}>{{arcflight.system.crew.notes}}</textarea></label>
  </section>

  <section class="arcflight-sheet__section">
    <h2>Cargo</h2>
    <label class="arcflight-sheet__field"><span>Capacity</span><input type="number" name="{{arcflightSystemPath}}.cargo.capacity" value="{{arcflight.system.cargo.capacity}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="arcflight-sheet__field"><span>Used</span><input type="number" name="{{arcflightSystemPath}}.cargo.used" value="{{arcflight.system.cargo.used}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="arcflight-sheet__field"><span>Manifest</span><textarea name="{{arcflightSystemPath}}.cargo.manifest" rows="2" {{#unless editable}}disabled{{/unless}}>{{arcflight.system.cargo.manifest}}</textarea></label>
    <label class="arcflight-sheet__field"><span>Cargo Notes</span><textarea name="{{arcflightSystemPath}}.cargo.notes" rows="2" {{#unless editable}}disabled{{/unless}}>{{arcflight.system.cargo.notes}}</textarea></label>
  </section>

  <section class="arcflight-sheet__section">
    <h2>Conditions</h2>
    <label class="arcflight-sheet__field"><span>Active Conditions</span><textarea name="{{arcflightSystemPath}}.conditions.active" rows="2" {{#unless editable}}disabled{{/unless}}>{{arcflight.system.conditions.active}}</textarea></label>
    <label class="arcflight-sheet__field"><span>Damage</span><textarea name="{{arcflightSystemPath}}.conditions.damage" rows="2" {{#unless editable}}disabled{{/unless}}>{{arcflight.system.conditions.damage}}</textarea></label>
    <label class="arcflight-sheet__field"><span>Condition Notes</span><textarea name="{{arcflightSystemPath}}.conditions.notes" rows="2" {{#unless editable}}disabled{{/unless}}>{{arcflight.system.conditions.notes}}</textarea></label>
  </section>

  <section class="arcflight-sheet__section">
    <h2>State</h2>
    <label class="arcflight-sheet__field arcflight-sheet__field--checkbox"><input type="checkbox" name="{{arcflightSystemPath}}.state.active" {{#if arcflight.system.state.active}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>Active</span></label>
    <label class="arcflight-sheet__field arcflight-sheet__field--checkbox"><input type="checkbox" name="{{arcflightSystemPath}}.state.docked" {{#if arcflight.system.state.docked}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>Docked</span></label>
    <label class="arcflight-sheet__field arcflight-sheet__field--checkbox"><input type="checkbox" name="{{arcflightSystemPath}}.state.disabled" {{#if arcflight.system.state.disabled}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>Disabled</span></label>
    <label class="arcflight-sheet__field"><span>Location</span><input type="text" name="{{arcflightSystemPath}}.state.location" value="{{arcflight.system.state.location}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="arcflight-sheet__field"><span>Status</span><input type="text" name="{{arcflightSystemPath}}.state.status" value="{{arcflight.system.state.status}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="arcflight-sheet__field"><span>State Notes</span><textarea name="{{arcflightSystemPath}}.state.notes" rows="2" {{#unless editable}}disabled{{/unless}}>{{arcflight.system.state.notes}}</textarea></label>
  </section>

  <section class="arcflight-sheet__section">
    <h2>History</h2>
    <label class="arcflight-sheet__field"><span>Commissioned</span><input type="text" name="{{arcflightSystemPath}}.history.commissioned" value="{{arcflight.system.history.commissioned}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="arcflight-sheet__field"><span>Previous Owners</span><textarea name="{{arcflightSystemPath}}.history.previousOwners" rows="2" {{#unless editable}}disabled{{/unless}}>{{arcflight.system.history.previousOwners}}</textarea></label>
    <label class="arcflight-sheet__field"><span>Notable Events</span><textarea name="{{arcflightSystemPath}}.history.notableEvents" rows="2" {{#unless editable}}disabled{{/unless}}>{{arcflight.system.history.notableEvents}}</textarea></label>
    <label class="arcflight-sheet__field"><span>History Notes</span><textarea name="{{arcflightSystemPath}}.history.notes" rows="2" {{#unless editable}}disabled{{/unless}}>{{arcflight.system.history.notes}}</textarea></label>
  </section>

  <section class="arcflight-sheet__section">
    <h2>Notes</h2>
    <label class="arcflight-sheet__field"><span>Ship Notes</span><textarea name="{{arcflightSystemPath}}.notes" rows="4" {{#unless editable}}disabled{{/unless}}>{{arcflight.system.notes}}</textarea></label>
  </section>
  {{else}}
  <section class="arcflight-sheet__section">
    <h2>PF2E Vehicle</h2>
    <p class="arcflight-sheet__hint">This vehicle is not marked as an Arcflight ship. Use the button above to add Arcflight ship flags without changing PF2E vehicle system data.</p>
  </section>
  {{/if}}
  </div>
</section>
