<section class="arcflight-sheet arcflight-ship-sheet">
  <header class="arcflight-sheet__header">
    <img class="arcflight-sheet__image" src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" data-action="editImage">
    <label class="arcflight-sheet__field arcflight-sheet__field--grow">
      <span>Vehicle Name</span>
      <input type="text" name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="arcflight-sheet__field arcflight-sheet__field--checkbox">
      <span>Arcflight Enabled</span>
      <input type="checkbox" name="flags.arcflight.enabled" {{checked arcflight.enabled}} {{#unless editable}}disabled{{/unless}}>
    </label>
  </header>

  <section class="arcflight-sheet__section">
    <h2>Ship Resources</h2>
    <div class="arcflight-grid arcflight-grid--resources">
      <label class="arcflight-sheet__field">
        <span>Hull Value</span>
        <input type="number" name="flags.arcflight.resources.hull.value" value="{{arcflight.resources.hull.value}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="arcflight-sheet__field">
        <span>Hull Max</span>
        <input type="number" name="flags.arcflight.resources.hull.max" value="{{arcflight.resources.hull.max}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="arcflight-sheet__field">
        <span>Lifeveil Value</span>
        <input type="number" name="flags.arcflight.resources.lifeveil.value" value="{{arcflight.resources.lifeveil.value}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="arcflight-sheet__field">
        <span>Lifeveil Max</span>
        <input type="number" name="flags.arcflight.resources.lifeveil.max" value="{{arcflight.resources.lifeveil.max}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="arcflight-sheet__field">
        <span>Strain Value</span>
        <input type="number" name="flags.arcflight.resources.strain.value" value="{{arcflight.resources.strain.value}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="arcflight-sheet__field">
        <span>Strain Max</span>
        <input type="number" name="flags.arcflight.resources.strain.max" value="{{arcflight.resources.strain.max}}" {{#unless editable}}disabled{{/unless}}>
      </label>
    </div>
  </section>

  <section class="arcflight-sheet__section">
    <h2>Ship Values</h2>
    <div class="arcflight-grid arcflight-grid--ship-values">
      <label class="arcflight-sheet__field">
        <span>Morale</span>
        <input type="number" name="flags.arcflight.morale" value="{{arcflight.morale}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="arcflight-sheet__field">
        <span>Supplies</span>
        <input type="number" name="flags.arcflight.supplies" value="{{arcflight.supplies}}" {{#unless editable}}disabled{{/unless}}>
      </label>
    </div>
  </section>

  <section class="arcflight-sheet__section">
    <h2>Installed Placeholders</h2>
    <div class="arcflight-installed">
      <article>
        <h3>Hull</h3>
        <p>{{#if installed.hull}}{{installed.hull}}{{else}}No hull installed.{{/if}}</p>
      </article>
      <article>
        <h3>Arkengine</h3>
        <p>{{#if installed.arkengine}}{{installed.arkengine}}{{else}}No arkengine installed.{{/if}}</p>
      </article>
      <article>
        <h3>Weapons</h3>
        <ul>
          {{#each installed.weapons}}
            <li>{{this}}</li>
          {{else}}
            <li>No weapons installed.</li>
          {{/each}}
        </ul>
      </article>
      <article>
        <h3>Rooms</h3>
        <ul>
          {{#each installed.rooms}}
            <li>{{this}}</li>
          {{else}}
            <li>No rooms installed.</li>
          {{/each}}
        </ul>
      </article>
      <article>
        <h3>Upgrades</h3>
        <ul>
          {{#each installed.upgrades}}
            <li>{{this}}</li>
          {{else}}
            <li>No upgrades installed.</li>
          {{/each}}
        </ul>
      </article>
    </div>
  </section>
</section>
