<section class="arcflight-sheet arcflight-item-sheet">
  <header class="arcflight-sheet__header">
    <img class="arcflight-sheet__image" src="{{item.img}}" alt="{{item.name}}" data-edit="img" data-action="editImage">
    <div class="arcflight-sheet__identity">
      <label class="arcflight-sheet__field arcflight-sheet__field--grow">
        <span>Name</span>
        <input type="text" name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <p class="arcflight-sheet__type">PF2E equipment{{#if arcflightEnabled}} · Arcflight {{componentTypeLabel}}{{/if}}</p>
    </div>
  </header>

  <div class="arcflight-sheet__body">
  {{#unless arcflightEnabled}}
    <section class="arcflight-sheet__section">
      <h2>PF2E Equipment</h2>
      <p class="arcflight-sheet__hint">This equipment item is not an Arcflight component.</p>
      <label class="arcflight-sheet__field">
        <span>Component Type</span>
        <select data-arcflight-component-type {{#unless editable}}disabled{{/unless}}>
          {{#each componentTypeOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <button type="button" data-arcflight-convert-component {{#unless editable}}disabled{{/unless}}>
        Convert to Arcflight Component
      </button>
    </section>
  {{else}}
    <section class="arcflight-sheet__section">
      <h2>{{componentTypeLabel}}</h2>
      <p class="arcflight-sheet__hint">Display name: <strong>{{componentDisplayName}}</strong>. Arcflight component data is stored in flags; PF2E equipment system data remains owned by PF2E.</p>
      <label class="arcflight-sheet__field">
        <span>Component Type</span>
        <input type="text" value="{{componentTypeLabel}}" disabled>
      </label>
      {{#unless usesLockedPhaseOneSchema}}
        <label class="arcflight-sheet__field">
          <span>Tags</span>
          <input type="text" name="{{arcflightFlagPath}}.tags" value="{{componentData.tags}}" {{#unless editable}}disabled{{/unless}}>
        </label>
        <label class="arcflight-sheet__field">
          <span>Traits</span>
          <input type="text" name="{{arcflightFlagPath}}.traits" value="{{componentData.traits}}" {{#unless editable}}disabled{{/unless}}>
        </label>
        <label class="arcflight-sheet__field">
          <span>Source</span>
          <input type="text" name="{{arcflightFlagPath}}.source" value="{{componentData.source}}" {{#unless editable}}disabled{{/unless}}>
        </label>
        <label class="arcflight-sheet__field">
          <span>Notes</span>
          <textarea name="{{arcflightFlagPath}}.notes" rows="4" {{#unless editable}}disabled{{/unless}}>{{componentData.notes}}</textarea>
        </label>
      {{/unless}}
    </section>

    {{#if isHull}}
      <section class="arcflight-sheet__section">
        <h2>Hull</h2>
        <h3>Platform</h3>
        <label class="arcflight-sheet__field"><span>Display Name</span><input type="text" name="{{arcflightFlagPath}}.displayName" value="{{componentData.displayName}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Platform Key</span><input type="text" name="{{arcflightFlagPath}}.platform" value="{{componentData.platform}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Role</span><textarea name="{{arcflightFlagPath}}.role" rows="2" {{#unless editable}}disabled{{/unless}}>{{componentData.role}}</textarea></label>

        <h3>Defenses and Capacity</h3>
        <div class="arcflight-grid arcflight-grid--hull-values">
          <label class="arcflight-sheet__field"><span>Hull Integrity</span><input type="number" name="{{arcflightFlagPath}}.hullIntegrity" value="{{componentData.hullIntegrity}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Armor Class</span><input type="number" name="{{arcflightFlagPath}}.armorClass" value="{{componentData.armorClass}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Strain Capacity</span><input type="number" name="{{arcflightFlagPath}}.strainCapacity" value="{{componentData.strainCapacity}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Lifeveil Capacity</span><input type="number" name="{{arcflightFlagPath}}.lifeveilCapacity" value="{{componentData.lifeveilCapacity}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Cargo Capacity</span><input type="number" name="{{arcflightFlagPath}}.cargoCapacity" value="{{componentData.cargoCapacity}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Detection</span><input type="number" name="{{arcflightFlagPath}}.detection" value="{{componentData.detection}}" {{#unless editable}}disabled{{/unless}}></label>
        </div>

        <h3>Physical Resistances</h3>
        <div class="arcflight-grid arcflight-grid--hull-values">
          <label class="arcflight-sheet__field"><span>Bludgeoning</span><input type="number" name="{{arcflightFlagPath}}.physicalResistances.bludgeoning" value="{{componentData.physicalResistances.bludgeoning}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Piercing</span><input type="number" name="{{arcflightFlagPath}}.physicalResistances.piercing" value="{{componentData.physicalResistances.piercing}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Slashing</span><input type="number" name="{{arcflightFlagPath}}.physicalResistances.slashing" value="{{componentData.physicalResistances.slashing}}" {{#unless editable}}disabled{{/unless}}></label>
        </div>

        <h3>Ship Action Baselines</h3>
        <div class="arcflight-grid arcflight-grid--hull-values">
          <label class="arcflight-sheet__field"><span>Combat Speed</span><input type="number" name="{{arcflightFlagPath}}.combatSpeed" value="{{componentData.combatSpeed}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Maneuverability</span><input type="number" name="{{arcflightFlagPath}}.maneuverability" value="{{componentData.maneuverability}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Base AP</span><input type="number" name="{{arcflightFlagPath}}.baseAP" value="{{componentData.baseAP}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Base RAP</span><input type="number" name="{{arcflightFlagPath}}.baseRAP" value="{{componentData.baseRAP}}" {{#unless editable}}disabled{{/unless}}></label>
        </div>

        <h3>Crew</h3>
        <div class="arcflight-grid arcflight-grid--hull-values">
          <label class="arcflight-sheet__field"><span>Minimum</span><input type="number" name="{{arcflightFlagPath}}.crew.minimum" value="{{componentData.crew.minimum}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Recommended</span><input type="number" name="{{arcflightFlagPath}}.crew.recommended" value="{{componentData.crew.recommended}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Maximum</span><input type="text" name="{{arcflightFlagPath}}.crew.maximum" value="{{componentData.crew.maximum}}" {{#unless editable}}disabled{{/unless}}></label>
        </div>

        <h3>Rooms</h3>
        <label class="arcflight-sheet__field"><span>Expansion Slots</span><input type="text" name="{{arcflightFlagPath}}.rooms.expansionSlots" value="{{componentData.rooms.expansionSlots}}" {{#unless editable}}disabled{{/unless}}></label>
        <div class="arcflight-system-list">
          <strong>Core Rooms</strong>
          {{#each componentData.rooms.coreRooms}}
            <label class="arcflight-sheet__field"><span>Core Room {{@index}}</span><input type="text" name="{{../arcflightFlagPath}}.rooms.coreRooms.{{@index}}" value="{{this}}" {{#unless ../editable}}disabled{{/unless}}></label>
          {{/each}}
        </div>

        <h3>Weapon Mounts</h3>
        <div class="arcflight-installed">
          <article>
            <h4>Fore</h4>
            {{#each componentData.weaponMounts.fore}}
              <label class="arcflight-sheet__field"><span>ID</span><input type="text" name="{{../arcflightFlagPath}}.weaponMounts.fore.{{@index}}.id" value="{{id}}" {{#unless ../editable}}disabled{{/unless}}></label>
              <label class="arcflight-sheet__field"><span>Max Size</span><input type="text" name="{{../arcflightFlagPath}}.weaponMounts.fore.{{@index}}.maxSize" value="{{maxSize}}" {{#unless ../editable}}disabled{{/unless}}></label>
              {{#each allowedSizes}}<label class="arcflight-sheet__field"><span>Allowed Size {{@index}}</span><input type="text" name="{{../../arcflightFlagPath}}.weaponMounts.fore.{{@../index}}.allowedSizes.{{@index}}" value="{{this}}" {{#unless ../../editable}}disabled{{/unless}}></label>{{/each}}
              <label class="arcflight-sheet__field arcflight-sheet__field--checkbox"><input type="checkbox" name="{{../arcflightFlagPath}}.weaponMounts.fore.{{@index}}.occupied" {{#if occupied}}checked{{/if}} {{#unless ../editable}}disabled{{/unless}}> <span>Occupied</span></label>
            {{/each}}
          </article>
          <article>
            <h4>Port</h4>
            {{#each componentData.weaponMounts.port}}
              <label class="arcflight-sheet__field"><span>ID</span><input type="text" name="{{../arcflightFlagPath}}.weaponMounts.port.{{@index}}.id" value="{{id}}" {{#unless ../editable}}disabled{{/unless}}></label>
              <label class="arcflight-sheet__field"><span>Max Size</span><input type="text" name="{{../arcflightFlagPath}}.weaponMounts.port.{{@index}}.maxSize" value="{{maxSize}}" {{#unless ../editable}}disabled{{/unless}}></label>
              {{#each allowedSizes}}<label class="arcflight-sheet__field"><span>Allowed Size {{@index}}</span><input type="text" name="{{../../arcflightFlagPath}}.weaponMounts.port.{{@../index}}.allowedSizes.{{@index}}" value="{{this}}" {{#unless ../../editable}}disabled{{/unless}}></label>{{/each}}
              <label class="arcflight-sheet__field arcflight-sheet__field--checkbox"><input type="checkbox" name="{{../arcflightFlagPath}}.weaponMounts.port.{{@index}}.occupied" {{#if occupied}}checked{{/if}} {{#unless ../editable}}disabled{{/unless}}> <span>Occupied</span></label>
            {{/each}}
          </article>
          <article>
            <h4>Starboard</h4>
            {{#each componentData.weaponMounts.starboard}}
              <label class="arcflight-sheet__field"><span>ID</span><input type="text" name="{{../arcflightFlagPath}}.weaponMounts.starboard.{{@index}}.id" value="{{id}}" {{#unless ../editable}}disabled{{/unless}}></label>
              <label class="arcflight-sheet__field"><span>Max Size</span><input type="text" name="{{../arcflightFlagPath}}.weaponMounts.starboard.{{@index}}.maxSize" value="{{maxSize}}" {{#unless ../editable}}disabled{{/unless}}></label>
              {{#each allowedSizes}}<label class="arcflight-sheet__field"><span>Allowed Size {{@index}}</span><input type="text" name="{{../../arcflightFlagPath}}.weaponMounts.starboard.{{@../index}}.allowedSizes.{{@index}}" value="{{this}}" {{#unless ../../editable}}disabled{{/unless}}></label>{{/each}}
              <label class="arcflight-sheet__field arcflight-sheet__field--checkbox"><input type="checkbox" name="{{../arcflightFlagPath}}.weaponMounts.starboard.{{@index}}.occupied" {{#if occupied}}checked{{/if}} {{#unless ../editable}}disabled{{/unless}}> <span>Occupied</span></label>
            {{/each}}
          </article>
          <article>
            <h4>Aft</h4>
            {{#each componentData.weaponMounts.aft}}
              <label class="arcflight-sheet__field"><span>ID</span><input type="text" name="{{../arcflightFlagPath}}.weaponMounts.aft.{{@index}}.id" value="{{id}}" {{#unless ../editable}}disabled{{/unless}}></label>
              <label class="arcflight-sheet__field"><span>Max Size</span><input type="text" name="{{../arcflightFlagPath}}.weaponMounts.aft.{{@index}}.maxSize" value="{{maxSize}}" {{#unless ../editable}}disabled{{/unless}}></label>
              {{#each allowedSizes}}<label class="arcflight-sheet__field"><span>Allowed Size {{@index}}</span><input type="text" name="{{../../arcflightFlagPath}}.weaponMounts.aft.{{@../index}}.allowedSizes.{{@index}}" value="{{this}}" {{#unless ../../editable}}disabled{{/unless}}></label>{{/each}}
              <label class="arcflight-sheet__field arcflight-sheet__field--checkbox"><input type="checkbox" name="{{../arcflightFlagPath}}.weaponMounts.aft.{{@index}}.occupied" {{#if occupied}}checked{{/if}} {{#unless ../editable}}disabled{{/unless}}> <span>Occupied</span></label>
            {{/each}}
          </article>
        </div>

        <h3>Arkengine Compatibility</h3>
        <label class="arcflight-sheet__field"><span>Preferred</span><input type="text" name="{{arcflightFlagPath}}.arkengineCompatibility.preferred" value="{{componentData.arkengineCompatibility.preferred}}" {{#unless editable}}disabled{{/unless}}></label>
        <div class="arcflight-system-list">
          <strong>Allowed Arkengines</strong>
          {{#each componentData.arkengineCompatibility.allowed}}
            <label class="arcflight-sheet__field"><span>Allowed {{@index}}</span><input type="text" name="{{../arcflightFlagPath}}.arkengineCompatibility.allowed.{{@index}}" value="{{this}}" {{#unless ../editable}}disabled{{/unless}}></label>
          {{/each}}
        </div>

        <h3>Traits and Notes</h3>
        <div class="arcflight-system-list">
          <strong>Traits</strong>
          {{#each componentData.traits}}
            <label class="arcflight-sheet__field"><span>Trait {{@index}}</span><input type="text" name="{{../arcflightFlagPath}}.traits.{{@index}}" value="{{this}}" {{#unless ../editable}}disabled{{/unless}}></label>
          {{/each}}
        </div>
        <label class="arcflight-sheet__field"><span>Design Notes</span><textarea name="{{arcflightFlagPath}}.designNotes" rows="3" {{#unless editable}}disabled{{/unless}}>{{componentData.designNotes}}</textarea></label>
      </section>
    {{/if}}

    {{#if isArkengine}}
      <section class="arcflight-sheet__section">
        <h2>Arkengine</h2>
        <h3>Identity</h3>
        <label class="arcflight-sheet__field"><span>Class</span><input type="text" list="arcflight-arkengine-classes" name="{{arcflightFlagPath}}.identity.engineClass" value="{{componentData.identity.engineClass}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Model</span><input type="text" name="{{arcflightFlagPath}}.identity.model" value="{{componentData.identity.model}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Manufacturer</span><input type="text" name="{{arcflightFlagPath}}.identity.manufacturer" value="{{componentData.identity.manufacturer}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Grade</span><input type="text" name="{{arcflightFlagPath}}.identity.grade" value="{{componentData.identity.grade}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Spell Rank Requirement</span><input type="number" name="{{arcflightFlagPath}}.identity.spellRankRequirement" value="{{componentData.identity.spellRankRequirement}}" {{#unless editable}}disabled{{/unless}}></label>

        <h3>Fueling</h3>
        <label class="arcflight-sheet__field"><span>Fuel Type</span><input type="text" name="{{arcflightFlagPath}}.fueling.fuelType" value="{{componentData.fueling.fuelType}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Fuel Capacity</span><input type="number" name="{{arcflightFlagPath}}.fueling.fuelCapacity" value="{{componentData.fueling.fuelCapacity}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Fuel Current</span><input type="number" name="{{arcflightFlagPath}}.fueling.fuelCurrent" value="{{componentData.fueling.fuelCurrent}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Consumption</span><input type="text" name="{{arcflightFlagPath}}.fueling.consumption" value="{{componentData.fueling.consumption}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Refuel Notes</span><textarea name="{{arcflightFlagPath}}.fueling.refuelNotes" rows="2" {{#unless editable}}disabled{{/unless}}>{{componentData.fueling.refuelNotes}}</textarea></label>

        <h3>Voyage</h3>
        <label class="arcflight-sheet__field"><span>Rating</span><input type="number" name="{{arcflightFlagPath}}.voyage.rating" value="{{componentData.voyage.rating}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Speed</span><input type="text" name="{{arcflightFlagPath}}.voyage.speed" value="{{componentData.voyage.speed}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Endurance</span><input type="text" name="{{arcflightFlagPath}}.voyage.endurance" value="{{componentData.voyage.endurance}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Navigation Notes</span><textarea name="{{arcflightFlagPath}}.voyage.navigationNotes" rows="2" {{#unless editable}}disabled{{/unless}}>{{componentData.voyage.navigationNotes}}</textarea></label>

        <h3>Lifeveil</h3>
        <label class="arcflight-sheet__field"><span>Output</span><input type="number" name="{{arcflightFlagPath}}.lifeveil.output" value="{{componentData.lifeveil.output}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Stability</span><input type="number" name="{{arcflightFlagPath}}.lifeveil.stability" value="{{componentData.lifeveil.stability}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Supported Crew</span><input type="number" name="{{arcflightFlagPath}}.lifeveil.supportedCrew" value="{{componentData.lifeveil.supportedCrew}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Lifeveil Notes</span><textarea name="{{arcflightFlagPath}}.lifeveil.notes" rows="2" {{#unless editable}}disabled{{/unless}}>{{componentData.lifeveil.notes}}</textarea></label>

        <h3>Strain</h3>
        <label class="arcflight-sheet__field"><span>Capacity</span><input type="number" name="{{arcflightFlagPath}}.strain.capacity" value="{{componentData.strain.capacity}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Current</span><input type="number" name="{{arcflightFlagPath}}.strain.current" value="{{componentData.strain.current}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Recovery</span><input type="text" name="{{arcflightFlagPath}}.strain.recovery" value="{{componentData.strain.recovery}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Threshold Notes</span><textarea name="{{arcflightFlagPath}}.strain.thresholdNotes" rows="2" {{#unless editable}}disabled{{/unless}}>{{componentData.strain.thresholdNotes}}</textarea></label>

        <h3>Overcharge</h3>
        <label class="arcflight-sheet__field arcflight-sheet__field--checkbox"><input type="checkbox" name="{{arcflightFlagPath}}.overcharge.enabled" {{#if componentData.overcharge.enabled}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>Overcharge Enabled</span></label>
        <label class="arcflight-sheet__field"><span>Limit</span><input type="number" name="{{arcflightFlagPath}}.overcharge.limit" value="{{componentData.overcharge.limit}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Risk</span><input type="text" name="{{arcflightFlagPath}}.overcharge.risk" value="{{componentData.overcharge.risk}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Overcharge Notes</span><textarea name="{{arcflightFlagPath}}.overcharge.notes" rows="2" {{#unless editable}}disabled{{/unless}}>{{componentData.overcharge.notes}}</textarea></label>

        <h3>Mods</h3>
        <label class="arcflight-sheet__field"><span>Slots</span><input type="number" name="{{arcflightFlagPath}}.mods.slots" value="{{componentData.mods.slots}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Installed</span><input type="text" name="{{arcflightFlagPath}}.mods.installed" value="{{componentData.mods.installed}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Mod Notes</span><textarea name="{{arcflightFlagPath}}.mods.notes" rows="2" {{#unless editable}}disabled{{/unless}}>{{componentData.mods.notes}}</textarea></label>

        <h3>Subsystems</h3>
        <label class="arcflight-sheet__field"><span>Conduits</span><input type="text" name="{{arcflightFlagPath}}.subsystems.conduits" value="{{componentData.subsystems.conduits}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Stabilizers</span><input type="text" name="{{arcflightFlagPath}}.subsystems.stabilizers" value="{{componentData.subsystems.stabilizers}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Regulators</span><input type="text" name="{{arcflightFlagPath}}.subsystems.regulators" value="{{componentData.subsystems.regulators}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Subsystem Notes</span><textarea name="{{arcflightFlagPath}}.subsystems.notes" rows="2" {{#unless editable}}disabled{{/unless}}>{{componentData.subsystems.notes}}</textarea></label>

        <h3>Traits and Notes</h3>
        <label class="arcflight-sheet__field"><span>Arkengine Traits</span><input type="text" name="{{arcflightFlagPath}}.traits" value="{{componentData.traits}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Arkengine Notes</span><textarea name="{{arcflightFlagPath}}.notes" rows="3" {{#unless editable}}disabled{{/unless}}>{{componentData.notes}}</textarea></label>
      </section>
    {{/if}}

    {{#if isArkengineMod}}
      <section class="arcflight-sheet__section">
        <h2>Arkengine Mod</h2>
        <p class="arcflight-sheet__hint">Arkengine Mods are engine-only tuning components. They are separate from Ship Upgrades and do not resolve overcharge, hard burn, travel, or combat gameplay on this sheet.</p>
        <h3>Identity</h3>
        <label class="arcflight-sheet__field"><span>Mod Category</span><input type="text" name="{{arcflightFlagPath}}.identity.modCategory" value="{{componentData.identity.modCategory}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Model</span><input type="text" name="{{arcflightFlagPath}}.identity.model" value="{{componentData.identity.model}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Manufacturer</span><input type="text" name="{{arcflightFlagPath}}.identity.manufacturer" value="{{componentData.identity.manufacturer}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Grade</span><input type="text" name="{{arcflightFlagPath}}.identity.grade" value="{{componentData.identity.grade}}" {{#unless editable}}disabled{{/unless}}></label>

        <h3>Installation</h3>
        <label class="arcflight-sheet__field arcflight-sheet__field--checkbox"><input type="checkbox" name="{{arcflightFlagPath}}.installation.installed" {{#if componentData.installation.installed}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>Installed</span></label>
        <label class="arcflight-sheet__field"><span>Installed On</span><input type="text" name="{{arcflightFlagPath}}.installation.installedOn" value="{{componentData.installation.installedOn}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Slot</span><input type="text" name="{{arcflightFlagPath}}.installation.slot" value="{{componentData.installation.slot}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Requirements</span><input type="text" name="{{arcflightFlagPath}}.installation.requirements" value="{{componentData.installation.requirements}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Installation Notes</span><textarea name="{{arcflightFlagPath}}.installation.notes" rows="2" {{#unless editable}}disabled{{/unless}}>{{componentData.installation.notes}}</textarea></label>

        <h3>Compatibility</h3>
        <label class="arcflight-sheet__field"><span>Engine Classes</span><input type="text" name="{{arcflightFlagPath}}.compatibility.engineClasses" value="{{componentData.compatibility.engineClasses}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Engines</span><input type="text" name="{{arcflightFlagPath}}.compatibility.engines" value="{{componentData.compatibility.engines}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Hulls</span><input type="text" name="{{arcflightFlagPath}}.compatibility.hulls" value="{{componentData.compatibility.hulls}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Restrictions</span><input type="text" name="{{arcflightFlagPath}}.compatibility.restrictions" value="{{componentData.compatibility.restrictions}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Compatibility Notes</span><textarea name="{{arcflightFlagPath}}.compatibility.notes" rows="2" {{#unless editable}}disabled{{/unless}}>{{componentData.compatibility.notes}}</textarea></label>

        <h3>Effect Stat Modifiers</h3>
        <label class="arcflight-sheet__field"><span>Hull Integrity</span><input type="number" name="{{arcflightFlagPath}}.effects.statModifiers.hullIntegrity" value="{{componentData.effects.statModifiers.hullIntegrity}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Lifeveil</span><input type="number" name="{{arcflightFlagPath}}.effects.statModifiers.lifeveil" value="{{componentData.effects.statModifiers.lifeveil}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Crew Limits</span><input type="number" name="{{arcflightFlagPath}}.effects.statModifiers.crewLimits" value="{{componentData.effects.statModifiers.crewLimits}}" {{#unless editable}}disabled{{/unless}}></label>
