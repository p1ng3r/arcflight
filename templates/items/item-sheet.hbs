<section class="arcflight-sheet arcflight-item-sheet">
  <header class="arcflight-sheet__header">
    <img class="arcflight-sheet__image" src="{{item.img}}" alt="{{item.name}}" data-edit="img" data-action="editImage">
    <div class="arcflight-sheet__identity">
      <label class="arcflight-sheet__field arcflight-sheet__field--grow">
        <span>Name</span>
        <input type="text" name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <p class="arcflight-sheet__type">PF2E equipment{{#if arcflightEnabled}} · Arcflight {{componentType}}{{/if}}</p>
    </div>
  </header>

  {{#unless arcflightEnabled}}
    <section class="arcflight-sheet__section">
      <h2>PF2E Equipment</h2>
      <p class="arcflight-sheet__hint">This equipment item is not an Arcflight component.</p>
      <label class="arcflight-sheet__field">
        <span>Component Type</span>
        <select data-arcflight-component-type {{#unless editable}}disabled{{/unless}}>
          {{#each componentTypeOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <button type="button" data-arcflight-convert-component {{#unless editable}}disabled{{/unless}}>
        Convert to Arcflight Component
      </button>
    </section>
  {{else}}
    <section class="arcflight-sheet__section">
      <h2>Common Component Data</h2>
      <label class="arcflight-sheet__field">
        <span>Component Type</span>
        <input type="text" name="flags.arcflight.componentType" value="{{componentType}}" disabled>
      </label>
      <label class="arcflight-sheet__field">
        <span>Tags</span>
        <input type="text" name="{{arcflightFlagPath}}.tags" value="{{componentData.tags}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="arcflight-sheet__field">
        <span>Traits</span>
        <input type="text" name="{{arcflightFlagPath}}.traits" value="{{componentData.traits}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="arcflight-sheet__field">
        <span>Source</span>
        <input type="text" name="{{arcflightFlagPath}}.source" value="{{componentData.source}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      {{#unless isHull}}
        <label class="arcflight-sheet__field">
          <span>Notes</span>
          <textarea name="{{arcflightFlagPath}}.notes" rows="4" {{#unless editable}}disabled{{/unless}}>{{componentData.notes}}</textarea>
        </label>
      {{/unless}}
    </section>

    {{#if isHull}}
      <section class="arcflight-sheet__section">
        <h2>Hull Identity</h2>
        <div class="arcflight-grid arcflight-grid--two-column">
          <label class="arcflight-sheet__field"><span>Platform</span><input type="text" name="{{arcflightFlagPath}}.identity.platform" value="{{componentData.identity.platform}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Display Name</span><input type="text" name="{{arcflightFlagPath}}.identity.displayName" value="{{componentData.identity.displayName}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Size Category</span><input type="text" name="{{arcflightFlagPath}}.identity.sizeCategory" value="{{componentData.identity.sizeCategory}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Role</span><input type="text" name="{{arcflightFlagPath}}.identity.role" value="{{componentData.identity.role}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Rarity</span><input type="text" name="{{arcflightFlagPath}}.identity.rarity" value="{{componentData.identity.rarity}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Origin</span><input type="text" name="{{arcflightFlagPath}}.identity.origin" value="{{componentData.identity.origin}}" {{#unless editable}}disabled{{/unless}}></label>
        </div>
        <label class="arcflight-sheet__field"><span>Description</span><textarea name="{{arcflightFlagPath}}.identity.description" rows="4" {{#unless editable}}disabled{{/unless}}>{{componentData.identity.description}}</textarea></label>
      </section>

      <section class="arcflight-sheet__section">
        <h2>Hull Core Stats</h2>
        <div class="arcflight-grid arcflight-grid--two-column">
          <label class="arcflight-sheet__field"><span>Hull Integrity</span><input type="number" name="{{arcflightFlagPath}}.coreStats.hullIntegrity" value="{{componentData.coreStats.hullIntegrity}}" data-dtype="Number" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Armor Class</span><input type="number" name="{{arcflightFlagPath}}.coreStats.armorClass" value="{{componentData.coreStats.armorClass}}" data-dtype="Number" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Bludgeoning Resistance</span><input type="number" name="{{arcflightFlagPath}}.coreStats.physicalResistances.bludgeoning" value="{{componentData.coreStats.physicalResistances.bludgeoning}}" data-dtype="Number" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Piercing Resistance</span><input type="number" name="{{arcflightFlagPath}}.coreStats.physicalResistances.piercing" value="{{componentData.coreStats.physicalResistances.piercing}}" data-dtype="Number" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Slashing Resistance</span><input type="number" name="{{arcflightFlagPath}}.coreStats.physicalResistances.slashing" value="{{componentData.coreStats.physicalResistances.slashing}}" data-dtype="Number" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Strain Capacity</span><input type="number" name="{{arcflightFlagPath}}.coreStats.strainCapacity" value="{{componentData.coreStats.strainCapacity}}" data-dtype="Number" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Lifeveil Capacity</span><input type="number" name="{{arcflightFlagPath}}.coreStats.lifeveilCapacity" value="{{componentData.coreStats.lifeveilCapacity}}" data-dtype="Number" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Cargo Capacity</span><input type="number" name="{{arcflightFlagPath}}.coreStats.cargoCapacity" value="{{componentData.coreStats.cargoCapacity}}" data-dtype="Number" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Detection</span><input type="text" name="{{arcflightFlagPath}}.coreStats.detection" value="{{componentData.coreStats.detection}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Combat Speed</span><input type="text" name="{{arcflightFlagPath}}.coreStats.combatSpeed" value="{{componentData.coreStats.combatSpeed}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Maneuverability</span><input type="text" name="{{arcflightFlagPath}}.coreStats.maneuverability" value="{{componentData.coreStats.maneuverability}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Base AP</span><input type="number" name="{{arcflightFlagPath}}.coreStats.baseAP" value="{{componentData.coreStats.baseAP}}" data-dtype="Number" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Base RAP</span><input type="number" name="{{arcflightFlagPath}}.coreStats.baseRAP" value="{{componentData.coreStats.baseRAP}}" data-dtype="Number" {{#unless editable}}disabled{{/unless}}></label>
        </div>
      </section>

      <section class="arcflight-sheet__section">
        <h2>Crew, Rooms, and Mounts</h2>
        <div class="arcflight-grid arcflight-grid--two-column">
          <label class="arcflight-sheet__field"><span>Minimum Crew</span><input type="number" name="{{arcflightFlagPath}}.crew.minimum" value="{{componentData.crew.minimum}}" data-dtype="Number" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Recommended Crew</span><input type="number" name="{{arcflightFlagPath}}.crew.recommended" value="{{componentData.crew.recommended}}" data-dtype="Number" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Maximum Crew</span><input type="number" name="{{arcflightFlagPath}}.crew.maximum" value="{{componentData.crew.maximum}}" data-dtype="Number" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Core Rooms</span><input type="text" name="{{arcflightFlagPath}}.rooms.coreRooms" value="{{componentData.rooms.coreRooms}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Expansion Slots</span><input type="text" name="{{arcflightFlagPath}}.rooms.expansionSlots" value="{{componentData.rooms.expansionSlots}}" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Fore Mounts</span><input type="number" name="{{arcflightFlagPath}}.weaponMounts.fore" value="{{componentData.weaponMounts.fore}}" data-dtype="Number" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Port Mounts</span><input type="number" name="{{arcflightFlagPath}}.weaponMounts.port" value="{{componentData.weaponMounts.port}}" data-dtype="Number" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Starboard Mounts</span><input type="number" name="{{arcflightFlagPath}}.weaponMounts.starboard" value="{{componentData.weaponMounts.starboard}}" data-dtype="Number" {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field"><span>Aft Mounts</span><input type="number" name="{{arcflightFlagPath}}.weaponMounts.aft" value="{{componentData.weaponMounts.aft}}" data-dtype="Number" {{#unless editable}}disabled{{/unless}}></label>
        </div>
      </section>

      <section class="arcflight-sheet__section">
        <h2>Compatibility, Rules, and Notes</h2>
        <label class="arcflight-sheet__field"><span>Preferred Arkengine</span><input type="text" name="{{arcflightFlagPath}}.arkengineCompatibility.preferred" value="{{componentData.arkengineCompatibility.preferred}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Allowed Arkengines</span><input type="text" name="{{arcflightFlagPath}}.arkengineCompatibility.allowed" value="{{componentData.arkengineCompatibility.allowed}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Arkengine Notes</span><textarea name="{{arcflightFlagPath}}.arkengineCompatibility.notes" rows="3" {{#unless editable}}disabled{{/unless}}>{{componentData.arkengineCompatibility.notes}}</textarea></label>
        <div class="arcflight-grid arcflight-grid--two-column">
          <label class="arcflight-sheet__field arcflight-sheet__field--checkbox"><span>Can Operate Below Minimum Crew</span><input type="hidden" name="{{arcflightFlagPath}}.rules.canOperateBelowMinimumCrew" value="false" data-dtype="Boolean"><input type="checkbox" name="{{arcflightFlagPath}}.rules.canOperateBelowMinimumCrew" value="true" data-dtype="Boolean" {{checked componentData.rules.canOperateBelowMinimumCrew}} {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field arcflight-sheet__field--checkbox"><span>Uses General Expansion Slots Only</span><input type="hidden" name="{{arcflightFlagPath}}.rules.usesGeneralExpansionSlotsOnly" value="false" data-dtype="Boolean"><input type="checkbox" name="{{arcflightFlagPath}}.rules.usesGeneralExpansionSlotsOnly" value="true" data-dtype="Boolean" {{checked componentData.rules.usesGeneralExpansionSlotsOnly}} {{#unless editable}}disabled{{/unless}}></label>
          <label class="arcflight-sheet__field arcflight-sheet__field--checkbox"><span>One Room Per Expansion Slot</span><input type="hidden" name="{{arcflightFlagPath}}.rules.oneRoomPerExpansionSlot" value="false" data-dtype="Boolean"><input type="checkbox" name="{{arcflightFlagPath}}.rules.oneRoomPerExpansionSlot" value="true" data-dtype="Boolean" {{checked componentData.rules.oneRoomPerExpansionSlot}} {{#unless editable}}disabled{{/unless}}></label>
        </div>
        <label class="arcflight-sheet__field"><span>Design Intent</span><textarea name="{{arcflightFlagPath}}.notes.designIntent" rows="3" {{#unless editable}}disabled{{/unless}}>{{componentData.notes.designIntent}}</textarea></label>
        <label class="arcflight-sheet__field"><span>GM Notes</span><textarea name="{{arcflightFlagPath}}.notes.gmNotes" rows="3" {{#unless editable}}disabled{{/unless}}>{{componentData.notes.gmNotes}}</textarea></label>
      </section>
    {{/if}}

    {{#if isArkengine}}
      <section class="arcflight-sheet__section">
        <h2>Arkengine</h2>
        <label class="arcflight-sheet__field"><span>Class</span><input type="text" name="{{arcflightFlagPath}}.class" value="{{componentData.class}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Spell Rank Requirement</span><input type="text" name="{{arcflightFlagPath}}.spellRankRequirement" value="{{componentData.spellRankRequirement}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Strain Capacity</span><input type="text" name="{{arcflightFlagPath}}.strainCapacity" value="{{componentData.strainCapacity}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Mod Slots</span><input type="text" name="{{arcflightFlagPath}}.modSlots" value="{{componentData.modSlots}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Hard Burn Metadata Placeholder</span><input type="text" name="{{arcflightFlagPath}}.hardBurnMetadata" value="{{componentData.hardBurnMetadata}}" {{#unless editable}}disabled{{/unless}}></label>
      </section>
    {{/if}}

    {{#if isArkengineMod}}
      <section class="arcflight-sheet__section">
        <h2>Arkengine Mod</h2>
        <label class="arcflight-sheet__field"><span>Mod Category</span><input type="text" name="{{arcflightFlagPath}}.modCategory" value="{{componentData.modCategory}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Compatible Engine Classes</span><input type="text" name="{{arcflightFlagPath}}.compatibleEngineClasses" value="{{componentData.compatibleEngineClasses}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Effect Summary Placeholder</span><input type="text" name="{{arcflightFlagPath}}.effectSummary" value="{{componentData.effectSummary}}" {{#unless editable}}disabled{{/unless}}></label>
      </section>
    {{/if}}

    {{#if isWeapon}}
      <section class="arcflight-sheet__section">
        <h2>Weapon</h2>
        <label class="arcflight-sheet__field"><span>Firing Arcs</span><input type="text" name="{{arcflightFlagPath}}.firingArcs" value="{{componentData.firingArcs}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Reload</span><input type="text" name="{{arcflightFlagPath}}.reload" value="{{componentData.reload}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Crew Requirement</span><input type="text" name="{{arcflightFlagPath}}.crewRequirement" value="{{componentData.crewRequirement}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Range Bands</span><input type="text" name="{{arcflightFlagPath}}.rangeBands" value="{{componentData.rangeBands}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Damage Profile</span><input type="text" name="{{arcflightFlagPath}}.damageProfile" value="{{componentData.damageProfile}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Traits</span><input type="text" name="{{arcflightFlagPath}}.weaponTraits" value="{{componentData.weaponTraits}}" {{#unless editable}}disabled{{/unless}}></label>
      </section>
    {{/if}}

    {{#if isRoom}}
      <section class="arcflight-sheet__section">
        <h2>Room</h2>
        <label class="arcflight-sheet__field"><span>Room Category</span><input type="text" name="{{arcflightFlagPath}}.roomCategory" value="{{componentData.roomCategory}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Utility Summary</span><input type="text" name="{{arcflightFlagPath}}.utilitySummary" value="{{componentData.utilitySummary}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Downtime Placeholder</span><input type="text" name="{{arcflightFlagPath}}.downtimePlaceholder" value="{{componentData.downtimePlaceholder}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Crafting Placeholder</span><input type="text" name="{{arcflightFlagPath}}.craftingPlaceholder" value="{{componentData.craftingPlaceholder}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Recovery Placeholder</span><input type="text" name="{{arcflightFlagPath}}.recoveryPlaceholder" value="{{componentData.recoveryPlaceholder}}" {{#unless editable}}disabled{{/unless}}></label>
      </section>
    {{/if}}

    {{#if isShipUpgrade}}
      <section class="arcflight-sheet__section">
        <h2>Ship Upgrade</h2>
        <label class="arcflight-sheet__field"><span>Upgrade Category</span><input type="text" name="{{arcflightFlagPath}}.upgradeCategory" value="{{componentData.upgradeCategory}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Install Location</span><input type="text" name="{{arcflightFlagPath}}.installLocation" value="{{componentData.installLocation}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Effect Summary Placeholder</span><input type="text" name="{{arcflightFlagPath}}.effectSummary" value="{{componentData.effectSummary}}" {{#unless editable}}disabled{{/unless}}></label>
      </section>
    {{/if}}

    {{#if isCargo}}
      <section class="arcflight-sheet__section">
        <h2>Cargo</h2>
        <label class="arcflight-sheet__field"><span>Cargo Units</span><input type="text" name="{{arcflightFlagPath}}.cargoUnits" value="{{componentData.cargoUnits}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Special Handling Notes</span><textarea name="{{arcflightFlagPath}}.specialHandlingNotes" rows="3" {{#unless editable}}disabled{{/unless}}>{{componentData.specialHandlingNotes}}</textarea></label>
      </section>
    {{/if}}

    {{#if isCrewAsset}}
      <section class="arcflight-sheet__section">
        <h2>Crew Asset</h2>
        <label class="arcflight-sheet__field"><span>Role</span><input type="text" name="{{arcflightFlagPath}}.role" value="{{componentData.role}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Station Affinity</span><input type="text" name="{{arcflightFlagPath}}.stationAffinity" value="{{componentData.stationAffinity}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Faction Identity</span><input type="text" name="{{arcflightFlagPath}}.factionIdentity" value="{{componentData.factionIdentity}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Specialist Action Placeholder</span><input type="text" name="{{arcflightFlagPath}}.specialistAction" value="{{componentData.specialistAction}}" {{#unless editable}}disabled{{/unless}}></label>
      </section>
    {{/if}}
  {{/unless}}
</section>
