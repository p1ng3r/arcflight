        <h3>Restrictions</h3>
        <label class="arcflight-sheet__field arcflight-sheet__field--checkbox"><input type="checkbox" name="{{arcflightFlagPath}}.restrictions.unique" {{#if componentData.restrictions.unique}}checked{{/if}} {{#unless editable}}disabled{{/unless}}> <span>Unique</span></label>
        <label class="arcflight-sheet__field"><span>Max Instances</span><input type="number" name="{{arcflightFlagPath}}.restrictions.maxInstances" value="{{componentData.restrictions.maxInstances}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Required Ship Traits</span><input type="text" name="{{arcflightFlagPath}}.restrictions.requiredShipTraits" value="{{componentData.restrictions.requiredShipTraits}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Blocked Ship Traits</span><input type="text" name="{{arcflightFlagPath}}.restrictions.blockedShipTraits" value="{{componentData.restrictions.blockedShipTraits}}" {{#unless editable}}disabled{{/unless}}></label>
        <label class="arcflight-sheet__field"><span>Restriction Notes</span><textarea name="{{arcflightFlagPath}}.restrictions.notes" rows="2" {{#unless editable}}disabled{{/unless}}>{{componentData.restrictions.notes}}</textarea></label>

        <h3>Traits</h3>
        <label class="arcflight-sheet__field"><span>Traits</span><input type="text" name="{{arcflightFlagPath}}.traits" value="{{componentData.traits}}" {{#unless editable}}disabled{{/unless}}></label>

        <h3>Notes</h3>
        <label class="arcflight-sheet__field"><span>Design Intent</span><textarea name="{{arcflightFlagPath}}.notes.designIntent" rows="2" {{#unless editable}}disabled{{/unless}}>{{componentData.notes.designIntent}}</textarea></label>
        <label class="arcflight-sheet__field"><span>GM Notes</span><textarea name="{{arcflightFlagPath}}.notes.gmNotes" rows="2" {{#unless editable}}disabled{{/unless}}>{{componentData.notes.gmNotes}}</textarea></label>
      </section>
    {{/if}}
  {{/unless}}
  </div>
  <datalist id="arcflight-arkengine-classes">
    {{#each arkengineClassOptions}}<option value="{{value}}">{{label}}</option>{{/each}}
  </datalist>
  <datalist id="arcflight-weapon-types">
    {{#each suggestedWeaponTypeOptions}}<option value="{{value}}">{{label}}</option>{{/each}}
  </datalist>
  <datalist id="arcflight-weapon-sizes">
    {{#each weaponSizeOptions}}<option value="{{value}}">{{label}}</option>{{/each}}
  </datalist>
  <datalist id="arcflight-weapon-arcs">
    {{#each weaponArcOptions}}<option value="{{value}}">{{label}}</option>{{/each}}
  </datalist>
  <datalist id="arcflight-reload-states">
    {{#each reloadStateOptions}}<option value="{{value}}">{{label}}</option>{{/each}}
  </datalist>

</section>
