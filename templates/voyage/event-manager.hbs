<div class="arcflight-event-manager event-manager-shell" data-component="event-manager-shell" data-mode="{{mode}}" data-active-tab="{{activeTab}}">
  {{#if setupMode}}
    <header class="arcflight-event-manager__header event-header" data-component="event-header"><div><p class="arcflight-kicker">Milestone 12 - Event Launcher</p><h1>{{event.title}}</h1><p>{{event.description}}</p></div><span class="arcflight-status">SETUP</span></header>
    <section class="arcflight-event-manager__section event-summary" data-component="event-summary"><h2>Event</h2><p>{{event.roundCount}} rounds - fixed Event Runner stations</p></section>
    <section class="arcflight-event-manager__section ship-summary" data-component="ship-summary"><h2>Ship</h2><select data-m12-ship>{{#each ships}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>{{#unless ships.length}}<p class="arcflight-error">No valid Arcflight PF2e vehicle ships are available.</p>{{/unless}}</section>
    <section class="arcflight-event-manager__section operator-assignments" data-component="operator-assignments"><h2>Fixed operators</h2>{{#each stations}}<label class="arcflight-event-manager__row"><span>{{label}}</span><select data-m12-operator="{{stationId}}">{{#each options}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select><small>{{#if occupied}}Occupied{{else}}Unoccupied{{/if}}</small></label>{{/each}}</section>
    {{#if validationErrors.length}}<section class="arcflight-event-manager__section"><h2>Validation</h2><ul class="arcflight-error">{{#each validationErrors}}<li>{{this}}</li>{{/each}}</ul></section>{{/if}}
    <footer class="arcflight-event-manager__footer"><button type="button" data-m12-launch {{#unless launchEnabled}}disabled{{/unless}}>Launch Event</button></footer>
  {{else}}
    <header class="arcflight-event-manager__header event-header" data-component="event-header"><div><p class="arcflight-kicker">Live GM Dashboard</p><h1>{{dashboard.shipName}} at {{event.title}}</h1><p>{{sessionId}}</p></div><span class="arcflight-status">{{#if abandoned}}ABANDONED{{else}}LIVE{{/if}}</span></header>
    {{#if dashboard}}
      <nav class="event-tabs" data-component="event-tabs" role="tablist" aria-label="Event Manager sections">
        <button type="button" class="event-tab" data-component="event-tab" data-m12-tab data-tab-id="overview" role="tab" aria-controls="tab-overview">Overview</button>
        <button type="button" class="event-tab" data-component="event-tab" data-m12-tab data-tab-id="crew-plan" role="tab" aria-controls="tab-crew-plan">Crew Plan</button>
        <button type="button" class="event-tab" data-component="event-tab" data-m12-tab data-tab-id="resolution-order" role="tab" aria-controls="tab-resolution-order">Resolution Order</button>
        <button type="button" class="event-tab" data-component="event-tab" data-m12-tab data-tab-id="plan-review" role="tab" aria-controls="tab-plan-review">Plan Review</button>
        <button type="button" class="event-tab" data-component="event-tab" data-m12-tab data-tab-id="resolution" role="tab" aria-controls="tab-resolution">Resolution</button>
      </nav>
      <section id="tab-overview" class="event-tab-content tab-overview" data-component="event-tab-content" data-m12-tab-content data-tab-id="overview" role="tabpanel">
        <section class="arcflight-event-manager__grid round-status event-status-panel" data-component="event-status-panel"><div><strong>Event</strong><span>{{event.title}}</span><span>{{dashboard.shipName}}</span></div><div><strong>Round</strong><span>{{dashboard.roundNumber}}</span><span>{{dashboard.lifecycleState}} - {{dashboard.phase}}</span></div><div><strong>Session</strong><span>{{dashboard.sessionState}}</span><span>Revision {{dashboard.revision}}</span></div></section>
        <section class="arcflight-event-manager__section resource-strip" data-component="resource-strip"><h2>Resources</h2><div class="arcflight-event-manager__pressure"><span><b>Momentum</b>{{dashboard.momentum}}</span><span><b>Pressure</b>{{#each dashboard.pressureSystems}}{{pressureSystemId}}: {{value}} / {{capacity}} {{/each}}</span><span><b>Breach</b>{{#if dashboard.breachCount}}{{dashboard.breachCount}}{{else}}0{{/if}}</span><span><b>Hazards</b>{{dashboard.activeHazardCount}}</span></div></section>
        <section class="arcflight-event-manager__section crew-summary" data-component="crew-summary"><h2>Fixed station / operator summary</h2>{{#each dashboard.stationAssignments}}<p data-station-id="{{stationId}}"><strong>{{stationId}}</strong> - {{operator.name}}</p>{{/each}}</section>
      </section>
      <section id="tab-crew-plan" class="event-tab-content tab-crew-plan crew-plan-panel" data-component="crew-plan-panel" data-m12-tab-content data-tab-id="crew-plan" role="tabpanel">
        <h2>Crew Plan</h2>
        {{#if planning}}
          {{#each planningStations}}
            <article id="AF-UI-STATION-{{stationId}}" class="arcflight-station-card station-card{{#if ready}} station-card--ready{{else}} station-card--incomplete{{/if}}" data-component="station-card" data-station-id="{{stationId}}" data-round="{{../planning.roundNumber}}" data-plan-state="{{planState}}" data-selection-state="{{selectionState}}"><header class="station-header" data-component="station-header"><h3>{{label}}</h3><p class="station-operator" data-component="station-operator">{{operator.name}}</p></header>
              <p class="station-status{{#unless ready}} station-status--required{{/unless}}" data-component="station-status" data-status="{{planState}}"><strong>{{statusLabel}}</strong> <span>{{statusMessage}}</span></p>
              <div class="action-list" data-component="action-list"><label title="What are we doing?">Action<select data-m12-station-selection data-m12-action="{{stationId}}" data-control-id="action" data-station-id="{{stationId}}" data-selected="{{#if selectedActionId}}true{{else}}false{{/if}}" {{#if ../planLocked}}disabled{{/if}}><option value="" {{#unless selectedActionId}}selected{{/unless}}>Choose Action...</option>{{#each actions}}<option data-m12-action-option="{{../stationId}}" data-action-id="{{actionId}}" data-approach-id="{{approaches.[0].approachId}}" data-selected="{{#if selected}}true{{else}}false{{/if}}" value="{{actionId}}" {{#if selected}}selected{{/if}}>{{actionId}}</option>{{/each}}</select><small>What are we doing?</small></label></div>
              <label class="approach-control" data-component="approach-control" title="How are we doing it?">Approach<select data-m12-station-selection data-m12-approach="{{stationId}}" data-control-id="approach" data-station-id="{{stationId}}" {{#if ../planLocked}}disabled{{/if}}{{#unless selectedActionId}} disabled{{/unless}}><option value="" {{#unless selectedApproachId}}selected{{/unless}}>{{#if selectedActionId}}Choose Approach...{{else}}Select an Action first{{/if}}</option>{{#each approaches}}<option value="{{approachId}}" {{#if selected}}selected{{/if}}>{{approachId}}</option>{{/each}}</select><small>How are we doing it?</small></label>
              <label class="risk-bid-control" data-component="risk-bid-control" title="How hard are we pushing?">Risk Bid<select data-m12-station-selection data-m12-risk-bid="{{stationId}}" data-control-id="risk-bid" data-station-id="{{stationId}}" {{#if ../planLocked}}disabled{{/if}}{{#unless selectedActionId}} disabled{{/unless}}><option value="" {{#unless selectedActionId}}selected{{/unless}}>{{#if selectedActionId}}No Bid{{else}}Select an Action first{{/if}}</option>{{#each riskBidOptions}}<option value="{{riskBidId}}" {{#if selected}}selected{{/if}}>+{{dcAdjustment}}</option>{{/each}}</select><small>How hard are we pushing?</small></label>
              <button type="button" data-m12-clear-selection data-station-id="{{stationId}}" data-component="clear-selection" data-control-id="clear" {{#if ../planLocked}}disabled{{/if}}>Clear</button>
            </article>
          {{/each}}
        {{else}}<p class="arcflight-error">The persisted planning state could not be read.</p>{{/if}}
      </section>
      <section id="tab-resolution-order" class="event-tab-content tab-resolution-order resolution-order-panel" data-component="resolution-order-panel" data-m12-tab-content data-tab-id="resolution-order" role="tabpanel">
        <h2>Resolution Order</h2><p>{{#if planLocked}}Committed station order (read-only).{{else}}Drag a station to change the persisted resolution order.{{/if}}</p>
        <ol data-m12-order-list>{{#each orderEntries}}<li draggable="{{#unless ../planLocked}}true{{else}}false{{/unless}}" class="resolution-order-card" data-component="resolution-order-card" data-m12-order-station data-station-id="{{stationId}}"><span class="resolution-order-number" data-component="resolution-order-number">ORDER {{orderNumber}}</span><span class="resolution-order-handle" data-component="resolution-order-handle" aria-hidden="true">↕</span><strong>STATION: {{stationLabel}}</strong><span>OPERATOR: {{operatorName}}</span><span>ACTION: {{actionName}}</span><span>APPROACH: {{approachName}}</span><span>RISK BID: {{riskBidName}}</span></li>{{/each}}</ol>
      </section>
      <section id="tab-plan-review" class="event-tab-content tab-plan-review plan-review-panel" data-component="plan-review-panel" data-m12-tab-content data-tab-id="plan-review" role="tabpanel">
        <h2>Plan Review</h2><p class="plan-readiness" data-component="plan-readiness"><strong>ROUND {{planning.roundNumber}}</strong> - {{#if planLocked}}PLAN LOCKED{{else}}{{#if planReady}}READY FOR PLAN LOCK{{else}}ACTION REQUIRED{{/if}}{{/if}}</p>
        {{#unless planLocked}}{{#unless planReady}}<p class="arcflight-error">Incomplete station(s): {{#each incompleteStations}}{{label}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/unless}}{{/unless}}
        <div class="plan-review-stations">{{#each planReviewRows}}<article class="plan-review-station" data-component="plan-review-station" data-station-id="{{stationId}}" data-plan-state="{{planState}}"><h3>{{orderNumber}}. {{stationLabel}}</h3><p><strong>Operator:</strong> {{operatorName}}</p><p><strong>Action:</strong> {{actionName}}</p><p><strong>Approach:</strong> {{approachName}}</p><p><strong>Risk:</strong> {{riskBidName}}</p></article>{{/each}}</div>
        <section class="plan-lock-panel" data-component="plan-lock-panel" data-plan-state="{{#if planLocked}}locked{{else}}{{#if planReady}}ready{{else}}incomplete{{/if}}{{/if}}"><h3>{{#if planLocked}}PLAN LOCKED{{else}}PLAN REVIEW{{/if}}</h3><p>{{#if planLocked}}Crew choices and station order are now committed.{{else}}{{#if planReady}}All occupied stations are ready for Plan Lock.{{else}}Complete each occupied station before Plan Lock.{{/if}}{{/if}}</p>{{#if planLocked}}<button type="button" class="plan-lock-button" data-component="plan-lock-button" data-m12-go-resolution>GO TO RESOLUTION</button>{{else}}<button type="button" class="plan-lock-button" data-component="plan-lock-button" data-m12-plan-lock {{#unless planReady}}disabled{{/unless}}>LOCK PLAN</button>{{/if}}</section>
      </section>
      <section id="tab-resolution" class="event-tab-content tab-resolution resolution-panel" data-component="resolution-panel" data-m12-tab-content data-tab-id="resolution" role="tabpanel">
        <h2>Resolution</h2>
        {{#if resolutionAwaitingPlanLock}}
          <p class="arcflight-error">PLAN MUST BE LOCKED BEFORE RESOLUTION</p>
        {{else}}
          {{#if resolution}}
            <p data-resolution-state="{{resolution.phase}}">Round {{resolution.roundNumber}} — {{#if resolution.completed}}RESOLUTION COMPLETE — AWAITING ROUND CLOSEOUT{{else}}Current station: {{resolution.currentStationId}}{{/if}}</p>
            <section data-component="resolution-current" data-station-id="{{resolution.currentStationId}}" data-control-id="resolution-current">
              {{#each resolution.stations}}<article class="resolution-station" data-station-id="{{stationId}}" data-resolution-status="{{status}}" data-current="{{current}}"><strong>{{order}}. {{stationId}}</strong><span>Operator: {{operator.name}}</span><span>Action: {{actionId}}</span><span>Approach: {{approachId}}</span><span>Statistic: {{statisticSlugOrAbilityId}}</span><span>Risk Bid: {{riskBidDcAdjustment}}</span><span>DC: {{finalDc}}</span><span>{{status}}</span>{{#if result}}<span>Result: {{result.total}} — {{result.degreeOfSuccessSlug}}</span>{{/if}}{{#if canRoll}}<button type="button" data-m12-roll-check>ROLL CHECK</button>{{/if}}</article>{{/each}}
            </section>
            {{#if resolutionReadyToStart}}<button type="button" data-m12-resolution-start>BEGIN RESOLUTION</button>{{/if}}
          {{else}}<p class="arcflight-error">Resolution state could not be read.</p>{{/if}}
        {{/if}}
      </section>
    {{else}}<p class="arcflight-error">The persisted session could not be read.</p>{{/if}}
    {{#if dashboard}}<p class="arcflight-event-manager__active-gm">Active GM {{dashboard.activeGmUserId}}</p>{{/if}}
    <footer class="arcflight-event-manager__footer event-footer" data-component="event-footer"><button type="button" data-m12-refresh>Refresh</button>{{#if abandonEnabled}}<button type="button" data-m12-abandon>ABANDON EVENT</button>{{/if}}<button type="button" data-m12-new-session>New Event</button></footer>
  {{/if}}
</div>
