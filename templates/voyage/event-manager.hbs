<div class="arcflight-event-manager event-manager-shell command-console" data-component="event-manager-shell" data-mode="{{mode}}" data-active-tab="{{activeTab}}">
  <style data-component="event-manager-task4-ui">
    .event-manager-shell .station-cell { display: grid; gap: .35rem; padding: .65rem; border: 1px solid var(--color-border-light-2, #777); border-radius: .35rem; }
    .event-manager-shell { font-family: "Inter", "Segoe UI", sans-serif; }
    .event-manager-shell h1, .event-manager-shell h2, .event-manager-shell h3, .event-manager-shell h4, .event-manager-shell .station-identity strong, .event-manager-shell .event-tab { font-family: "Cinzel", "Marcellus SC", serif; }
    .event-manager-shell select, .event-manager-shell button, .event-manager-shell input, .event-manager-shell textarea { font-family: "Inter", "Segoe UI", sans-serif; }
    .event-manager-shell .station-icon { width: 48px; height: 48px; object-fit: contain; flex: 0 0 auto; }
    .event-manager-shell .station-icon--major { width: 56px; height: 56px; }
    .event-manager-shell .resource-icon { width: 24px; height: 24px; object-fit: contain; vertical-align: middle; }
    .event-manager-shell .resource-icon--large { width: 48px; height: 48px; }
  </style>
  {{#if setupMode}}
    <header class="arcflight-event-manager__header event-header" data-component="event-header"><div><p class="arcflight-kicker">Milestone 12 - Event Launcher</p><h1>{{event.title}}</h1><p>{{event.description}}</p></div><span class="arcflight-status">SETUP</span></header>
    <section class="arcflight-event-manager__section event-summary" data-component="event-summary"><h2>Event</h2><p>{{event.roundCount}} rounds - fixed Event Runner stations</p></section>
    <section class="arcflight-event-manager__section ship-summary" data-component="ship-summary"><h2>Ship</h2><select data-m12-ship>{{#each ships}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>{{#unless ships.length}}<p class="arcflight-error">No valid Arcflight PF2e vehicle ships are available.</p>{{/unless}}</section>
    <section class="arcflight-event-manager__section operator-assignments" data-component="operator-assignments"><h2>Fixed operators</h2>{{#each stations}}<label class="arcflight-event-manager__row station-cell {{stationThemeClass}}"><span class="station-label station-identity">{{#if stationIconPath}}<img class="station-icon" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}" width="{{stationIconSize}}" height="{{stationIconSize}}">{{/if}}<span>{{stationDisplayName}}</span></span><select data-m12-operator="{{stationId}}">{{#each options}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select><small>{{#if occupied}}Occupied{{else}}Unoccupied{{/if}}</small></label>{{/each}}</section>
    {{#if validationErrors.length}}<section class="arcflight-event-manager__section"><h2>Validation</h2><ul class="arcflight-error">{{#each validationErrors}}<li>{{this}}</li>{{/each}}</ul></section>{{/if}}
    <footer class="arcflight-event-manager__footer"><button type="button" data-m12-launch {{#unless launchEnabled}}disabled{{/unless}}>Launch Event</button></footer>
  {{else}}
    <header class="arcflight-event-manager__header event-header command-header" data-component="event-header"><div class="command-header__copy"><p class="arcflight-kicker">LIVE EVENT COMMAND CONSOLE</p><h1 title="{{dashboard.shipName}} at {{event.title}}">{{dashboard.shipName}} at {{event.title}}</h1><p>{{currentRoundLabel}}</p></div><div class="command-header__meta"><span class="command-round">ROUND {{dashboard.roundNumber}}</span><span class="arcflight-status">{{#if abandoned}}ABANDONED{{else}}LIVE{{/if}}</span><details class="gm-tools" data-component="gm-tools"><summary aria-label="GM tools">GM TOOLS</summary><div class="gm-tools__menu"><p class="gm-tools__active-gm"><span>ACTIVE GM</span><strong>{{activeGmDisplayName}}</strong><small>{{activeGmUserId}}</small></p><button type="button" data-m12-refresh>Refresh</button>{{#if abandonEnabled}}<button type="button" data-m12-abandon>ABANDON EVENT</button>{{/if}}<button type="button" data-m12-new-session>New Event</button></div></details></div></header>
    {{#if dashboard}}
      <nav class="event-progress command-tracker" data-m12-scroll-region="tracker" data-component="event-progress" aria-label="Round progress">
        {{#each progressSegments}}<span class="event-progress-segment{{#if active}} is-active{{/if}}{{#if complete}} is-complete{{/if}}" data-segment-id="{{id}}" data-segment-state="{{#if active}}current{{else}}{{#if complete}}complete{{else}}upcoming{{/if}}{{/if}}" aria-current="{{#if active}}step{{/if}}"><span class="event-progress-label">{{label}}</span><small>{{#if active}}CURRENT{{else}}{{#if complete}}COMPLETED{{else}}UPCOMING{{/if}}{{/if}}</small></span>{{/each}}
      </nav>
      <nav class="event-tabs command-workspace-tabs" data-component="event-tabs" role="tablist" aria-label="Event Manager workspaces">
        <button type="button" class="event-tab" data-component="event-tab" data-m12-tab data-tab-id="event" role="tab" aria-controls="tab-event">EVENT</button>
        <button type="button" class="event-tab" data-component="event-tab" data-m12-tab data-tab-id="plan" role="tab" aria-controls="tab-plan">PLAN</button>
        <button type="button" class="event-tab" data-component="event-tab" data-m12-tab data-tab-id="resolve" role="tab" aria-controls="tab-resolve">RESOLVE</button>
      </nav>
      <div class="event-command-workspace">
        <main class="event-command-main" data-m12-scroll-region="main">
          <section id="tab-event" class="event-tab-content command-workspace-panel tab-event" data-component="event-workspace" data-m12-tab-content data-m12-scroll-region="event" data-tab-id="event" role="tabpanel">
            <div class="event-situation-grid"><section class="command-card"><p class="arcflight-kicker">CURRENT SITUATION</p>{{#if currentRound}}<h2>{{currentRound.title}}</h2><p>{{currentRound.vignette}}</p><p><strong>Situation:</strong> {{currentRound.situation}}</p><p><strong>Objective:</strong> {{currentRound.objective}}</p><p><strong>Known stakes:</strong> {{currentRound.knownStakes}}</p>{{else}}<p>Round situation is not available.</p>{{/if}}</section><section class="command-card event-readiness"><p class="arcflight-kicker">EVENT READINESS</p><p><strong>Session:</strong> {{dashboard.sessionState}}</p><p><strong>Phase:</strong> {{dashboard.phase}}</p><p><strong>Revision:</strong> {{dashboard.revision}}</p><p><strong>Stations:</strong> {{dashboard.stationAssignments.length}}</p></section></div>
            <section class="command-card"><p class="arcflight-kicker">CREW ROSTER</p><div class="event-roster">{{#each dashboard.stationAssignments}}<div class="roster-item {{stationThemeClass}}" data-station-id="{{stationId}}">{{#if stationIconPath}}<img class="station-icon" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}">{{/if}}<span><strong>{{stationDisplayName}}</strong><small>{{#if operator}}{{operator.name}}{{else}}Unassigned{{/if}}</small></span><span class="status-chip">{{statusLabel}}</span></div>{{/each}}</div></section>
          </section>
          <section id="tab-plan" class="event-tab-content command-workspace-panel tab-plan" data-component="plan-workspace" data-m12-tab-content data-m12-scroll-region="plan" data-tab-id="plan" role="tabpanel">
            <div class="plan-station-selector" role="tablist" aria-label="Planning stations">{{#each planningStations}}<button type="button" class="plan-station-tab {{stationThemeClass}}{{#if active}} is-active{{/if}}" data-m12-plan-station data-station-id="{{stationId}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{#if stationIconPath}}<img class="station-icon" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}">{{/if}}<span>{{stationDisplayName}}</span><small>{{statusLabel}}</small></button>{{/each}}</div>
            <div class="plan-workspace-grid"><section class="plan-active-station command-card">{{#each planningStations}}{{#if active}}<article class="planning-station {{stationThemeClass}}" data-station-id="{{stationId}}" data-plan-state="{{planState}}"><header class="station-header"><img class="station-icon station-icon--major" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}" width="{{stationIconMajorSize}}" height="{{stationIconMajorSize}}"><div><p class="arcflight-kicker">ACTIVE STATION</p><h2>{{stationDisplayName}}</h2><p>{{operator.name}}</p></div><span class="focus-pool"><img class="resource-icon" src="{{focusAbilities.[0].resource.resourceIconPath}}" alt="Focus resource" title="Focus resource">{{focusLabel}}</span><span class="status-chip">{{statusLabel}}</span></header>
                <div class="action-card-grid" data-component="action-card-grid">{{#each actions}}<button type="button" class="action-card{{#if selected}} is-selected{{/if}}" data-m12-action-option="{{../stationId}}" data-station-id="{{../stationId}}" data-action-id="{{actionId}}" data-approach-id="{{approaches.[0].approachId}}" aria-selected="{{#if selected}}true{{else}}false{{/if}}"><strong>{{displayName}}</strong>{{#if riskBidAvailableResource}}<img class="risk-bid-action-icon" src="{{riskBidAvailableResource.resourceIconPath}}" alt="Risk Bid available" title="Risk Bid available" aria-label="Risk Bid available">{{/if}}</button>{{/each}}</div>
                <section class="selected-action-detail" data-component="selected-action-detail"><p class="arcflight-kicker">SELECTED ACTION</p><h3>{{selectedActionName}}</h3><p>{{selectedActionDescription}}</p><p><strong>Base DC:</strong> {{selectedActionBaseDc}}</p><label data-component="approach-control">Approach<select data-m12-station-selection data-m12-approach="{{stationId}}" data-control-id="approach" data-station-id="{{stationId}}" {{#if ../planLocked}}disabled{{/if}}{{#unless selectedActionId}}disabled{{/unless}}><option value="" {{#unless selectedApproachId}}selected{{/unless}}>Choose Approach...</option>{{#each approaches}}<option value="{{approachId}}" {{#if selected}}selected{{/if}}>{{name}} ({{modifierLabel}})</option>{{/each}}</select></label>{{#if selectedActionHasRiskBids}}<label data-component="risk-bid-control"><span class="risk-bid-control-label">{{#if selectedRiskBidAvailableResource}}<img class="risk-bid-action-icon" src="{{selectedRiskBidAvailableResource.resourceIconPath}}" alt="Risk Bid available" title="Risk Bid available" aria-label="Risk Bid available">{{/if}}Risk Bid</span><select data-m12-station-selection data-m12-risk-bid="{{stationId}}" data-control-id="risk-bid" data-station-id="{{stationId}}" {{#if ../planLocked}}disabled{{/if}}><option value="" {{#unless selectedRiskBidId}}selected{{/unless}}>NO BID</option>{{#each riskBidOptions}}<option value="{{riskBidId}}" {{#if selected}}selected{{/if}}>{{displayName}} (DC {{finalDc}})</option>{{/each}}</select></label>{{/if}}<div class="risk-bid-stakes">{{#each riskBidOptions}}<div class="risk-bid-stake"><strong>{{displayName}}</strong><span>DC {{finalDc}}</span><span>{{presentation.intendedBenefit}}</span><span>TARGET: {{#each payoffEffects}}{{#each targetStations}}{{stationDisplayName}} {{/each}}{{/each}}</span><span>FAILURE: {{presentation.outcome.failure}}</span><span>CRITICAL FAILURE: {{presentation.outcome.criticalFailure}}</span></div>{{/each}}</div><div class="focus-ability-list">{{#each focusAbilities}}<span class="focus-ability"><img class="resource-icon" src="{{resource.resourceIconPath}}" alt="Focus" title="Focus">{{name}}</span>{{/each}}</div><button type="button" data-m12-clear-selection data-station-id="{{stationId}}" data-control-id="clear" {{#if ../planLocked}}disabled{{/if}}>CLEAR SELECTION</button></section>
              </article>{{/if}}{{/each}}</section><aside class="plan-summary command-card"><p class="arcflight-kicker">PLAN SUMMARY</p><strong class="plan-summary-readiness">{{planSummary.readinessLabel}}</strong><div class="plan-summary-metrics"><span>Stations Ready: {{planSummary.stationsReady}} / {{planSummary.stationTotal}}</span><span>Selected Risk Bids: {{planSummary.selectedRiskBids}}</span><span>Risk Bid Dependencies: {{planSummary.riskBidDependencies}}</span></div>{{#if planSummary.hasBlockers}}<div class="plan-summary-blockers"><p class="arcflight-kicker">BLOCKING ISSUES</p><ul>{{#each planSummary.blockers}}<li>{{this}}</li>{{/each}}</ul></div>{{/if}}<div class="plan-summary-order"><p class="arcflight-kicker">RESOLUTION ORDER PREVIEW</p>{{#if planSummary.hasOrderPreview}}<ol>{{#each planSummary.orderPreview}}<li><span>{{orderNumber}}. {{stationDisplayName}}</span><small>{{actionName}}</small></li>{{/each}}</ol>{{else}}<p>No station order proposed.</p>{{/if}}</div></aside></div>
            <section class="plan-order-section command-card"><p class="arcflight-kicker">ORDER</p><p>{{#if planLocked}}Committed station order (read-only).{{else}}Drag or use controls to set order.{{/if}}</p><ol data-m12-order-list class="order-card-list">{{#each orderEntries}}<li draggable="{{#unless ../planLocked}}true{{else}}false{{/unless}}" class="resolution-order-card station-cell {{stationThemeClass}}" data-component="resolution-order-card" data-m12-order-station data-station-id="{{stationId}}"><span class="resolution-order-rail"><button class="order-move" type="button" data-m12-order-move data-station-id="{{stationId}}" data-direction="up" aria-label="Move {{stationDisplayName}} earlier" {{#unless canMoveUp}}disabled{{/unless}}{{#if ../planLocked}} disabled{{/if}}>&#9650;</button><span class="order-position">{{orderNumber}}</span><button class="order-move" type="button" data-m12-order-move data-station-id="{{stationId}}" data-direction="down" aria-label="Move {{stationDisplayName}} later" {{#unless canMoveDown}}disabled{{/unless}}{{#if ../planLocked}} disabled{{/if}}>&#9660;</button></span><span class="resolution-order-identity">{{#if stationIconPath}}<img class="station-icon" src="{{stationIconPath}}" alt="{{stationOrderIconTitle}}" title="{{stationOrderIconTitle}}" aria-label="{{stationOrderIconTitle}}" width="{{stationOrderIconSize}}" height="{{stationOrderIconSize}}">{{/if}}<strong>{{stationDisplayName}}</strong><small>{{operatorName}}</small></span><span class="resolution-order-fields"><span class="order-field"><b>ACTION</b><span>{{actionName}}</span></span><span class="order-field"><b>APPROACH:</b><span>{{approachName}} ({{approachModifierLabel}})</span></span><span class="order-field"><b>FOCUS</b><span>{{focusLabel}}</span></span></span><span class="resolution-order-risk">{{#if selectedRiskBidResource}}<img class="resource-icon--large" src="{{selectedRiskBidResource.resourceIconPath}}" alt="{{selectedRiskBidResource.resourceIconTitle}}" title="{{selectedRiskBidResource.resourceIconTitle}}" aria-label="{{selectedRiskBidResource.resourceIconTitle}}"><strong>{{riskBidName}}</strong><span>DC {{riskBidFinalDc}}</span>{{else}}<span class="status-chip">NO BID</span>{{/if}}</span></li>{{/each}}</ol></section>
            <section class="plan-review-section command-card"><p class="arcflight-kicker">PLAN REVIEW</p><div class="plan-review-stations">{{#each planReviewRows}}<article class="plan-review-station station-cell {{stationThemeClass}}" data-component="plan-review-station" data-station-id="{{stationId}}"><span class="station-identity">{{#if stationIconPath}}<img class="station-icon" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}">{{/if}}<strong>{{orderNumber}}. {{stationDisplayName}}</strong><small>{{operatorName}}</small></span><span class="station-detail-fields"><span class="review-field"><b>ACTION</b><span>{{actionName}}</span></span><span class="review-field"><b>APPROACH:</b><span>{{approachName}} ({{approachModifierLabel}})</span></span></span><span class="plan-review-status">{{#if selectedRiskBidResource}}<img class="resource-icon" src="{{selectedRiskBidResource.resourceIconPath}}" alt="{{selectedRiskBidResource.resourceIconTitle}}" title="{{selectedRiskBidResource.resourceIconTitle}}" aria-label="{{selectedRiskBidResource.resourceIconTitle}}"><strong>{{riskBidName}}</strong> Â· DC {{riskBidFinalDc}}{{else}}<span class="status-chip">NO BID</span>{{/if}}<small>{{focusLabel}}</small></span></article>{{/each}}</div><div class="plan-lock-panel" data-component="plan-lock-panel"><h3>{{#if planLocked}}PLAN LOCKED{{else}}PLAN REVIEW{{/if}}</h3><p>{{#if planLocked}}Crew choices and station order are now committed.{{else}}Complete each occupied station before Plan Lock.{{/if}}</p>{{#if planLocked}}{{#if planUnlockAvailable}}<button type="button" data-m12-plan-unlock>UNLOCK PLAN</button>{{/if}}<button type="button" data-m12-go-resolution>GO TO RESOLUTION</button>{{else}}<button type="button" data-m12-plan-lock {{#unless planReady}}disabled{{/unless}}>LOCK PLAN</button>{{/if}}</div></section>
          </section>
          <section id="tab-resolve" class="event-tab-content command-workspace-panel tab-resolve" data-component="resolve-workspace" data-m12-tab-content data-m12-scroll-region="resolve" data-tab-id="resolve" role="tabpanel">
            <div class="resolve-layout">
              <section class="resolve-main command-card">
                <p class="arcflight-kicker">RESOLUTION</p>
                {{#if awaitingPlanLock}}
                  <p class="arcflight-error">PLAN MUST BE LOCKED BEFORE RESOLUTION</p>
                {{else}}
                  {{#if resolution}}
                    {{#if resolution.completed}}<p class="resolve-complete">RESOLUTION COMPLETE — AWAITING ROUND CLOSEOUT</p>{{/if}}
                    {{#if resolution.reactionWindow}}
                      {{#if resolution.reactionWindowOpen}}
                        <section class="focus-reaction-panel" data-component="focus-reaction-panel"><h3><img class="resource-icon" src="{{resolution.reactionWindowPending.[0].focusResource.resourceIconPath}}" alt="Focus" title="Focus"> FOCUS REACTION</h3><p>Focus remaining: {{resolution.currentFocusRemaining}}</p>
                          {{#each resolution.reactionWindowPending}}<div class="focus-reaction-opportunity station-cell"><h4>{{focusAbility.name}}</h4><p>{{focusAbility.description}}</p><p>{{focusAbility.sourceStationName}} → {{focusAbility.targetStationName}} · {{focusAbility.statisticName}} / DC {{focusAbility.dc}}</p><p>Critical Success: {{focusAbility.criticalSuccess}} · Success: {{focusAbility.success}} · Failure: {{focusAbility.failure}} · Critical Failure: {{focusAbility.criticalFailure}} · Visibility: {{focusAbility.visibility}}</p><button type="button" data-m12-focus-use data-reaction-id="{{reactionId}}">USE FOCUS</button><button type="button" data-m12-focus-pass data-reaction-id="{{reactionId}}">PASS</button></div>{{/each}}
                        </section>
                      {{else}}
                        {{#if resolution.reactionWindow.result}}<p>Focus result: {{resolution.reactionWindow.result.modifier}}</p>{{/if}}
                      {{/if}}
                    {{/if}}
                    {{#each resolution.stations}}
                      {{#if current}}<article class="resolution-current-card station-cell {{stationThemeClass}}" data-station-id="{{stationId}}"><header><img class="station-icon station-icon--major" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}"><div><p class="arcflight-kicker">CURRENT STATION</p><h2>{{stationDisplayName}}</h2><p>{{operator.name}}</p></div><span>{{focusLabel}}</span></header><div class="resolution-current-fields"><span><b>ACTION</b><strong>{{actionName}}</strong></span><span><b>APPROACH:</b><span>{{approachName}}</span><small>{{skillModifierLabel}} Â· {{statisticLabel}}</small></span><span><b>FOCUS</b><span>{{focusLabel}}</span></span><span><b>RISK BID</b><span>{{#if riskBidDcAdjustment}}+{{riskBidDcAdjustment}}{{else}}NO BID{{/if}}</span></span><span><b>FINAL DC</b><span>{{finalDc}}</span></span></div>{{#each riskBidEffects}}<p class="risk-bid-active-benefit">ACTIVE BENEFIT: {{effectText}} · {{sourceActionId}} · {{consumptionLabel}}</p>{{/each}}{{#if canRoll}}<button type="button" data-m12-roll-check>ROLL CHECK</button>{{/if}}</article>{{/if}}
                    {{/each}}
                  {{else}}
                    <p class="arcflight-error">Resolution state could not be read.</p>
                  {{/if}}
                {{/if}}
              </section>
              <aside class="resolve-secondary">
                <section class="command-card"><p class="arcflight-kicker">PREVIOUS</p>{{#if resolution}}{{#each resolution.stations}}{{#if result}}<div class="resolve-compact {{stationThemeClass}}"><img class="station-icon" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}"><span>{{stationDisplayName}}</span><span>{{result.degreeOfSuccessSlug}}</span></div>{{/if}}{{/each}}{{/if}}</section>
                <section class="command-card"><p class="arcflight-kicker">UPCOMING</p>{{#if resolution}}{{#each resolution.stations}}{{#unless current}}{{#unless result}}<div class="resolve-compact {{stationThemeClass}}"><img class="station-icon" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}"><span>{{stationDisplayName}}</span><span>UPCOMING</span></div>{{/unless}}{{/unless}}{{/each}}{{/if}}</section>
                {{#if roundCloseoutReady}}<button type="button" data-m12-round-closeout data-round-id="{{resolution.roundId}}">CLOSE ROUND</button>{{/if}}
                {{#if resolutionReadyToStart}}<button type="button" data-m12-resolution-start>BEGIN RESOLUTION</button>{{/if}}
              </aside>
            </div>
          </section>
        </main>
        <aside class="event-status-rail" data-component="event-status-rail"><div class="status-resource-row"><section class="status-resource-widget momentum-widget"><div class="resource-socket momentum-icon-frame"><img class="resource-icon" src="{{statusRail.momentum.iconPath}}" alt="{{statusRail.momentum.iconTitle}}" title="{{statusRail.momentum.iconTitle}}" width="{{statusRail.momentum.iconSize}}" height="{{statusRail.momentum.iconSize}}"><b class="resource-socket__number momentum-overlay">{{statusRail.momentum.overlayText}}</b></div><span>MOMENTUM</span></section><section class="status-resource-widget hazard-widget"><div class="resource-socket hazard-icon-frame"><img class="resource-icon" src="{{statusRail.hazardIconPath}}" alt="{{statusRail.hazardIconTitle}}" title="{{statusRail.hazardIconTitle}}" width="{{statusRail.hazardIconSize}}" height="{{statusRail.hazardIconSize}}"><b class="resource-socket__number hazard-count hazard-overlay">{{statusRail.hazardOverlayText}}</b></div><span>HAZARDS</span></section></div><section class="status-rail-card pressure-rail"><p class="arcflight-kicker">PRESSURE</p>{{#each statusRail.pressureRows}}<div class="pressure-row {{stationThemeClass}}{{#if danger}} is-danger{{/if}}"><img class="station-icon" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}"><span class="pressure-row__identity"><strong>{{pressureLabel}}</strong><small>{{stationDisplayName}}</small></span><span class="pressure-gauge" role="img" aria-label="{{value}} / {{capacity}}"><span class="pressure-gauge__segments">{{#each gaugeSegments}}<i class="{{#if filled}}is-filled{{/if}}" aria-hidden="true"></i>{{/each}}</span><small>{{pressureState}}</small></span><small class="pressure-fallback">{{value}}/{{capacity}}</small></div>{{/each}}</section></aside>
      </div>
    {{else}}<p class="arcflight-error">The persisted session could not be read.</p>{{/if}}
  {{/if}}
</div>