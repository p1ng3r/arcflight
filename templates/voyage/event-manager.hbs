<div class="arcflight-event-manager event-manager-shell" data-component="event-manager-shell" data-mode="{{mode}}" data-active-tab="{{activeTab}}">
  <style data-component="event-manager-task4-ui">
    .event-manager-shell .station-cell { display: grid; gap: .35rem; padding: .65rem; border: 1px solid var(--color-border-light-2, #777); border-radius: .35rem; }
    .event-manager-shell { font-family: "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif; }
    .event-manager-shell h1, .event-manager-shell h2, .event-manager-shell h3, .event-manager-shell h4, .event-manager-shell .station-identity strong, .event-manager-shell .event-tab { font-family: "Cinzel", "Marcellus SC", "Palatino Linotype", "Book Antiqua", serif; }
    .event-manager-shell select, .event-manager-shell button, .event-manager-shell input, .event-manager-shell textarea { font-family: "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif; }
    .event-manager-shell .station-header, .event-manager-shell .station-identity, .event-manager-shell .station-cell__mechanic, .event-manager-shell .risk-bid-target-cell, .event-manager-shell .risk-bid-source-cell { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
    .event-manager-shell .station-icon { width: 48px; height: 48px; aspect-ratio: 1; object-fit: contain; flex: 0 0 auto; }
    .event-manager-shell .station-icon--major { width: 56px; height: 56px; }
    .event-manager-shell .station-cell__mechanic, .event-manager-shell .status-chip { font-size: .9em; font-weight: 600; }
    .event-manager-shell .risk-bid-target-cell, .event-manager-shell .risk-bid-source-cell, .event-manager-shell .risk-bid-active-benefit { padding: .35rem; border: 1px solid var(--color-border-light-2, #777); border-radius: .25rem; }
    .event-manager-shell .risk-bid-dependency { display: grid; gap: .3rem; padding: .5rem; }
    .event-manager-shell .risk-bid-dependency .station-cell { min-width: 0; }
    .event-manager-shell .compact-rule { margin: .25rem 0; }
    .event-manager-shell .resolution-order-card { display: grid; grid-template-columns: 2.25rem minmax(9rem, 10rem) minmax(12rem, 1fr) minmax(7rem, 9rem) auto; align-items: stretch; gap: .65rem; }
    .event-manager-shell .resolution-order-rail { display: flex; flex-direction: column; justify-content: space-between; align-items: center; min-height: 100%; padding: .25rem 0; border-right: 1px solid var(--color-border-light-2, #777); font-size: 1.35rem; }
    .event-manager-shell .resolution-order-rail button { min-width: 1.8rem; min-height: 1.8rem; padding: 0; }
    .event-manager-shell .resolution-order-identity { display: flex; flex-direction: column; align-items: center; gap: .25rem; text-align: center; }
    .event-manager-shell .resolution-order-identity .station-icon { width: 128px; height: 128px; }
    .event-manager-shell .resolution-order-risk { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .2rem; text-align: center; }
    .event-manager-shell .resolution-order-risk img { width: 64px; height: 64px; object-fit: contain; }
    .event-manager-shell .resolution-order-fields { display: grid; align-content: center; gap: .3rem; }
    .event-manager-shell .resolution-order-status { display: flex; align-items: center; justify-content: flex-end; min-width: 4.5rem; }
    .event-manager-shell .resolution-order-status .status-chip { opacity: .72; }
    .event-manager-shell .overview-station-cell, .event-manager-shell .crew-plan-station-cell, .event-manager-shell .resolution-station { grid-template-columns: minmax(4rem, 6rem) minmax(7rem, 9rem) minmax(12rem, 1fr); align-items: center; }
    .event-manager-shell .plan-review-station { grid-template-columns: minmax(9rem, 10rem) minmax(12rem, 1fr) minmax(9rem, 14rem); align-items: center; }
    .event-manager-shell .overview-station-cell .station-identity, .event-manager-shell .plan-review-station .station-identity, .event-manager-shell .crew-plan-station-cell .station-identity, .event-manager-shell .resolution-station .station-identity { display: flex; flex-direction: column; align-items: center; text-align: center; }
    .event-manager-shell .station-mechanic-rail { display: grid; gap: .3rem; justify-items: start; align-content: center; }
    .event-manager-shell .station-detail-fields { display: grid; gap: .3rem; align-content: center; }
    .event-manager-shell .station-detail-fields strong { margin-right: .25rem; }
    .event-manager-shell .resolution-order-fields strong { margin-right: .25rem; }
    .event-manager-shell .resource-icon { width: 40px; height: 40px; object-fit: contain; vertical-align: middle; }
    .event-manager-shell .resource-icon--large { width: 64px; height: 64px; }
    .event-manager-shell .risk-bid-available { display: inline-flex; align-items: center; gap: .3rem; }
    .event-manager-shell .risk-bid-available .resource-icon { width: 24px; height: 24px; }
    .event-manager-shell .action-picker { position: relative; display: inline-block; min-width: min(100%, 22rem); }
    .event-manager-shell .action-picker-trigger, .event-manager-shell .action-picker-option { display: flex; align-items: center; gap: .45rem; width: 100%; text-align: left; }
    .event-manager-shell .action-picker-trigger { justify-content: space-between; }
    .event-manager-shell .action-picker-trigger .resource-icon, .event-manager-shell .action-picker-option .resource-icon { width: 20px; height: 20px; margin-left: auto; object-fit: contain; }
    .event-manager-shell .action-picker-menu { position: absolute; z-index: 10; inset-inline: 0; max-height: 16rem; overflow-y: auto; padding: .2rem; border: 1px solid var(--color-border-light-2, #777); background: var(--color-cool-5, #171717); }
    .event-manager-shell .action-picker-menu[hidden] { display: none; }
    .event-manager-shell .action-picker-option[aria-selected="true"] { outline: 1px solid var(--color-border-highlight, #b98b4f); }
    .event-manager-shell .action-picker-option:hover, .event-manager-shell .action-picker-option:focus-visible { background: linear-gradient(90deg, rgba(185,139,79,.42), rgba(46,111,145,.32)); color: var(--color-text-light-primary, #fff); outline: 2px solid var(--color-border-highlight, #b98b4f); outline-offset: -2px; }
    .event-manager-shell .action-picker-option[aria-selected="true"]::before { content: "✓"; color: var(--color-border-highlight, #d6ab62); font-weight: 700; }
    .event-manager-shell .crew-plan-controls { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .45rem; align-items: start; }
    .event-manager-shell .crew-plan-controls > * { min-width: 0; }
    .event-manager-shell .crew-plan-controls .action-list, .event-manager-shell .crew-plan-controls .approach-control, .event-manager-shell .crew-plan-controls .risk-bid-control { display: grid; gap: .2rem; align-content: start; }
    .event-manager-shell .station-header { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; align-items: center; gap: .5rem; }
    .event-manager-shell .station-header-copy { min-width: 0; }
    .event-manager-shell .station-header-copy h3, .event-manager-shell .station-header-copy p { margin: 0; }
    .event-manager-shell .station-card--compact { grid-template-columns: 1fr; padding: .4rem .55rem; }
    .event-manager-shell .station-card--compact .station-header { grid-template-columns: 48px minmax(0, 1fr) auto; }
    .event-manager-shell .station-compact-summary { display: grid; grid-template-columns: minmax(12rem, 1fr) minmax(14rem, 2fr) auto; align-items: center; gap: .65rem; }
    .event-manager-shell .station-compact-identity, .event-manager-shell .station-compact-selection { display: flex; align-items: center; gap: .4rem; min-width: 0; }
    .event-manager-shell .station-compact-selection { flex-wrap: wrap; }
    .event-manager-shell .station-compact-identity .station-icon { width: 40px; height: 40px; }
    @media (max-width: 760px) { .event-manager-shell .crew-plan-controls { grid-template-columns: 1fr 1fr; } .event-manager-shell .crew-plan-controls .risk-bid-control { grid-column: 1 / span 2; } .event-manager-shell .station-compact-summary { grid-template-columns: 1fr auto; } .event-manager-shell .station-compact-selection { grid-column: 1 / span 2; } }
    .event-manager-shell .action-picker-readonly { display: inline-block; min-width: min(100%, 22rem); padding: .35rem .5rem; }
    @media (max-width: 700px) { .event-manager-shell .station-icon--major { width: 48px; height: 48px; } }
    @media (max-width: 760px) { .event-manager-shell .resolution-order-card { grid-template-columns: 2rem minmax(7rem, 1fr) minmax(9rem, 1.2fr); } .event-manager-shell .resolution-order-fields { grid-column: 2 / span 2; } .event-manager-shell .resolution-order-risk, .event-manager-shell .resolution-order-status { grid-column: 2 / span 2; justify-content: flex-start; } .event-manager-shell .overview-station-cell, .event-manager-shell .plan-review-station, .event-manager-shell .crew-plan-station-cell, .event-manager-shell .resolution-station { grid-template-columns: minmax(5rem, 7rem) 1fr; } .event-manager-shell .station-mechanic-rail { grid-column: 1 / span 2; } .event-manager-shell .station-identity { grid-column: 1; } .event-manager-shell .station-detail-fields { grid-column: 2; } .event-manager-shell .plan-review-status { grid-column: 1 / span 2; justify-content: flex-start; } }
  </style>
  {{#if setupMode}}
    <header class="arcflight-event-manager__header event-header" data-component="event-header"><div><p class="arcflight-kicker">Milestone 12 - Event Launcher</p><h1>{{event.title}}</h1><p>{{event.description}}</p></div><span class="arcflight-status">SETUP</span></header>
    <section class="arcflight-event-manager__section event-summary" data-component="event-summary"><h2>Event</h2><p>{{event.roundCount}} rounds - fixed Event Runner stations</p></section>
    <section class="arcflight-event-manager__section ship-summary" data-component="ship-summary"><h2>Ship</h2><select data-m12-ship>{{#each ships}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>{{#unless ships.length}}<p class="arcflight-error">No valid Arcflight PF2e vehicle ships are available.</p>{{/unless}}</section>
    <section class="arcflight-event-manager__section operator-assignments" data-component="operator-assignments"><h2>Fixed operators</h2>{{#each stations}}<label class="arcflight-event-manager__row station-cell"><span class="station-label station-identity">{{#if stationIconPath}}<img class="station-icon" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}" width="{{stationIconSize}}" height="{{stationIconSize}}">{{/if}}<span>{{stationDisplayName}}</span></span><select data-m12-operator="{{stationId}}">{{#each options}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select><small>{{#if occupied}}Occupied{{else}}Unoccupied{{/if}}</small></label>{{/each}}</section>
    {{#if validationErrors.length}}<section class="arcflight-event-manager__section"><h2>Validation</h2><ul class="arcflight-error">{{#each validationErrors}}<li>{{this}}</li>{{/each}}</ul></section>{{/if}}
    <footer class="arcflight-event-manager__footer"><button type="button" data-m12-launch {{#unless launchEnabled}}disabled{{/unless}}>Launch Event</button></footer>
  {{else}}
    <header class="arcflight-event-manager__header event-header" data-component="event-header"><div><p class="arcflight-kicker">Live GM Dashboard</p><h1>{{dashboard.shipName}} at {{event.title}}</h1><p>{{sessionId}}</p></div><span class="arcflight-status">{{#if abandoned}}ABANDONED{{else}}LIVE{{/if}}</span></header>
    {{#if dashboard}}
      <nav class="event-tabs" data-component="event-tabs" role="tablist" aria-label="Event Manager sections">
        <button type="button" class="event-tab" data-component="event-tab" data-m12-tab data-tab-id="overview" role="tab" aria-controls="tab-overview">Overview</button>
        <button type="button" class="event-tab" data-component="event-tab" data-m12-tab data-tab-id="crew-plan" role="tab" aria-controls="tab-crew-plan">Crew Plan</button>
        <button type="button" class="event-tab" data-component="event-tab" data-m12-tab data-tab-id="resolution-order" role="tab" aria-controls="tab-resolution-order">Resolution Order</button>
        <button type="button" class="event-tab" data-component="event-tab" data-m12-tab data-tab-id="plan-review" role="tab" aria-controls="tab-plan-review">Plan Review</button>
        <button type="button" class="event-tab" data-component="event-tab" data-m12-tab data-tab-id="resolution" role="tab" aria-controls="tab-resolution">Resolution</button>
      </nav>
      <section id="tab-overview" class="event-tab-content tab-overview" data-component="event-tab-content" data-m12-tab-content data-tab-id="overview" role="tabpanel">
        <section class="arcflight-event-manager__grid round-status event-status-panel" data-component="event-status-panel"><div><strong>Event</strong><span>{{event.title}}</span><span>{{dashboard.shipName}}</span></div><div><strong>Round</strong><span>{{dashboard.roundNumber}}</span><span>{{dashboard.lifecycleState}} - {{dashboard.phase}}</span></div><div><strong>Session</strong><span>{{dashboard.sessionState}}</span><span>Revision {{dashboard.revision}}</span></div></section>
        {{#if currentRound}}<section class="arcflight-event-manager__section round-authoring" data-component="round-authoring"><h2>{{currentRound.title}}</h2><p>{{currentRound.vignette}}</p><p><strong>Situation:</strong> {{currentRound.situation}}</p><p><strong>Objective:</strong> {{currentRound.objective}}</p><p><strong>Known stakes:</strong> {{currentRound.knownStakes}}</p></section>{{/if}}
        <section class="arcflight-event-manager__section resource-strip" data-component="resource-strip"><h2>Resources</h2><div class="arcflight-event-manager__pressure"><span><b>Momentum</b>{{dashboard.momentum}}</span><span><b>Pressure</b>{{#each dashboard.pressureSystems}}{{pressureSystemId}}: {{value}} / {{capacity}} {{/each}}</span><span><b>Breach</b>{{#if dashboard.breachCount}}{{dashboard.breachCount}}{{else}}0{{/if}}</span><span><b>Hazards</b>{{dashboard.activeHazardCount}}</span></div></section>
        <section class="arcflight-event-manager__section crew-summary" data-component="crew-summary"><h2>Fixed station / operator summary</h2><div class="overview-station-grid">{{#each dashboard.stationAssignments}}<p class="station-cell overview-station-cell" data-station-id="{{stationId}}"><span class="station-identity">{{#if stationIconPath}}<img class="station-icon" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}" width="{{stationIconSize}}" height="{{stationIconSize}}">{{/if}}<strong>{{stationDisplayName}}</strong></span><span class="station-detail-fields"><span><strong>OPERATOR:</strong> {{operator.name}}</span><span class="status-chip">{{statusLabel}}</span></span></p>{{/each}}</div></section>
      </section>
      <section id="tab-crew-plan" class="event-tab-content tab-crew-plan crew-plan-panel" data-component="crew-plan-panel" data-m12-tab-content data-tab-id="crew-plan" role="tabpanel">
        <h2>Crew Plan</h2>
        {{#if planning}}
          {{#each planningStations}}
            <article id="AF-UI-STATION-{{stationId}}" class="arcflight-station-card station-card station-cell{{#if ready}} station-card--ready{{else}} station-card--incomplete{{/if}}{{#unless expanded}} station-card--compact{{/unless}}" data-component="station-card" data-station-id="{{stationId}}" data-round="{{../planning.roundNumber}}" data-plan-state="{{planState}}" data-selection-state="{{selectionState}}"><header class="station-header" data-component="station-header">{{#if stationIconPath}}<img class="station-icon station-icon--major" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}" width="{{stationIconMajorSize}}" height="{{stationIconMajorSize}}">{{/if}}<div class="station-header-copy"><h3>{{stationDisplayName}}</h3><p class="station-operator" data-component="station-operator">{{operator.name}}</p></div><span class="status-chip station-status" data-component="station-status" data-status="{{planState}}">{{statusLabel}}</span></header>
              {{#if expanded}}
              <div class="crew-plan-controls">
              <div class="action-list" data-component="action-list"><span class="action-picker-label">Action</span>{{#if ../planLocked}}<span class="action-picker-readonly" data-component="action-picker-readonly" data-control-id="action" data-station-id="{{stationId}}">{{selectedActionName}}</span>{{else}}<div class="action-picker" data-component="action-picker"><button type="button" class="action-picker-trigger" data-m12-action-picker data-control-id="action" data-station-id="{{stationId}}" data-selected-action-id="{{selectedActionId}}" aria-haspopup="listbox" aria-controls="m12-action-options-{{stationId}}" aria-expanded="false"><span>{{#if selectedActionId}}{{selectedActionName}}{{else}}Choose Action...{{/if}}</span>{{#if selectedRiskBidAvailableResource}}<img class="resource-icon" src="{{selectedRiskBidAvailableResource.resourceIconPath}}" alt="{{selectedRiskBidAvailableResource.resourceIconTitle}}" title="{{selectedRiskBidAvailableResource.resourceIconTitle}}" aria-label="{{selectedRiskBidAvailableResource.resourceIconTitle}}">{{/if}}<span aria-hidden="true">▾</span></button><div id="m12-action-options-{{stationId}}" class="action-picker-menu" role="listbox" hidden>{{#each actions}}<button type="button" role="option" class="action-picker-option" data-m12-action-option="{{../stationId}}" data-station-id="{{../stationId}}" data-action-id="{{actionId}}" data-approach-id="{{approaches.[0].approachId}}" aria-selected="{{#if selected}}true{{else}}false{{/if}}"><span>{{displayName}}</span>{{#if riskBidAvailableResource}}<img class="resource-icon" src="{{riskBidAvailableResource.resourceIconPath}}" alt="{{riskBidAvailableResource.resourceIconTitle}}" title="{{riskBidAvailableResource.resourceIconTitle}}" aria-label="{{riskBidAvailableResource.resourceIconTitle}}">{{/if}}</button>{{/each}}</div></div>{{/if}}{{#if selectedActionDescription}}<small>{{selectedActionDescription}} Base DC: {{selectedActionBaseDc}}</small>{{else}}<small>Choose one of three round-specific actions.</small>{{/if}}</div>
              <label class="approach-control" data-component="approach-control" title="How are we doing it?">Approach<select data-m12-station-selection data-m12-approach="{{stationId}}" data-control-id="approach" data-station-id="{{stationId}}" {{#if ../planLocked}}disabled{{/if}}{{#unless selectedActionId}} disabled{{/unless}}><option value="" {{#unless selectedApproachId}}selected{{/unless}}>{{#if selectedActionId}}Choose Approach...{{else}}Select an Action first{{/if}}</option>{{#each approaches}}<option value="{{approachId}}" {{#if selected}}selected{{/if}}>{{#if name}}{{name}}{{else}}{{statisticSlugOrAbilityId}}{{/if}}</option>{{/each}}</select><small>Choose the check approach that fits this action.</small></label>
              {{#if selectedActionHasRiskBids}}<label class="risk-bid-control" data-component="risk-bid-control" title="How hard are we pushing?">Risk Bid<select data-m12-station-selection data-m12-risk-bid="{{stationId}}" data-control-id="risk-bid" data-station-id="{{stationId}}" {{#if ../planLocked}}disabled{{/if}}><option value="" {{#unless selectedRiskBidId}}selected{{/unless}}>Base DC / No Bid</option>{{#each riskBidOptions}}<option value="{{riskBidId}}" {{#if selected}}selected{{/if}}>{{displayName}} (DC {{adjustedDc}} / Final DC {{finalDc}})</option>{{/each}}</select><small>{{#if selected}}BASE DC {{../selectedActionBaseDc}} -> FINAL DC {{finalDc}}.{{else}}The selected action's authored bid tiers appear here.{{/if}}</small></label>{{/if}}
              </div>
              {{#if selectedActionHasRiskBids}}<div class="risk-bid-details" data-component="risk-bid-details">{{#if selectedRiskBidId}}{{#each riskBidOptions}}{{#if selected}}<div class="risk-bid-option station-cell"><div class="risk-bid-source-cell"><img class="resource-icon resource-icon--large" src="{{resource.resourceIconPath}}" alt="{{resource.resourceIconTitle}}" title="{{resource.resourceIconTitle}}" aria-label="{{resource.resourceIconTitle}}"><strong>{{displayName}}</strong><span>DC {{../selectedActionBaseDc}} -> {{finalDc}}</span></div><p><strong>PAYOFF</strong> {{presentation.intendedBenefit}}</p>{{#each payoffEffects}}<p class="risk-bid-target-cell">{{#each targetStations}}<img class="station-icon" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}" width="{{stationIconSize}}" height="{{stationIconSize}}"><strong>{{stationDisplayName}}</strong>{{/each}}<span>{{text}}</span></p>{{/each}}<p>ORDER: Source station must resolve before target.</p><p class="compact-rule"><strong>FAILURE / CRITICAL FAILURE</strong> - No payoff - No additional Risk Bid penalty</p></div>{{/if}}{{/each}}{{else}}<span class="risk-bid-available"><img class="resource-icon" src="{{selectedRiskBidAvailableResource.resourceIconPath}}" alt="{{selectedRiskBidAvailableResource.resourceIconTitle}}" title="{{selectedRiskBidAvailableResource.resourceIconTitle}}" aria-label="{{selectedRiskBidAvailableResource.resourceIconTitle}}">RISK BID AVAILABLE</span><span class="risk-bid-tier-summary">{{#each riskBidOptions}}{{displayName}}{{#unless @last}} / {{/unless}}{{/each}}</span>{{/if}}</div>{{/if}}
              {{!--
              {{#if selectedActionId}}<div class="risk-bid-details" data-component="risk-bid-details"><strong>Authored Risk Bid outcomes</strong>{{#if riskBidOptions.length}}{{#each riskBidOptions}}<div class="risk-bid-option station-cell"><div class="risk-bid-source-cell"><img class="station-icon" src="{{../stationIconPath}}" alt="{{../stationIconTitle}}" title="{{../stationIconTitle}}" aria-label="{{../stationIconTitle}}" width="{{../stationIconSize}}" height="{{../stationIconSize}}"><strong>{{../stationDisplayName}}</strong><span>{{../selectedActionName}}</span><span class="status-chip">{{displayName}}</span><img class="resource-icon resource-icon--large" src="{{resource.resourceIconPath}}" alt="{{resource.resourceIconTitle}}" title="{{resource.resourceIconTitle}}" aria-label="{{resource.resourceIconTitle}}"></div><p><b>{{displayName}}</b> — Base DC {{../selectedActionBaseDc}} -> Final DC {{finalDc}}</p><p><strong>PAYOFF</strong> {{presentation.intendedBenefit}}</p>{{#each payoffEffects}}<p class="risk-bid-target-cell">{{#each targetStations}}<img class="station-icon" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}" width="{{stationIconSize}}" height="{{stationIconSize}}"><strong>{{stationDisplayName}}</strong>{{/each}}<span>{{text}}</span></p>{{/each}}<p>ORDER: Source station must resolve before each target.</p><p class="compact-rule" data-failure="{{presentation.outcome.failure}}" data-critical-failure="{{presentation.outcome.criticalFailure}}"><strong>FAILURE / CRITICAL FAILURE</strong> — No payoff • No additional Risk Bid penalty</p></div>{{/each}}{{else}}<p>No Risk Bid is authored for this action.</p>{{/if}}</div>{{/if}}
              --}}
              <button type="button" data-m12-clear-selection data-station-id="{{stationId}}" data-component="clear-selection" data-control-id="clear" {{#if ../planLocked}}disabled{{/if}}>Clear</button>
              {{else}}
              <div class="station-compact-summary" data-component="station-compact-summary"><div class="station-compact-identity">{{#if stationIconPath}}<img class="station-icon" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}" width="{{stationIconSize}}" height="{{stationIconSize}}">{{/if}}<strong>{{stationDisplayName}}</strong><span>{{operator.name}}</span></div><div class="station-compact-selection"><span>{{compactSummary.actionName}}</span><span>•</span><span>{{compactSummary.approachName}}</span><span>•</span><span>{{compactSummary.riskBidName}}</span></div>{{#unless ../planLocked}}<button type="button" data-m12-edit-station data-station-id="{{stationId}}" data-component="edit-station">EDIT</button>{{/unless}}</div>
              {{/if}}
            </article>
          {{/each}}
        {{else}}<p class="arcflight-error">The persisted planning state could not be read.</p>{{/if}}
      </section>
      <section id="tab-resolution-order" class="event-tab-content tab-resolution-order resolution-order-panel" data-component="resolution-order-panel" data-m12-tab-content data-tab-id="resolution-order" role="tabpanel">
        <h2>Resolution Order</h2><p>{{#if planLocked}}Committed station order (read-only).{{else}}Drag a station to change the persisted resolution order.{{/if}}</p>
        <ol data-m12-order-list>{{#each orderEntries}}<li draggable="{{#unless ../planLocked}}true{{else}}false{{/unless}}" class="resolution-order-card station-cell" data-component="resolution-order-card" data-m12-order-station data-station-id="{{stationId}}"><span class="resolution-order-rail" aria-label="Reorder station" title="Drag to reorder"><button type="button" data-m12-order-move data-station-id="{{stationId}}" data-direction="up" aria-label="Move {{stationDisplayName}} up" {{#unless canMoveUp}}disabled{{/unless}}{{#if ../planLocked}} disabled{{/if}}>↑</button><span class="resolution-order-number">{{orderNumber}}</span><button type="button" data-m12-order-move data-station-id="{{stationId}}" data-direction="down" aria-label="Move {{stationDisplayName}} down" {{#unless canMoveDown}}disabled{{/unless}}{{#if ../planLocked}} disabled{{/if}}>↓</button></span><span class="resolution-order-identity"><strong>{{stationDisplayName}}</strong>{{#if stationIconPath}}<img class="station-icon" src="{{stationIconPath}}" alt="{{stationOrderIconTitle}}" title="{{stationOrderIconTitle}}" aria-label="{{stationOrderIconTitle}}" width="{{stationOrderIconSize}}" height="{{stationOrderIconSize}}">{{/if}}</span><span class="resolution-order-fields"><span><strong>OPERATOR:</strong> {{operatorName}}</span><span><strong>ACTION:</strong> {{actionName}}</span><span><strong>APPROACH:</strong> {{approachName}}</span></span><span class="resolution-order-risk">{{#if selectedRiskBidResource}}<img src="{{selectedRiskBidResource.resourceIconPath}}" alt="{{selectedRiskBidResource.resourceIconTitle}}" title="{{selectedRiskBidResource.resourceIconTitle}}" aria-label="{{selectedRiskBidResource.resourceIconTitle}}"><strong>{{riskBidName}}</strong><span>DC {{riskBidFinalDc}}</span>{{/if}}</span><span class="resolution-order-status">{{#unless selectedRiskBidResource}}<span class="status-chip">NO BID</span>{{/unless}}</span></li>{{/each}}</ol>
        {{#if riskBidDependencies}}<section class="risk-bid-dependencies" data-component="risk-bid-dependencies"><h3>Risk Bid Dependencies</h3>{{#each riskBidDependencies}}<div class="risk-bid-dependency station-cell"><p class="risk-bid-source-cell">{{#if sourceStationIconPath}}<img class="station-icon" src="{{sourceStationIconPath}}" alt="{{sourceStationLabel}} Station" title="{{sourceStationLabel}} Station" aria-label="{{sourceStationLabel}} Station" width="48" height="48">{{/if}}<strong>{{sourceStationLabel}} — {{sourceActionName}} {{riskBidName}}</strong></p>{{#each targetStations}}<p class="risk-bid-target-cell">↓ {{#if stationIconPath}}<img class="station-icon" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}" width="{{stationIconSize}}" height="{{stationIconSize}}">{{/if}}<strong>{{stationDisplayName}}</strong></p>{{/each}}<p class="status-chip">{{status}}</p></div>{{/each}}</section>{{/if}}
      </section>
      <section id="tab-plan-review" class="event-tab-content tab-plan-review plan-review-panel" data-component="plan-review-panel" data-m12-tab-content data-tab-id="plan-review" role="tabpanel">
        <h2>Plan Review</h2><p class="plan-readiness" data-component="plan-readiness"><strong>ROUND {{planning.roundNumber}}</strong> - {{#if planLocked}}PLAN LOCKED{{else}}{{#if planReady}}READY FOR PLAN LOCK{{else}}ACTION REQUIRED{{/if}}{{/if}}</p>
        {{#unless planLocked}}{{#unless planReady}}<p class="arcflight-error">Incomplete station(s): {{#each incompleteStations}}{{label}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/unless}}{{/unless}}
        <div class="plan-review-stations">{{#each planReviewRows}}<article class="plan-review-station station-cell" data-component="plan-review-station" data-station-id="{{stationId}}" data-plan-state="{{planState}}"><span class="station-identity"><strong>{{orderNumber}}. {{stationDisplayName}}</strong>{{#if stationIconPath}}<img class="station-icon station-icon--major" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}" width="{{stationIconMajorSize}}" height="{{stationIconMajorSize}}">{{/if}}</span><span class="station-detail-fields"><span><strong>OPERATOR:</strong> {{operatorName}}</span><span><strong>ACTION:</strong> {{actionName}}</span><span><strong>APPROACH:</strong> {{approachName}}</span></span><span class="plan-review-status resolution-order-status">{{#if selectedRiskBidResource}}<img class="resource-icon resource-icon--large" src="{{selectedRiskBidResource.resourceIconPath}}" alt="{{selectedRiskBidResource.resourceIconTitle}}" title="{{selectedRiskBidResource.resourceIconTitle}}" aria-label="{{selectedRiskBidResource.resourceIconTitle}}"><span class="status-chip">{{riskBidName}} · DC {{riskBidFinalDc}}</span><span><strong>PAYOFF:</strong>{{#each riskBidPayoffEffects}}{{#each targetStations}} {{stationDisplayName}}{{/each}} {{text}}{{/each}}</span><span>ORDER: Source station must resolve before target.</span>{{else}}<span class="status-chip">NO BID</span>{{/if}}</span></article>{{/each}}</div>
        <section class="plan-lock-panel" data-component="plan-lock-panel" data-plan-state="{{#if planLocked}}locked{{else}}{{#if planReady}}ready{{else}}incomplete{{/if}}{{/if}}"><h3>{{#if planLocked}}PLAN LOCKED{{else}}PLAN REVIEW{{/if}}</h3><p>{{#if planLocked}}Crew choices and station order are now committed.{{else}}{{#if planReady}}All occupied stations are ready for Plan Lock.{{else}}Complete each occupied station before Plan Lock.{{/if}}{{/if}}</p>{{#if planLocked}}<button type="button" class="plan-lock-button" data-component="plan-lock-button" data-m12-go-resolution>GO TO RESOLUTION</button>{{else}}<button type="button" class="plan-lock-button" data-component="plan-lock-button" data-m12-plan-lock {{#unless planReady}}disabled{{/unless}}>LOCK PLAN</button>{{/if}}</section>
      </section>
      <section id="tab-resolution" class="event-tab-content tab-resolution resolution-panel" data-component="resolution-panel" data-m12-tab-content data-tab-id="resolution" role="tabpanel">
        <h2>Resolution</h2>
        {{#if awaitingPlanLock}}
          <p class="arcflight-error">PLAN MUST BE LOCKED BEFORE RESOLUTION</p>
        {{else}}
          {{#if resolution}}
            <p data-resolution-state="{{resolution.phase}}">Round {{resolution.roundNumber}} — {{#if resolution.completed}}RESOLUTION COMPLETE — AWAITING ROUND CLOSEOUT{{else}}Current station: {{resolution.currentStationId}}{{/if}}</p>
            {{#if resolution.reactionWindow}}
              {{#if resolution.reactionWindowOpen}}
                <section class="focus-reaction-panel" data-component="focus-reaction-panel"><h3>{{#if resolution.reactionWindowPending.[0].focusResource}}<img class="resource-icon" src="{{resolution.reactionWindowPending.[0].focusResource.resourceIconPath}}" alt="{{resolution.reactionWindowPending.[0].focusResource.resourceIconTitle}}" title="{{resolution.reactionWindowPending.[0].focusResource.resourceIconTitle}}" aria-label="{{resolution.reactionWindowPending.[0].focusResource.resourceIconTitle}}">{{/if}} FOCUS REACTION</h3><p>Focus remaining: {{resolution.currentFocusRemaining}} / 1</p>{{#each resolution.reactionWindowPending}}<div class="focus-reaction-opportunity station-cell"><h4>{{focusAbility.name}}</h4><p>{{focusAbility.description}}</p><dl><dt>Cost</dt><dd>{{focusAbility.cost}} Focus</dd><dt>Source</dt><dd class="station-identity">{{#if focusAbility.sourceStation.stationIconPath}}<img class="station-icon" src="{{focusAbility.sourceStation.stationIconPath}}" alt="{{focusAbility.sourceStation.stationIconTitle}}" title="{{focusAbility.sourceStation.stationIconTitle}}" aria-label="{{focusAbility.sourceStation.stationIconTitle}}" width="{{focusAbility.sourceStation.stationIconSize}}" height="{{focusAbility.sourceStation.stationIconSize}}">{{/if}}{{focusAbility.sourceStationName}}</dd><dt>Target</dt><dd class="station-identity">{{#if focusAbility.targetStation.stationIconPath}}<img class="station-icon" src="{{focusAbility.targetStation.stationIconPath}}" alt="{{focusAbility.targetStation.stationIconTitle}}" title="{{focusAbility.targetStation.stationIconTitle}}" aria-label="{{focusAbility.targetStation.stationIconTitle}}" width="{{focusAbility.targetStation.stationIconSize}}" height="{{focusAbility.targetStation.stationIconSize}}">{{/if}}{{focusAbility.targetStationName}}</dd><dt>Check / DC</dt><dd>{{focusAbility.statisticName}} / {{focusAbility.dc}}</dd><dt>Critical Success</dt><dd>{{focusAbility.criticalSuccess}}</dd><dt>Success</dt><dd>{{focusAbility.success}}</dd><dt>Failure</dt><dd>{{focusAbility.failure}}</dd><dt>Critical Failure</dt><dd>{{focusAbility.criticalFailure}}</dd><dt>Visibility</dt><dd>{{focusAbility.visibility}}</dd></dl><p>{{focusAbility.narration}}</p><button type="button" data-m12-focus-use data-reaction-id="{{reactionId}}">USE FOCUS</button><button type="button" data-m12-focus-pass data-reaction-id="{{reactionId}}">PASS</button></div>{{/each}}</section>
              {{else if resolution.reactionWindow.result}}<p data-component="focus-reaction-result">Focus result: {{resolution.reactionWindow.result.modifier}} to the target station check.</p>{{/if}}
            {{/if}}
            <section data-component="resolution-current" data-station-id="{{resolution.currentStationId}}" data-control-id="resolution-current">
              {{#each resolution.stations}}<article class="resolution-station station-cell" data-station-id="{{stationId}}" data-resolution-status="{{status}}" data-current="{{current}}">{{#if stationIconPath}}<img class="station-icon station-icon--major" src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}" width="{{stationIconMajorSize}}" height="{{stationIconMajorSize}}">{{/if}}<strong>{{order}}. {{stationDisplayName}}</strong><span>Operator: {{operator.name}}</span><span>Action: {{actionId}}</span><span>Approach: {{approachId}}</span><span>Statistic: {{statisticSlugOrAbilityId}}</span><span>Risk Bid: {{riskBidDcAdjustment}}</span><span>DC: {{finalDc}}</span>{{#each riskBidEffects}}<div class="risk-bid-active-benefit" data-component="risk-bid-active-benefit"><strong>ACTIVE BENEFIT</strong><span class="station-identity">{{#if sourceStation.stationIconPath}}<img class="station-icon" src="{{sourceStation.stationIconPath}}" alt="{{sourceStation.stationIconTitle}}" title="{{sourceStation.stationIconTitle}}" aria-label="{{sourceStation.stationIconTitle}}" width="{{sourceStation.stationIconSize}}" height="{{sourceStation.stationIconSize}}">{{/if}}<strong>{{sourceStation.stationDisplayName}}</strong> — {{sourceActionId}}</span><span>{{effectText}}</span><span>{{consumptionLabel}}</span></div>{{/each}}<span>{{status}}</span>{{#if result}}<span>Result: {{result.total}} — {{result.degreeOfSuccessSlug}}</span>{{/if}}{{#if canRoll}}<button type="button" data-m12-roll-check>ROLL CHECK</button>{{/if}}</article>{{/each}}
            </section>
            {{#if resolutionReadyToStart}}<button type="button" data-m12-resolution-start>BEGIN RESOLUTION</button>{{/if}}
          {{else}}<p class="arcflight-error">Resolution state could not be read.</p>{{/if}}
        {{/if}}
      </section>
    {{else}}<p class="arcflight-error">The persisted session could not be read.</p>{{/if}}
    {{#if dashboard}}<p class="arcflight-event-manager__active-gm">Active GM {{dashboard.activeGmUserId}}</p>{{/if}}
    <footer class="arcflight-event-manager__footer event-footer" data-component="event-footer"><button type="button" data-m12-refresh>Refresh</button>{{#if abandonEnabled}}<button type="button" data-m12-abandon>ABANDON EVENT</button>{{/if}}<button type="button" data-m12-new-session>New Event</button></footer>
  {{/if}}
</div>
