<div class="arcflight-player-event player-event-shell" data-component="player-event-shell" data-active-tab="{{activeTab}}">
  <style data-component="player-event-shell-ui">
    .player-event-shell { display: grid; gap: .75rem; padding: .8rem; font-family: "Inter", "Segoe UI", sans-serif; }
    .player-event-shell h1, .player-event-shell h2, .player-event-shell h3, .player-event-shell .player-event-tab { font-family: "Cinzel", "Marcellus SC", serif; }
    .player-event-header { display: flex; justify-content: space-between; gap: .75rem; align-items: start; }
    .player-event-tabs { display: flex; gap: .35rem; flex-wrap: wrap; border-bottom: 1px solid var(--color-border-light-2, #777); padding-bottom: .4rem; }
    .player-event-tab { border: 1px solid var(--color-border-light-2, #777); padding: .4rem .65rem; background: rgba(0,0,0,.2); }
    .player-event-tab.is-active { border-color: var(--color-border-highlight, #b98b4f); box-shadow: inset 0 -2px var(--color-border-highlight, #b98b4f); }
    .player-event-panel { min-height: 18rem; max-height: 30rem; overflow: auto; }
    .player-event-card { border: 1px solid var(--color-border-light-2, #777); border-radius: .35rem; padding: .65rem; }
    .player-event-station { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; gap: .6rem; align-items: center; }
    .player-event-station img { width: 48px; height: 48px; object-fit: contain; }
    .player-event-station + .player-event-station { margin-top: .45rem; }
    .player-event-muted { opacity: .72; }
    .player-event-grid { display: grid; gap: .55rem; }
    .player-event-shell button { cursor: pointer; }
    @media (max-width: 520px) { .player-event-station { grid-template-columns: 40px minmax(0, 1fr); } .player-event-station > :last-child { grid-column: 2; } }
  </style>
  {{#if sessionUnavailable}}
    <header class="player-event-header" data-component="player-event-header"><div><p class="arcflight-kicker">Arcflight Event</p><h1>Player Event</h1></div><span class="arcflight-status">UNAVAILABLE</span></header>
    <section class="player-event-card" data-component="player-event-empty"><h2>No active Event Session</h2><p class="player-event-muted">{{errorMessage}}</p></section>
  {{else}}
    <header class="player-event-header" data-component="player-event-header"><div><p class="arcflight-kicker">{{model.roleLabel}} VIEW</p><h1>{{model.round.eventTitle}}</h1><p>Round {{model.round.roundNumber}} {{#if model.round.roundTitle}}— {{model.round.roundTitle}}{{/if}}</p></div><span class="arcflight-status">READ ONLY</span></header>
    <nav class="player-event-tabs" data-component="player-event-tabs" role="tablist" aria-label="Player Event sections">
      {{#each model.tabs}}<button type="button" class="player-event-tab{{#if active}} is-active{{/if}}" data-player-tab="{{id}}" role="tab" aria-selected="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}
    </nav>
    <section class="player-event-panel" data-player-panel="round" role="tabpanel"{{#unless model.showRound}} hidden{{/unless}}>
      <article class="player-event-card"><h2>Round {{model.round.roundNumber}}</h2>{{#if model.round.narrativeAvailable}}{{#if model.round.vignette}}<p>{{model.round.vignette}}</p>{{/if}}{{#if model.round.situation}}<p><strong>Situation:</strong> {{model.round.situation}}</p>{{/if}}{{#if model.round.objective}}<p><strong>Objective:</strong> {{model.round.objective}}</p>{{/if}}{{#if model.round.knownStakes}}<p><strong>Known Stakes:</strong> {{model.round.knownStakes}}</p>{{/if}}{{else}}<p class="player-event-muted">Round narrative is not yet revealed.</p>{{/if}}<p><strong>Status:</strong> {{model.round.sessionState}} / {{model.round.phase}}</p>{{#if model.round.hasMomentum}}<p><strong>Momentum:</strong> {{model.round.momentum}}</p>{{else}}<p class="player-event-muted">Momentum unavailable.</p>{{/if}}</article>
      {{#if model.round.pressureSystems.length}}<article class="player-event-card"><h3>Revealed Pressure</h3>{{#each model.round.pressureSystems}}<p>{{pressureSystemId}}: {{value}} / {{capacity}}</p>{{/each}}</article>{{/if}}
      {{#if model.round.activeHazards.length}}<article class="player-event-card"><h3>Revealed Hazards</h3>{{#each model.round.activeHazards}}<p>{{hazardId}}</p>{{/each}}</article>{{/if}}
    </section>
    <section class="player-event-panel" data-player-panel="my-station" role="tabpanel"{{#unless model.showMyStation}} hidden{{/unless}}>
      <article class="player-event-card"><h2>My Station</h2>{{#if model.hasOwnedStation}}{{#each model.ownedStations}}<div class="player-event-station" data-station-id="{{stationId}}">{{#if stationIconPath}}<img src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}">{{/if}}<div><h3>{{stationDisplayName}}</h3><p>Operator: {{operatorName}}</p><p class="player-event-muted">Action, Approach, Risk Bid, and Focus are read-only in this slice.</p></div><span class="arcflight-status">{{stateLabel}}</span></div>{{/each}}{{else}}<p>NO ASSIGNED STATION</p><p class="player-event-muted">You are observing this Arcflight Event.</p>{{/if}}</article>
    </section>
    <section class="player-event-panel" data-player-panel="crew-plan" role="tabpanel"{{#unless model.showCrewPlan}} hidden{{/unless}}>
      <article class="player-event-card"><h2>Crew Plan</h2><p class="player-event-muted">The crew plan is read-only. No planning controls are available.</p><div class="player-event-grid">{{#each model.crewPlan}}<div class="player-event-station" data-station-id="{{stationId}}">{{#if stationIconPath}}<img src="{{stationIconPath}}" alt="{{stationIconTitle}}" title="{{stationIconTitle}}" aria-label="{{stationIconTitle}}">{{/if}}<div><h3>{{stationDisplayName}}</h3><p>Operator: {{operatorName}}</p><p>Action: {{#if actionName}}{{actionName}}{{else}}Not revealed{{/if}}</p><p>Approach: {{#if approachName}}{{approachName}}{{else}}Not revealed{{/if}}</p><p>Risk Bid: {{#if riskBidName}}{{riskBidName}}{{else}}Not revealed{{/if}}</p></div>{{#if owned}}<span class="arcflight-status">YOUR STATION</span>{{else}}<span class="player-event-muted">READ ONLY</span>{{/if}}</div>{{/each}}</div></article>
    </section>
    <section class="player-event-panel" data-player-panel="resolution" role="tabpanel"{{#unless model.showResolution}} hidden{{/unless}}>
      <article class="player-event-card"><h2>Resolution</h2><h3>{{model.resolution.stateLabel}}</h3><p>{{model.resolution.detail}}</p>{{#if model.resolution.currentStation}}<div class="player-event-station" data-station-id="{{model.resolution.currentStation.stationId}}">{{#if model.resolution.currentStation.stationIconPath}}<img src="{{model.resolution.currentStation.stationIconPath}}" alt="{{model.resolution.currentStation.stationIconTitle}}" title="{{model.resolution.currentStation.stationIconTitle}}" aria-label="{{model.resolution.currentStation.stationIconTitle}}">{{/if}}<div><h3>CURRENT STATION: {{model.resolution.currentStation.stationDisplayName}}</h3><p>Operator: {{model.resolution.currentStation.operatorName}}</p></div>{{#if model.resolution.ownedCurrent}}<span class="arcflight-status">YOUR STATION IS ACTIVE</span>{{/if}}</div>{{/if}}</article>
    </section>
  {{/if}}
</div>
