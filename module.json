{
  "id": "arcflight",
  "title": "Arcflight",
  "description": "A Foundry VTT module scaffold for PF2E-compatible fantasy voidfaring campaigns.",
  "version": "0.0.0",
  "socket": true,
  "relationships": {
    "requires": [
      {
        "id": "socketlib",
        "type": "module",
        "compatibility": {
          "minimum": "1.1.4"
        }
      }
    ]
  },
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "styles": [
    "styles/arcflight.css"
  ],
  "esmodules": [
    "scripts/arcflight.js",
    "scripts/voyage/station-selection-api.js"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ]
}
